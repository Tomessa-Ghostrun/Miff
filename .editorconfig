root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Deux espaces en fin de ligne = saut de ligne forcé en Markdown
trim_trailing_whitespace = false

[*.{kt,kts,java,swift}]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
