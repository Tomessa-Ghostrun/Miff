{
  "name": "miff-functions",
  "version": "0.0.0",
  "private": true,
  "description": "Miff - Cloud Functions (2e generation, europe-west9). Socle SRV-1 : aucune logique metier.",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
