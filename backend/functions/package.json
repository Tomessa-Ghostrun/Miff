    "test:integration": "npm run build && node --test --test-concurrency=1 \"test/integration/*.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
