rules_version = '2';

// =============================================================================
// Miff — règles de sécurité Firestore (projet miff-3d283, europe-west9)
//
// STATUT : testées dans l'émulateur Firestore (`backend/rules-test-plan.md`,
// `npm test` dans backend/). Déployées sur miff-3d283 depuis le poste du PM : le 2026-10-30 (règles de `main` du
// 2026-10-27, AUTH-B et ONB-B comprises), puis le 2026-11-04 (commit 42031c0 : lieux R-LIEU-5, -2, -6 ; dernière position
// connue R-LIEU-POS ; renouvellement d'un consentement actif R-LIEU-3), puis le 2026-11-05 (SESS-1 temps 1) et le 2026-11-06
// (R-PHOTO-LOC), puis le 2026-11-10 (fichier de `main` de ce jour : 3 lieux gratuits p1/p2/p3, mode voyage, R-LIEU-1 au plus tard
// à cette date ; informations du PM, non vérifiables par l'agent, à confirmer dans la console : Firestore > Règles). NON DÉPLOYÉ (au 2026-11-20 ; à lire avant tout « oui » : `firebase deploy --only firestore:rules` publie le FICHIER ENTIER) :
// (a) SESS-1 temps 2 (deviceIdRequired() = true) ; (b) le journal de notifications CNC-B (point 18, `users/{uid}/notifications`, commit 85fc8066) ;
// (c) la date facultative de la dernière photo publiée (FEED-ORDRE-PHOTO, clé « photoAt » de validStatus, PR docs/feed-ordre-photo ; à déployer AVANT les
// applications qui l'écrivent). Le reste de ce fichier est parti avec le déploiement du 2026-11-18 au commit 13ec6177 (information du PM, non vérifiable par
// l'agent ; un déploiement publie le fichier entier de ce commit) : LIEU-REQ-A (point 13), jetons d'appareil SRV-2R (point 14), description DESC-R (clé
// « description » de validPhoto), LIEU-DANGER-REQ (point 15), alerte « Je suis en danger » (point 16) et quota d'alertes (point 17) sont tous des ancêtres de
// 13ec6177 (`git merge-base --is-ancestor`, vérifié le 2026-11-20) ; une mention « NON DÉPLOYÉ » restée plus bas pour ces points est donc périmée (à
// confirmer par la date de publication dans la console : Firestore > Règles). Les FONCTIONS ne font pas partie de ce fichier (état de `notifierAlerte` : sources
// divergentes, data-model.md la dit non déployée, docs/dev/deploiement-centre-notifications.md §0 note un déploiement au commit 424e858a le 2026-11-19 ; à
// confirmer dans la console Functions). Ce que le fichier actuel ajoute à 13ec6177 : `git diff 13ec6177 <commit> -- backend/firestore.rules`
// (= (b) + (c) + commentaires). Tout déploiement suit la procédure
// docs/dev/deploiement-regles.md et l'accord explicite du PM.
//
// Principes :
//  1. Tout est refusé par défaut. Aucune règle ouverte, même temporaire.
//  2. Un utilisateur ne lit que les données des Miffs dont il est membre.
//  3. Le client ne peut JAMAIS écrire son statut premium (`entitlements/*` est
//     en écriture interdite ; seul le serveur / la console l'écrit).
//  4. Consentement de localisation : le statut de présence d'un membre n'existe
//     que s'il a activé le partage, et n'est lisible que par les membres qui
//     partagent eux-mêmes ET ont publié leur propre statut (réciprocité), tant que
//     la Miff existe. Révoquer = supprimer ces données.
//  5. Limites freemium appliquées par des "slots" à identifiant fixe (voir
//     data-model.md §6) : 1 Miff et 3 lieux (p1, p2, p3) en gratuit, sans Cloud Function.
//  6. Téléphone (ONB-B) : donnée de contact obligatoire, sans vérification ni unicité. Il n'est visible de quelqu'un d'autre
//     que par la copie dans la fiche de membre (lisible des seuls membres de la Miff, sans condition de partage : décision
//     N1 du PM) ; la copie est contrainte à être celle du profil users/{uid} après le lot. Une fuite du code d'une Miff est
//     aussi une fuite des numéros de ses membres (risque assumé, data-model.md §11).
//  7. Lot d'entrée (MIFF-0) : adhésion ou création + partage activé + statut initial en UN lot atomique ; aucune règle
//     spécifique, c'est la combinaison des règles members / status / memberships (tests EN1 à EN6).
//  8. Les règles NE PEUVENT PAS faire de limitation de débit : le brute force
//     des codes et les abus de volume sont atténués par App Check (à activer
//     dans la console) + entropie du code (12 caractères, ~59 bits).
//  9. Dernière position connue (R-LIEU-POS, décision du PM du 2026-11-01) — DÉPLOYÉ le 2026-11-04 : un document
//     miffs/{id}/positions/{uid} par membre et par Miff (lat, lng, measuredAt, rien d'autre, aucun historique), SÉPARÉ du
//     statut (le statut ne contient toujours aucune coordonnée). Écriture : par l'intéressé seul, Miff existante, partage actif ET
//     texte de consentement de version 3 ou plus (jamais de position sans ce nouveau consentement). Lecture d'un autre membre :
//     mêmes conditions que les statuts (Miff existante, partage actif, statut publié) PLUS avoir publié sa propre position
//     (réciprocité FORMELLE : elle prouve qu'un document existe, pas que la position ou son heure sont vraies — non vérifiables) et
//     que la cible partage encore ; get seulement, jamais de liste. Le créateur n'a AUCUN droit de lecture de plus ; il peut seulement
//     SUPPRIMER la position d'un membre, à tout moment (comme le statut et la photo : suppression seulement, aucune lecture). Effacée
//     dans le MÊME lot que le statut et la photo (arrêt du partage, départ, retrait) : les règles le EXIGENT.
//     L'écriture de position lit DEUX documents (Miff, fiche du membre) et ne doit jamais partager un lot avec des lieux.
//     La version du texte de consentement est DÉCLARÉE par le client : aucune règle ne prouve quel texte a été affiché.
// 10. Un compte, un seul appareil (SESS-1, mécanisme validé par le PM le 2026-11-01) — DÉPLOYÉ le 2026-11-05 : un document de session
//     users/{uid}/session/active { deviceId, startedAt } écrit à chaque connexion (la dernière connexion gagne), supprimé à la
//     déconnexion volontaire, lisible et écrivable par son propriétaire seul. Le statut et la dernière position portent la clé
//     facultative `deviceId` ; si elle est présente elle DOIT être celle de la session (une lecture de règles de plus, seulement
//     quand la clé est présente), donc un appareil remplacé ne peut plus écrire de statut ni de position. DEUX TEMPS de
//     déploiement (deviceIdRequired) : temps 1 = clé facultative (les applications actuelles, qui ne l'écrivent pas, continuent à
//     passer) ; temps 2 = clé obligatoire. MESURE DE COHÉRENCE, PAS DE SÉCURITÉ : un client modifié peut mentir, et une écriture
//     sans charge utile (suppression) ou sur un autre document (lieu, fiche, photo seule) n'est pas contrôlée (data-model.md).
// 11. Localisation de la photo d'update (R-PHOTO-LOC, décision du PM du 2026-11-05) — DEUX VERSIONS :
//     (a) version FACULTATIVE (fichier de `main` au commit 35c8ba1, PR #82) : DÉPLOYÉE le 2026-11-06 (commande exécutée par le PM, « Deploy complete! » confirmé) ;
//     (b) version OBLIGATOIRE (ce fichier) — DÉPLOYÉE le 2026-11-06 (décision du PM du 2026-11-06 : « une photo d'update doit être attachée à
//         une position, forcément »). Retour arrière = redéployer le fichier de `main` d'avant cette PR (la localisation redevient facultative ;
//         les photos déjà posées restent localisées).
//     Le document photo porte TOUJOURS `lat`, `lng` (deux coordonnées valides, jamais nulles) et `measuredAt` (heure de la mesure, jamais nulle) :
//     la position figée au moment de la photo. Une photo sans localisation est REFUSÉE, de même qu'une mise à jour qui supprimerait une des trois clés.
//     Écriture : par l'intéressé seul, comme la photo ; TOUTE photo exige le même texte de consentement que la dernière position (version 3
//     ou plus, après le lot : on peut activer le partage et poser la photo dans le même lot). Lecture (inchangée) : une photo localisée n'est
//     lisible que par son auteur ou par un membre qui a PUBLIÉ sa propre position (réciprocité formelle, comme positions/{uid}) ; pas de
//     contrôle « l'auteur partage encore » (PM, 2026-11-06 : la purge à l'arrêt du partage et l'expiration de 24 h bornent un reliquat) ; un
//     éventuel ancien document SANS localisation reste lisible comme avant (aucune application publiée n'en écrit : data-model.md). La
//     localisation est EFFACÉE AVEC la photo (même document, mêmes lots de suppression, mêmes 24 h) : aucun lot ne change. Le document photo ne porte
//     toujours PAS de deviceId (SESS-1 : une photo seule n'est pas contrôlée, elle voyage avec un statut dans la mise à jour manuelle).
//     Risques juridiques CONNUS et assumés par le PM (décision du 2026-10-23, aucune relecture juridique, aucune conformité affirmée) : RGPD
//     (localisation = donnée sensible), mineurs, copie datée d'une position précise lisible jusqu'à 24 h (data-model.md §11).
//
// 12. Mode voyage (VOY-B, ticket docs/tickets/mode-voyage.md, décisions du PM du 2026-11-10) — DÉPLOYÉ par le PM le 2026-11-10 : le statut accepte
//     `presence = 'travel'` avec `travelUntil` (fin) et `travelUntilDay` (jour affiché), voir validTravel. DISPONIBLE POUR TOUS LES COMPTES
//     (aucune barrière Miff+, aucune lecture de règles de plus). En voyage le statut ne porte ni lieu, ni batterie, ni échéance. LA POSITION RESTE
//     PARTAGÉE PENDANT LE VOYAGE (décision du PM du 2026-11-10) : positions/{uid} et photos/{uid} ne sont pas concernées par le voyage, aucune
//     règle ne les interdit ni ne les supprime à l'activation (comportement voulu, pas une limite). Contrat du CLIENT : ne pas écrire de statut de
//     présence ordinaire pendant le voyage (les règles l'acceptent, c'est le geste « désactiver », mais il mettrait fin au voyage côté proches ;
//     data-model.md). Commentaire seul : aucune règle modifiée.
//
// 13. Demande d'ajout d'un lieu par un membre (LIEU-REQ-A, ticket docs/tickets/demande-ajout-lieu.md, décisions du PM D1 à D9 du 2026-11-11) — DÉPLOYÉ avec le fichier du 2026-11-18 (13ec6177 ; déduit, voir l'en-tête)
//     (le fichier déployé est celui du 2026-11-10 : en production, `placeRequests` et `meta` sont refusés par défaut). Un membre NON créateur dépose
//     une demande miffs/{id}/placeRequests/{uid}_{1..3} (trois emplacements fixes par membre ; 9 clés exactes dont la catégorie ; `requestedBy` = soi ; `createdAt` =
//     heure serveur ; `type` = `trusted` ou `risk` : la zone de danger se DEMANDE sans Miff+, voir point 15) ; un compteur miffs/{id}/meta/placeRequests tient le plafond de 10 par Miff, écrit DANS LE MÊME LOT
//     (la règle de la demande exige `lastReqId` = cette demande et `updatedAt` = request.time ; la règle du compteur contrôle +1 / -1 et la borne).
//     Lecture : le créateur lit toutes les demandes, le demandeur les siennes (requête filtrée), les autres membres rien. Aucune modification.
//     Suppression : le créateur (sans contrainte) ou le demandeur (compteur -1 dans le lot). Accepter = lot de 3 : lieu (règles de `places` INCHANGÉES)
//     + suppression de la demande + compteur. Expiration à 30 jours : AUCUNE règle (masquage et nettoyage côté clients). Le lot « Quitter » et le lot de
//     retrait ne sont PAS modifiés : les demandes d'un membre qui part sont retirées par son client avant « Quitter », sinon elles restent orphelines.
//     Limites : pas de limitation de débit (App Check) ; compteur auto-réparé par le créateur (valeur absolue) ; aucune règle ne juge le contenu
//     (adresse d'un tiers) ; risque juridique assumé par le PM (data-model.md §11, point 31).
//
// 14. Jetons d'appareil pour les notifications push (SRV-2R, ticket docs/tickets/notification-update-membres.md §8, étude docs/dev/etude-serveur-notifications-premium.md §8) — DÉPLOYÉ avec le fichier du 2026-11-18 (13ec6177 ; déduit, voir l'en-tête)
//     (le fichier déployé porte encore l'ANCIEN gabarit de `devices` { token ≤ 512, platform, updatedAt } : aucun client ne l'écrit). Document
//     users/{uid}/devices/{deviceId} : `deviceId` = l'identifiant de la SESSION active (users/{uid}/session/active.deviceId, un compte = un appareil) ;
//     7 clés exactes (token ≤ 4096, platform, appVersion, tz, notify { updates }, updatedAt = heure serveur, createdAt =
//     heure serveur à la création puis figé) ; propriétaire SEUL pour lire (get et list), écrire et supprimer. L'écriture exige que l'identifiant soit celui de
//     la session (getAfter : 1 lecture de règles, le lot de connexion peut contenir la session ET le jeton) : un appareil remplacé ne peut plus s'enregistrer.
//     La suppression ne dépend PAS de la session (déconnexion, suppression de compte : la session est supprimée d'abord). Le plafond « 5 appareils » n'est pas
//     compté (les règles ne savent pas compter) : un seul identifiant est écrivable à la fois (celui de la session) ; le nouvel appareil supprime les autres au
//     lot de connexion. `notifState/{miffId}` (état du serveur : idempotence, plafond horaire) n'a AUCUNE règle : refusé par défaut, lu et écrit avec les droits
//     Admin seulement. Remplace l'ancien bloc `devices` (seule règle existante modifiée : voir data-model.md §2.10).
//
// 15. Zone de danger DEMANDÉE sans Miff+ (LIEU-DANGER-REQ, ticket docs/tickets/lieu-danger-demande-gratuite.md, décision du PM du 2026-11-17) — DÉPLOYÉ avec le fichier du 2026-11-18 (13ec6177 ; déduit, voir l'en-tête).
//     Une demande `placeRequests` de type `risk` n'exige PLUS que le demandeur soit Miff+ (une seule condition retirée de la création de la demande :
//     `isPremiumOneRead(demandeur)`). Les deux autres contraintes restent APPLIQUÉES PAR LES RÈGLES, inchangées : (a) ACCEPTER = créer le lieu `risk`
//     dans `places` : Miff+ du CRÉATEUR (validPlaceCreate, isPremiumOneRead du créateur) ; la demande n'est supprimée que dans le même lot : lot refusé en
//     entier si le créateur n'est pas Miff+ ; (b) DÉCLARER directement un lieu `risk` ou passer un lieu à `risk` : même fonction (validPlaceCreate /
//     validPlaceUpdate), Miff+ du créateur. Aucune règle de `places` n'est modifiée. Une demande `risk` coûte 5 lectures de règles au lieu de 6.
//
// 16. Alerte « Je suis en danger » (AD-B1, ticket docs/tickets/alerte-danger.md §6, §10, décisions du PM du 2026-11-18) — DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM). Document
//     miffs/{miffId}/alerts/{uid} : la clé de l'alerte EST le chemin (Miff d'origine + auteur), aucun champ miffId ni uid ; AU PLUS une alerte par
//     auteur et par Miff ; 7 clés exactes (status, startedAt, expiresAt, endedAt, seq, deviceId, purgeAt) ; AUCUNE position, aucun texte libre.
//     Création : l'auteur seul, Miff existante, partage actif DANS CETTE MIFF après le lot, deviceId = session, status = active, startedAt = heure
//     serveur, endedAt nul, seq = 1, durée de 7 jours AU PLUS imposée côté serveur (voir alertExpiryWindow : le client ne peut pas écrire « heure du
//     serveur + 7 j », la règle impose donc une FENÊTRE (6 j, 7 j] et jamais plus de 7 jours), purgeAt = expiresAt + 2 j (règle TTL à poser par le PM).
//     Ré-armement (même document, après fin ou expiration) : seq + 1, au moins 60 s depuis l'ancien startedAt, mêmes conditions que la création ;
//     refusé tant que l'alerte est active et non expirée. Fin manuelle : l'auteur seul, active -> ended, endedAt = heure serveur, purgeAt <= 3 j, et deviceId =
//     session (un autre appareil qui adopte l'alerte réécrit son identifiant dans le même geste). Lecture (get et list) : tout membre de la Miff existante,
//     SANS réciprocité de partage (décision D16 : tout membre est prévenu, le document ne contient aucune position). Suppression : l'auteur ou le créateur, à
//     tout moment, et les lots d'arrêt du partage, de départ et de retrait EXIGENT la suppression de l'alerte de cette Miff (comme le statut, la photo et la
//     position). Aucune règle de position, de statut ni de photo n'est modifiée par l'alerte.
//     Limites assumées : (a) les règles ne comptent pas entre Miffs : « une alerte à la fois » est tenue par l'application ; (b) le ré-armement de 60 s est
//     contournable par suppression puis recréation (la vraie barrière est le QUOTA de 3 débuts par 24 h, qui compte aussi la recréation : point 17) ;
//     (c) le créateur ne peut supprimer l'alerte d'un membre QUE dans le lot qui retire ce membre (existsAfter de sa fiche) ; il ne peut pas l'effacer seul. Ce lot coûte 20 lectures de règles sur 20
//     SANS CACHE quand il supprime aussi l'alerte (18 sans alerte) : exactement la limite, sans marge ; le créateur ne peut pas la supprimer dans un lot séparé avant.
//
// 17. Quota d'alertes (décision du PM du 2026-11-18) — DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM) : au plus 3 DÉBUTS d'alerte par utilisateur sur une fenêtre glissante de 24 h, toutes Miffs confondues, appliqués PAR LES
//     RÈGLES (refus permission-denied du 4e : l'utilisateur sait qu'il est refusé, aucun refus silencieux). Document users/{uid}/quota/alerts (cases s0 s1 s2 + lastMiffId + updatedAt + expireAt) écrit
//     dans le MÊME lot que le début ou le ré-armement de l'alerte (alertQuotaOk) ; voir le bloc de commentaires « Quota d'alertes » plus bas. Terminer ne rend pas le crédit. Le plafond de
//     10 débuts par 24 h de la fonction notifierAlerte disparaît (la fonction ne notifie que des débuts déjà acceptés par les règles) ; le 1 par minute de la fonction reste.
//
// 18. Journal de notifications (CNC-B, ticket docs/tickets/centre-notifications-complet.md §8, décisions du PM du 2026-11-19) — NON DÉPLOYÉ. Sous-collection users/{uid}/notifications/{entryId} :
//     une ligne (6 clés : v, kind, miffId, actorUid, createdAt, expireAt ; AUCUN prénom, photo, lieu, position) par destinataire et par push envoyé, écrite par les fonctions notifierUpdate et
//     notifierAlerte dans leur transaction de réservation (Admin SDK : les règles n'ont rien à autoriser côté écriture). Règles : lecture (get, liste de 100 au plus avec limite OBLIGATOIRE) et
//     suppression par le propriétaire seul ; create et update refusés à tout client. 0 lecture de règles. Durée de vie 30 jours par règle TTL (groupe de collections `notifications`, champ
//     `expireAt`, à poser par le PM AVANT le déploiement des règles). Aucune règle existante n'est modifiée. Risque RGPD assumé (data-model.md §11) : nouvelle donnée serveur (identifiants + date).
//
// 19. Premium réel Miff+ (SRV-7, ticket docs/tickets/premium-achat-reel.md §9, data-model.md §2.3 et §2.22 à §2.25) — COMMENTAIRE SEUL, AUCUNE RÈGLE MODIFIÉE (aucun déploiement des règles nécessaire pour SRV-7).
//     `entitlements/{uid}` reste en lecture propriétaire seul / écriture refusée à tout client : il est écrit par les fonctions de facturation (Admin SDK, compte `billing-sync`) ou, pour un
//     accord « à la main », par le PM dans la console. Le document porte désormais jusqu'à 9 champs (state, plan, trial, willRenew, test en plus des 4 d'origine ; purgeAt après une suppression
//     de compte) : les règles et `isPremiumOneRead` ne lisent toujours que `active` et `expiresAt`. Collections RÉSERVÉES AU SERVEUR, sans aucune règle (refus par défaut, comme `notifState`) :
//     `billingAccounts/{uid}` (identifiant d'achat aléatoire), `billingPurchases/{cle}` (achats liés, clé = SHA-256), `billingEvents/{id}` (messages déjà traités, TTL 7 jours), `billingConfig/apple`
//     (configuration NON secrète de l'API Apple). Tests : tests/rules/38-facturation.test.js (plan §32). Risques RGPD / stores assumés : data-model.md §11.
//
// Coût : chaque get()/exists()/getAfter()/existsAfter() dans une règle est
// facturé comme une lecture (même si la requête est refusée) et est limité à
// 10 appels par requête simple, 20 par batch/transaction. Les écritures
// multi-documents (créer une Miff, rejoindre, quitter) doivent donc rester
// des batches courts (voir data-model.md §8).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers génériques
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isNullOrStr(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Champ binaire optionnel (absent ou null accepté) borné en taille.
    function optBytes(d, k, maxSize) {
      return !(k in d) || d[k] == null || (d[k] is bytes && d[k].size() <= maxSize);
    }

    // Clés modifiées par l'écriture en cours (update uniquement).
    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Code secret : exactement 12 caractères, alphabet de 31 symboles sans
    // ambiguïté visuelle (pas de I, L, O, 0, 1) => 31^12 ~ 7,9e17 (~59 bits).
    function isJoinCode(code) {
      return code is string && code.matches('^[A-HJ-KM-NP-Z2-9]{12}$');
    }

    // Identifiant de Miff : ID auto Firestore (20 caractères alphanumériques).
    // Empêche les collisions avec les identifiants fixes 'free' et 'p1'.
    function isMiffId(id) {
      return id is string && id.matches('^[A-Za-z0-9]{20}$');
    }

    // -------------------------------------------------------------------------
    // Appartenance / rôle / premium
    // -------------------------------------------------------------------------
    // Membre = existence du document members/{uid} de la Miff (état AVANT écriture).
    function isMember(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid));
    }

    // Créateur de la Miff (ownerUid immuable).
    function isOwner(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId))
        && get(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == request.auth.uid;
    }

    // Créateur de la Miff en UNE seule lecture de règles (isOwner en coûte 2 : exists + get). Même résultat quand la Miff
    // n'existe pas : get() échoue et la requête est refusée. À n'utiliser que dans une conjonction ou une disjonction
    // POSITIVE, jamais derrière « ! ». Sert aux purges du créateur (statut, photo, position) pour que le lot de retrait d'un
    // membre reste à 18 lectures de règles sur 20 une fois la position ajoutée (data-model.md §12).
    function isOwnerOneRead(miffId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == request.auth.uid;
    }

    // Membre qui a lui-même activé le partage de position dans cette Miff.
    // (get() échoue si non-membre => refus.) Sert à la réciprocité.
    function mySharingOn(miffId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid)).data.sharing.enabled == true;
    }

    // La Miff existe encore. Les sous-collections d'une Miff supprimée ne sont pas effacées par
    // Firestore : sans ce contrôle, la fiche d'un membre survivant (isMember) garderait l'accès en
    // lecture aux lieux, membres, statuts et photos d'une Miff qui n'existe plus.
    function miffAlive(miffId) {
      return exists(/databases/$(database)/documents/miffs/$(miffId));
    }

    // Réciprocité formelle (ATK3) : avoir PUBLIÉ son propre statut dans cette Miff (le document
    // status/{moi} existe), pas seulement avoir activé le partage.
    function statusPublished(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/status/$(request.auth.uid));
    }

    // Réciprocité formelle de la position (R-LIEU-POS, même logique que ATK3) : avoir PUBLIÉ sa propre dernière position dans
    // cette Miff (le document positions/{moi} existe). Un membre qui n'en partage aucune ne lit pas celle des autres. Comme
    // ce document ne peut exister qu'avec un partage actif et une version de consentement déclarée de 3 ou plus (validPosition), et
    // disparaît à l'arrêt du partage, elle implique que le lecteur a déclaré le même texte. FORMELLE : un client modifié peut publier une
    // fausse position pour lire celles des autres ; rien ne permet de vérifier une position ou son heure de mesure.
    function positionPublished(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/positions/$(request.auth.uid));
    }

    // La personne dont on lit la position partage encore (fiche présente, partage actif). Ceinture et bretelles (sonde Y4 de la revue de
    // sécurité) : les lots de purge empêchent déjà qu'une position survive à l'arrêt du partage, au départ ou au retrait ; si un reliquat
    // existait malgré tout (autre chemin, bug, import), il ne serait pas lisible. Une lecture de plus, sur un `get` (5 sur 10).
    function targetSharingOn(miffId, uid) {
      return get(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing.enabled == true;
    }

    // Retrait d'un membre (ATK4) : le code secret de la Miff CHANGE dans le même lot (l'ancien code
    // est supprimé par validMiffUpdate), sinon l'ex-membre reviendrait avec le code qu'il connaît.
    // getAfter échoue si la Miff est supprimée dans le lot => un retrait n'est pas possible dans le
    // lot qui supprime la Miff (les membres sont retirés avant, un par lot).
    function codeRenewed(miffId) {
      return getAfter(/databases/$(database)/documents/miffs/$(miffId)).data.joinCode
        != get(/databases/$(database)/documents/miffs/$(miffId)).data.joinCode;
    }

    // -------------------------------------------------------------------------
    // Validation de forme : profil, consentement
    // -------------------------------------------------------------------------
    // Nom : 1..50 caractères (la règle UX "3 caractères minimum" des maquettes
    // exclurait des prénoms réels comme "Li" ou "Jo" : voir question ouverte).
    function validProfile(d) {
      return isStr(d.firstName, 1, 50)
        && isStr(d.lastName, 1, 50)
        && optBytes(d, 'avatar', 20000);
    }

    // -------------------------------------------------------------------------
    // Téléphone (ONB-B, décision Q1 du PM) : numéro au format E.164, obligatoire à la création du profil et de la fiche de
    // membre. « + », un premier chiffre de 1 à 9, puis 6 à 14 chiffres : 7 à 15 chiffres, 8 à 16 caractères au total, aucun
    // espace ni séparateur (la mise en forme est faite par le client). Forme seulement : aucune vérification que la personne
    // possède le numéro (pas de SMS sur Spark) et aucune unicité. [+] plutôt que « \+ » : pas de caractère d'échappement.
    // -------------------------------------------------------------------------
    function isPhone(v) {
      return v is string && v.matches('^[+][1-9][0-9]{6,14}$');
    }

    // La clé phone du document résultant existe et est valide (un numéro ne se vide ni ne se supprime).
    function hasValidPhone(d) {
      return 'phone' in d && isPhone(d.phone);
    }

    // Copie du numéro dans la fiche de membre : elle doit être celle du profil users/{uid} APRÈS le lot (getAfter), donc
    // soit le profil existant, soit le profil créé ou modifié dans le même lot. C'est le même document que termsAcceptedAfter.
    // get('phone', null) évite une erreur d'évaluation quand le profil (compte antérieur à ONB-B) n'a pas de numéro : la
    // comparaison est alors simplement fausse.
    function phoneMatchesProfile(uid, phone) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.get('phone', null) == phone;
    }

    // -------------------------------------------------------------------------
    // Consentement facultatif (b) « statistiques d'usage et rapports de plantage anonymes » (AUTH-B).
    // Bloc `analyticsConsent` de users/{uid} : mêmes quatre clés que members.sharing, TOUJOURS toutes
    // présentes (null si non applicable). Absence du bloc = pas de consentement. Jamais de position.
    // -------------------------------------------------------------------------
    // Version du texte de consentement : AAAA-MM-vNN. Le zéro de tête et le format fixe rendent l'ordre
    // lexicographique identique à l'ordre chronologique (utile pour refuser une rétrogradation de version).
    function isConsentVersion(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-v[0-9]{2}$');
    }

    // Les 4 clés exactes (ni plus, ni moins).
    function hasConsentKeys(c) {
      return c is map
        && c.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && c.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt']);
    }

    // À la création du profil : soit « non consenti » (case décochée : aucune date, aucune version),
    // soit « consenti » avec l'heure du serveur (request.time) et la version du texte affiché.
    function validAnalyticsConsentCreate(c) {
      return hasConsentKeys(c)
        && c.revokedAt == null
        && (
          (c.enabled == false && c.consentedAt == null && c.consentVersion == null)
          || (c.enabled == true && c.consentedAt == request.time && isConsentVersion(c.consentVersion))
        );
    }

    // Changement ultérieur (Réglages) ; prev = ancien bloc (null si le profil n'en a pas), next = nouveau.
    //  - activer / réactiver (depuis « absent » ou « non consenti ») : heure serveur, version du texte, revokedAt vidé,
    //    et version jamais plus ancienne que la dernière enregistrée (pas de rétrogradation) ;
    //  - retirer (depuis « consenti » uniquement) : revokedAt = heure serveur, la trace du consentement
    //    (date et version) est conservée. Réécrire un consentement actif sans le retirer d'abord est refusé.
    function validAnalyticsConsentChange(prev, next) {
      return hasConsentKeys(next)
        && (
          ((prev == null || prev.enabled == false)
            && next.enabled == true
            && next.consentedAt == request.time
            && isConsentVersion(next.consentVersion)
            && next.revokedAt == null
            && (prev == null || prev.consentVersion == null || next.consentVersion >= prev.consentVersion))
          ||
          (prev != null && prev.enabled == true
            && next.enabled == false
            && next.revokedAt == request.time
            && next.consentedAt == prev.consentedAt
            && next.consentVersion == prev.consentVersion)
        );
    }

    // CONTRAT DE NOMMAGE des versions du texte de consentement (R-LIEU-POS / R-LIEU-3) : `AAAA-MM-vNN`, LARGEUR FIXE (deux chiffres
    // pour NN, zéro de tête : 2026-11-v03, 2026-12-v04...), comme isConsentVersion d'analyticsConsent. La largeur fixe rend l'ordre
    // alphabétique identique à l'ordre chronologique, ce que le renouvellement (version strictement supérieure) suppose. Les textes
    // déjà écrits sans largeur fixe (2026-10-v1, 2026-10-v2) restent valides comme ANCIENNES versions et ne couvrent pas la position.
    // Le texte qui couvre la DERNIÈRE POSITION CONNUE est la version 3 : NN doit valoir 03 ou plus (03 à 99), quel que soit le mois
    // (décision du PM du 2026-11-01 : nouveau consentement avant toute écriture de position). Le numéro 3 vient de la demande du PM,
    // pas d'un texte déjà publié : le changer est une ligne, un test et une mutation.
    // LIMITE : la version est DÉCLARÉE par le client. Aucune règle ne prouve quel texte a été réellement affiché ; la protection est
    // le comportement des applications (revue de code et QA), pas les règles.
    function isPositionConsentVersion(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-v(0[3-9]|[1-9][0-9])$');
    }

    // Texte de consentement qui couvre la LOCALISATION DE LA PHOTO d'update (R-PHOTO-LOC) : fonction DÉDIÉE, distincte de celle de la
    // dernière position, pour que le seuil de la photo puisse évoluer seul (décision UPDATE-1b : texte v3 amendé avant publication ; sinon
    // seuil relevé à 04 avec la v4 : une ligne, un test, une mutation). Aujourd'hui : même forme AAAA-MM-vNN de largeur fixe et même seuil
    // (NN de 03 à 99). Aucune lecture de règles. LIMITE : version DÉCLARÉE par le client, aucune règle ne prouve quel texte a été affiché.
    function isPhotoLocationConsentVersion(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-v(0[3-9]|[1-9][0-9])$');
    }

    // Consentement à la création du document membre.
    // Les 4 clés sont TOUJOURS présentes (null si non applicable).
    function validSharingCreate(s) {
      return s is map
        && s.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && s.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && s.revokedAt == null
        && (
          (s.enabled == false && s.consentedAt == null && s.consentVersion == null)
          || (s.enabled == true && s.consentedAt == request.time && isStr(s.consentVersion, 1, 20))
        );
    }

    // Changement de consentement (o = ancien, n = nouveau).
    //  - activer   : consentedAt = maintenant, version du texte acceptée, revokedAt vidé
    //  - révoquer  : revokedAt = maintenant ET statut + photo + dernière position supprimés dans le même batch
    //  - renouveler (partage actif -> actif) : nouveau texte, version strictement supérieure, rien à supprimer (R-LIEU-3)
    function validSharingChange(miffId, uid, o, n) {
      return n is map
        && n.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && n.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && (
          (o.enabled == false && n.enabled == true
            && n.consentedAt == request.time
            && isStr(n.consentVersion, 1, 20)
            && n.revokedAt == null)
          ||
          (o.enabled == true && n.enabled == false
            && n.revokedAt == request.time
            && n.consentedAt == o.consentedAt
            && n.consentVersion == o.consentVersion
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/status/$(uid))
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/photos/$(uid))
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/positions/$(uid))
            // Alerte (AD-B1) : arrêter le partage retire aussi l'alerte de cette Miff (une alerte ne vit que tant que la personne partage ici).
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/alerts/$(uid)))
          ||
          // Renouveler un consentement ACTIF (R-LIEU-3, accepté puis confirmé par le PM le 2026-11-01) : le partage reste actif,
          // un nouveau texte est accepté. Heure serveur, revokedAt vide, version de LARGEUR FIXE (isConsentVersion : AAAA-MM-vNN,
          // sinon l'ordre alphabétique ne serait pas l'ordre chronologique : v10 -> v2, texte libre...) et STRICTEMENT supérieure
          // à l'ancienne. On ne peut JAMAIS sortir de la couverture « position » en renouvelant : si l'ancienne version couvre la
          // position, la nouvelle aussi (sinon la position resterait publiée sous un consentement qui ne la couvre plus). Aucune
          // suppression de statut, de photo ni de position, et AUCUNE lecture de règles. Limite : la version est déclarée par le
          // client (voir isPositionConsentVersion).
          (o.enabled == true && n.enabled == true
            && n.consentedAt == request.time
            && isConsentVersion(n.consentVersion)
            && n.consentVersion > o.consentVersion
            && (!isPositionConsentVersion(o.consentVersion) || isPositionConsentVersion(n.consentVersion))
            && n.revokedAt == null)
        );
    }

    // -------------------------------------------------------------------------
    // Slot d'appartenance (limite freemium "1 Miff à la fois")
    // L'index users/{uid}/memberships/{key} doit exister APRÈS le batch et
    // pointer vers cette Miff. Sa propre règle de création impose key == 'free'
    // (un seul slot gratuit) ou key == miffId avec premium actif.
    // -------------------------------------------------------------------------
    function indexAfterOk(uid, miffId) {
      return (
        existsAfter(/databases/$(database)/documents/users/$(uid)/memberships/free)
        && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/free).data.miffId == miffId
      ) || (
        existsAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(miffId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(miffId)).data.miffId == miffId
      );
    }

    // Créateur : le document Miff est créé dans le même batch (n'existe pas avant).
    function ownerCreateOk(miffId, uid) {
      return !exists(/databases/$(database)/documents/miffs/$(miffId))
        && getAfter(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == uid
        && indexAfterOk(uid, miffId);
    }

    // Rejoindre : preuve de connaissance du code secret. Le document
    // joinCodes/{code} doit exister et pointer vers CETTE Miff.
    function memberJoinOk(miffId, uid, d) {
      return isJoinCode(d.joinCode)
        && get(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId
        && exists(/databases/$(database)/documents/miffs/$(miffId))
        && indexAfterOk(uid, miffId);
    }

    // Profil (a) : pas de Miff créée ni rejointe sans un profil users/{uid} qui porte l'acceptation des CGU
    // (termsAcceptedAt, termsVersion). getAfter : le profil peut être créé dans le MÊME lot que la Miff ou l'adhésion.
    // Une seule fiche membre est créée dans les deux cas (créateur ou code), donc un seul point de contrôle ; la
    // création de la Miff exige déjà la fiche du créateur (validMiffCreate). Échoue (refus) si le profil est absent.
    function termsAcceptedAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.keys().hasAll(['termsAcceptedAt', 'termsVersion']);
    }

    function validMemberCreate(miffId, uid) {
      let d = request.resource.data;
      // Téléphone (ONB-B) : obligatoire, E.164, et identique à celui du profil users/{uid} (profil existant ou créé dans le lot).
      return d.keys().hasOnly(['role', 'firstName', 'lastName', 'avatar', 'phone', 'joinedAt', 'joinCode', 'sharing'])
        && d.keys().hasAll(['role', 'firstName', 'lastName', 'phone', 'joinedAt', 'sharing'])
        && validProfile(d)
        && hasValidPhone(d)
        && phoneMatchesProfile(uid, d.phone)
        && d.joinedAt == request.time
        && validSharingCreate(d.sharing)
        && termsAcceptedAfter(uid)
        && (
          (d.role == 'owner' && !('joinCode' in d) && ownerCreateOk(miffId, uid))
          || (d.role == 'member' && memberJoinOk(miffId, uid, d))
        );
    }

    // Un membre ne modifie que son profil (copie) et son consentement.
    // role, joinedAt, joinCode : immuables.
    // Téléphone (ONB-B) : si la copie change, elle reste valide, ne se supprime pas et est celle du profil users/{uid} APRÈS le
    // lot (mise à jour atomique profil + fiches par le client). Une fiche antérieure sans numéro reste modifiable sans lui.
    function validMemberUpdate(miffId, uid) {
      let d = request.resource.data;
      return affected().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'sharing'])
        && validProfile(d)
        && (!affected().hasAny(['phone']) || (hasValidPhone(d) && phoneMatchesProfile(uid, d.phone)))
        && (
          !affected().hasAny(['sharing'])
          || validSharingChange(miffId, uid, resource.data.sharing, d.sharing)
        );
    }

    // Quitter / être retiré : le statut, la photo, la dernière position et l'ALERTE (AD-B1) doivent disparaître dans le
    // même batch (sinon une trace de position resterait visible d'un ex-membre, ou une alerte d'une personne qui n'est plus membre).
    // Budget (AD-B1) : l'alerte ajoute 1 lecture à ce contrôle ; la branche « retrait » lit le créateur en UNE lecture (isOwnerOneRead, même verdict
    // qu'isOwner : une Miff absente fait échouer get(), donc refuse) pour que le lot de retrait reste à 18 lectures sur 20 sans alerte, 19 avec elle.
    function memberDeleteOk(miffId, uid) {
      return isSignedIn()
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/status/$(uid))
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/photos/$(uid))
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/positions/$(uid))
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/alerts/$(uid))
        && (
          (isSelf(uid) && resource.data.role == 'member')
          // Le créateur ne peut partir qu'en supprimant la Miff dans le même batch.
          || (isSelf(uid) && resource.data.role == 'owner'
              && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)))
          // Seul le créateur retire un autre membre, ET le code de la Miff est renouvelé dans le même
          // lot (décision PM du 2026-10-22). Le départ volontaire (ci-dessus) n'impose rien.
          || (!isSelf(uid) && isOwnerOneRead(miffId) && codeRenewed(miffId))
        );
    }

    // -------------------------------------------------------------------------
    // Validation de forme : Miff, code, lieux, statut, photo
    // -------------------------------------------------------------------------
    function validMiffCreate(miffId) {
      let d = request.resource.data;
      return isMiffId(miffId)
        // Pierre tombale : un identifiant de Miff supprimée n'est JAMAIS réutilisable (sinon un ancien
        // membre se déclare créateur de la Miff « ressuscitée » et relit les lieux / statuts restés en base).
        // Le contrôle est ici (sur le document Miff lui-même) et non seulement sur la fiche membre du
        // créateur : un créateur qui a gardé sa fiche membre créerait sinon la Miff sans écrire de fiche.
        && !exists(/databases/$(database)/documents/miffsDeleted/$(miffId))
        && d.keys().hasOnly(['ownerUid', 'name', 'joinCode', 'createdAt'])
        && d.keys().hasAll(['ownerUid', 'name', 'joinCode', 'createdAt'])
        && d.ownerUid == request.auth.uid
        && isStr(d.name, 1, 40)
        && isJoinCode(d.joinCode)
        && d.createdAt == request.time
        // Pas de Miff "à moitié créée" : le membre créateur existe après le batch, et le code existe après le
        // batch ET pointe vers CETTE Miff (sinon on pourrait se donner le code d'une autre Miff : getAfter
        // échoue si le document n'existe pas => refus).
        && existsAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId;
    }

    // Renommer, ou régénérer le code. Régénérer = l'ancien code DOIT disparaître
    // dans le même batch (sinon un ex-membre garderait un code valide).
    function validMiffUpdate(miffId) {
      let d = request.resource.data;
      return affected().hasOnly(['name', 'joinCode'])
        && isStr(d.name, 1, 40)
        && isJoinCode(d.joinCode)
        && (
          !affected().hasAny(['joinCode'])
          || (
            getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId
            && !existsAfter(/databases/$(database)/documents/joinCodes/$(resource.data.joinCode))
          )
        );
    }

    // joinCodes/{code} : n'expose que miffId + nom (pour l'écran "Rejoindre ...").
    // Créé uniquement par le créateur, en cohérence avec le document Miff.
    function validJoinCodeCreate(code) {
      let d = request.resource.data;
      return d.keys().hasOnly(['miffId', 'miffName', 'createdAt'])
        && d.keys().hasAll(['miffId', 'miffName', 'createdAt'])
        && isMiffId(d.miffId)
        && isStr(d.miffName, 1, 40)
        && d.createdAt == request.time
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.joinCode == code
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.name == d.miffName;
    }

    // Catégorie du lieu (R-LIEU-2, décision du PM du 2026-11-01) : OBLIGATOIRE, liste fermée. Valeurs techniques (anglais,
    // stables) ; les libellés FR/EN sont côté client : home = Maison, work = Travail, school = École, sport = Sport,
    // relative = Chez un proche, leisure = Loisir, other = Autre.
    function isPlaceCategory(v) {
      return v in ['home', 'work', 'school', 'sport', 'relative', 'leisure', 'other'];
    }

    function validPlaceShape(d) {
      return d.keys().hasOnly(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'createdBy', 'createdAt', 'updatedAt'])
        && isStr(d.name, 1, 60)
        && d.type in ['trusted', 'risk']
        && isPlaceCategory(d.category)
        && isNullOrStr(d.address, 200)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.radiusM is int && d.radiusM >= 50 && d.radiusM <= 2000
        && (d.priority == null || (d.priority is int && d.priority >= 0 && d.priority <= 999));
    }

    // Premium = document entitlements/{uid} écrit UNIQUEMENT par le serveur / la console, actif et non expiré (expiration
    // vérifiée côté règles : pas besoin de Cloud Function pour "éteindre" un abonnement arrivé à échéance), en UNE seule
    // lecture de règles (budget des lots multi-Miffs : data-model.md §12). Sans document entitlements/{uid}, get() échoue et la
    // requête est refusée, ce qui est bien le résultat voulu (pas de premium). À n'utiliser que dans une conjonction ou une
    // disjonction POSITIVE, jamais derrière « ! ». SESS-1 : cette fonction remplace l'ancienne isPremium (exists + 2 get = 3
    // appels) dans la règle de création d'un index premium, ce qui ramène la création de Miff premium de 19 à 17 appels et
    // laisse la place à la lecture de la session (18 sur 20, marge de 2). Même résultat : un compte sans document ou expiré est refusé.
    function isPremiumOneRead(uid) {
      let e = get(/databases/$(database)/documents/entitlements/$(uid)).data;
      return e.active == true && e.expiresAt > request.time;
    }

    // Limite freemium "3 lieux" (R-LIEU-5, décision du PM du 2026-11-01, portée de 2 à 3 le 2026-11-10) : en gratuit, SEULS les
    // identifiants 'p1', 'p2' et 'p3' et le type 'trusted' sont acceptés (recréer un identifiant existant est une mise à jour, soumise à validPlaceUpdate).
    // Premium : identifiants libres et zones de danger. Un lieu rattaché à plusieurs Miffs = UN document par Miff avec le MÊME
    // identifiant (généré une fois par le client) : chaque document est évalué séparément, aucune règle ne compare les copies.
    function validPlaceCreate(placeId) {
      let d = request.resource.data;
      return placeId.matches('^[A-Za-z0-9]{1,20}$')
        && validPlaceShape(d)
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && (
          (placeId in ['p1', 'p2', 'p3'] && d.type == 'trusted')
          || isPremiumOneRead(request.auth.uid)
        );
    }

    // Modifiables : nom, type (R-LIEU-6), catégorie, adresse, coordonnées, rayon, priorité. createdBy et createdAt restent
    // immuables. Le type change dans les deux sens, mais passer à 'risk' (zone de danger) exige le premium, comme à la
    // création : sinon un compte gratuit contournerait la réserve premium en créant « confiance » puis en modifiant.
    // Repasser à 'trusted' est toujours permis. Un lieu ne change jamais de Miff (le chemin du document est son identité).
    function validPlaceUpdate() {
      let d = request.resource.data;
      return affected().hasOnly(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'updatedAt'])
        && validPlaceShape(d)
        && d.updatedAt == request.time
        && (!affected().hasAny(['type']) || d.type == 'trusted' || isPremiumOneRead(request.auth.uid));
    }

    // Horodatage du statut (presenceAt, lastUpdateAt), fourni par l'appareil. Accepté dans l'un de ces deux cas (R-LIEU-1) :
    //  - récent : pas plus de 24 h dans le passé, pas plus de 5 min dans le futur (comme avant) ;
    //  - conservé : IDENTIQUE (à la microseconde, précision de stockage de Firestore) à la valeur que le même champ du même statut a
    //    déjà en base, quel que soit son âge. Un téléphone resté
    //    plus de 24 h dans la même situation peut ainsi réécrire son statut sans mentir sur l'heure qu'il ne change pas.
    // La valeur conservée n'est jamais choisie par le client : elle doit être égale à celle de la base (aucune nouvelle ancienne
    // heure, aucun recul, aucune avance hors fenêtre, jamais la valeur d'un autre champ ni d'un autre document). À la création
    // (resource nul) seul le cas « récent » existe. resource n'est pas une lecture de règles (aucun coût ajouté, budget inchangé).
    function statusInstant(v, key) {
      return v is timestamp
        && ((v >= request.time - duration.value(1, 'd') && v <= request.time + duration.value(5, 'm'))
            || (resource != null && resource.data.get(key, null) == v));
    }

    // État courant du membre dans UNE Miff. Jamais de coordonnées brutes :
    // uniquement l'état (dans un lieu / hors lieu / zone de danger / en voyage) + horodatages.
    // Toutes les clés sont toujours présentes (null si non applicable), sauf `deviceId`, `travelUntil`, `travelUntilDay` et `photoAt`, facultatives.
    function validStatus(miffId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['presence', 'placeId', 'presenceAt', 'lastUpdateAt', 'updateText', 'hasPhoto', 'batteryPct', 'locationAccess', 'escalationDueAt', 'updatedAt', 'deviceId', 'travelUntil', 'travelUntilDay', 'photoAt'])
        && d.keys().hasAll(['presence', 'placeId', 'presenceAt', 'lastUpdateAt', 'updateText', 'hasPhoto', 'batteryPct', 'locationAccess', 'escalationDueAt', 'updatedAt'])
        && d.presence in ['in_trusted', 'out', 'in_risk', 'unknown', 'travel']
        // Mode voyage (VOY-B, pour tous les comptes) : cohérence des clés de voyage et fenêtre de fin, voir validTravel.
        && validTravel(d)
        // Un compte, un seul appareil (SESS-1) : clé facultative `deviceId` (temps 1), égale à celle de la session si présente.
        && fromActiveDevice(d, uid)
        && (d.placeId == null || isStr(d.placeId, 1, 40))
        // Horodatages d'événement fournis par l'appareil (utile hors-ligne) : bornés (-24 h / +5 min) OU conservés à
        // l'identique de la valeur déjà en base (R-LIEU-1), voir statusInstant.
        && statusInstant(d.presenceAt, 'presenceAt')
        && statusInstant(d.lastUpdateAt, 'lastUpdateAt')
        && isNullOrStr(d.updateText, 140)
        && d.hasPhoto is bool
        // Date de la dernière photo (FEED-ORDRE-PHOTO) : facultative, conservée ou heure du serveur avec hasPhoto, voir validPhotoAt.
        && validPhotoAt(d)
        && (d.batteryPct == null || (d.batteryPct is int && d.batteryPct >= 0 && d.batteryPct <= 100))
        && d.locationAccess in ['background', 'foreground', 'denied', 'unknown']
        && (d.escalationDueAt == null
            || (d.escalationDueAt is timestamp
                && d.escalationDueAt >= request.time - duration.value(1, 'd')
                && d.escalationDueAt <= request.time + duration.value(1, 'd')))
        && d.updatedAt == request.time
        // Consentement actif APRÈS le batch (le membre peut activer le partage
        // et créer son statut dans le même batch).
        && getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing.enabled == true;
    }

    // Date de la dernière photo publiée (FEED-ORDRE-PHOTO, ticket docs/tickets/feed-ordre-photo.md, décision du PM du 2026-11-20 : le Feed classe les
    // cartes UNIQUEMENT selon cette date). Clé FACULTATIVE `photoAt` du statut (dans hasOnly, absente de hasAll ; absente ou nulle = « pas de date »).
    // Trois cas acceptés, et aucun autre :
    //  - absente ou nulle : tous les statuts existants, tout ancien client, tout statut initial (activation du partage : la date est perdue) ;
    //  - CONSERVÉE : identique, à la microseconde, à la valeur déjà en base (`resource`). Une mise à jour PARTIELLE (tous les clients actuels, Android et
    //    iOS) qui ne touche pas la clé la garde telle quelle (document fusionné) ; une photo expirée ou supprimée ne change donc pas la date ;
    //  - NOUVELLE : exactement l'heure du serveur (`request.time`, FieldValue.serverTimestamp()) ET `hasPhoto` vrai dans le même document : c'est la
    //    publication d'une photo (même heure que le `createdAt` de la photo et le `lastUpdateAt` du même lot). Jamais l'heure de l'appareil, jamais
    //    antidatée ni postdatée, jamais la valeur d'un autre champ ni d'un autre membre. La date peut disparaître (un `set` complet sans la clé, ou
    //    suppression puis recréation du statut, que la règle de suppression de soi autorise de toute façon : impossible et inutile à interdire, cela
    //    ne fait perdre son rang qu'à son auteur).
    // Limite connue (assumée) : la règle ne prouve pas qu'une photo existe dans le même lot (un `getAfter` de plus par Miff ferait passer la mise à jour
    // manuelle de 3 à 4 lectures de règles par Miff, soit 5 Miffs au plus par lot et aucune marge) : un client modifié peut remonter SA PROPRE carte à
    // l'heure du serveur sans photo, comme il peut déjà écrire `lastUpdateAt` = maintenant sans update. Aucune lecture de règles ajoutée : `resource`
    // n'en est pas une, le coût de validStatus reste 1.
    function validPhotoAt(d) {
      let at = d.get('photoAt', null);
      return at == null
        || (at is timestamp
            && ((resource != null && resource.data.get('photoAt', null) == at)
                || (at == request.time && d.hasPhoto == true)));
    }

    // MODE VOYAGE (VOY-B, ticket docs/tickets/mode-voyage.md §4, décisions du PM du 2026-11-10) : `presence = 'travel'` avec deux clés
    // FACULTATIVES, `travelUntil` (instant de fin, timestamp) et `travelUntilDay` (jour choisi 'AAAA-MM-JJ', affichage seul).
    // DISPONIBLE POUR TOUS LES COMPTES (décision du PM du 2026-11-10, qui remplace la réserve Miff+ de la première version du ticket) :
    // AUCUNE barrière premium, AUCUNE lecture de règles ajoutée (un statut de voyage coûte 2, comme un statut ordinaire). Deux cas :
    //  - HORS voyage : une autre présence ET aucune clé de voyage (absentes ou nulles). Cas de TOUS les statuts actuels.
    //  - EN voyage : aucun lieu, aucune batterie, aucune échéance d'escalade (rien n'est mesuré : le statut ne révèle plus ni où, ni combien) ;
    //    fin strictement future et au plus 91 jours après l'heure du serveur (le client propose 90 jours, la règle garde 1 jour de marge pour
    //    le fuseau et la dérive d'horloge) ; jour bien formé (mois 01-12, jour 01-31 ; la cohérence avec la fin n'est PAS vérifiée : aucune règle
    //    ne lit le fuseau, un client modifié ne trompe que l'affichage de SA carte).
    //    Désactiver (écrire une autre présence, clés de voyage absentes ou nulles) est toujours possible. Une update qui garde « travel » après
    //    la date de fin est refusée (travelUntil > request.time) : le client termine le voyage d'abord. Une update qui garde « travel » et sa date
    //    (texte, photo) passe : la fenêtre se juge à chaque écriture, sans comparaison avec l'ancien document.
    function validTravel(d) {
      return (
          d.presence != 'travel'
          && d.get('travelUntil', null) == null
          && d.get('travelUntilDay', null) == null
        )
        || (
          d.presence == 'travel'
          && d.placeId == null
          && d.batteryPct == null
          && d.escalationDueAt == null
          && d.get('travelUntil', null) is timestamp
          && d.travelUntil > request.time
          && d.travelUntil <= request.time + duration.value(91, 'd')
          && d.get('travelUntilDay', null) is string
          && d.travelUntilDay.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        );
    }

    // Coordonnée valide : un nombre dans [-max, max] (NaN et l'infini échouent aux comparaisons).
    function isCoordinate(v, max) {
      return v is number && v >= -max && v <= max;
    }

    // -------------------------------------------------------------------------
    // Un compte, un seul appareil (SESS-1). Document de session users/{uid}/session/active { deviceId, startedAt }.
    // -------------------------------------------------------------------------
    // TEMPS DU DÉPLOIEMENT (data-model.md, « Un compte, un seul appareil ») :
    //  false = TEMPS 1 : la clé deviceId est FACULTATIVE dans le statut et la dernière position. Absente : écriture acceptée comme avant
    //          (applications actuelles, qui ne connaissent pas la session). Présente : elle doit être celle de la session.
    //  true  = TEMPS 2 : la clé est OBLIGATOIRE (et la session doit exister). À ne passer à true qu'après la livraison des applications
    //          qui écrivent la session ET la clé : sinon un téléphone à jour de l'ancienne version ne peut plus écrire son statut.
    // Un seul endroit à changer entre les deux temps ; les tests (22 et 23-session-appareil) rejouent les deux.
    function deviceIdRequired() {
      return false;
    }

    // Identifiant d'appareil : aléatoire, généré par l'application à chaque connexion, sans lien avec l'appareil physique (ni
    // numéro de série, ni identifiant publicitaire). 16 à 64 caractères d'un alphabet sans séparateur de chemin.
    function isDeviceId(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{16,64}$');
    }

    // Session valide : exactement deux clés, un identifiant bien formé, l'heure du début fournie par le serveur.
    function validSession() {
      let d = request.resource.data;
      return d.keys().hasOnly(['deviceId', 'startedAt'])
        && d.keys().hasAll(['deviceId', 'startedAt'])
        && isDeviceId(d.deviceId)
        && d.startedAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Jetons d'appareil pour les notifications (SRV-2R) : users/{uid}/devices/{deviceId}.
    // -------------------------------------------------------------------------
    // Fuseau horaire IANA ou assimilé ('Europe/Paris', 'America/Argentina/Buenos_Aires', 'Etc/GMT+5', 'GMT+01:00') : 1 à 64 caractères, commence par une lettre.
    function isDeviceTz(v) {
      return v is string && v.matches('^[A-Za-z][A-Za-z0-9_+:/-]{0,63}$');
    }

    // Préférences par type de notification : map fermée, un seul booléen en v1 (d'autres types = une évolution des règles).
    function validDeviceNotify(n) {
      return n is map
        && n.keys().hasOnly(['updates'])
        && n.keys().hasAll(['updates'])
        && n.updates is bool;
    }

    // Forme commune à la création et à la mise à jour, APRÈS l'écriture (document fusionné). `deviceId` = identifiant de la session active du compte :
    // getAfter (et non get) pour que le lot de connexion puisse écrire la session et le jeton ensemble ; si la session n'existe pas, getAfter échoue
    // et l'écriture est refusée. UNE lecture de règles. Aucune donnée d'un autre utilisateur n'est lue.
    function validDeviceShape(uid, deviceId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['token', 'platform', 'appVersion', 'tz', 'notify', 'updatedAt', 'createdAt'])
        && d.keys().hasAll(['token', 'platform', 'appVersion', 'tz', 'notify', 'updatedAt', 'createdAt'])
        && isStr(d.token, 1, 4096)
        && d.platform in ['ios', 'android']
        && isStr(d.appVersion, 1, 32)
        && isDeviceTz(d.tz)
        && validDeviceNotify(d.notify)
        && d.updatedAt == request.time
        && isDeviceId(deviceId)
        && getAfter(/databases/$(database)/documents/users/$(uid)/session/active).data.deviceId == deviceId;
    }

    // L'écriture (statut, position) vient-elle de l'appareil actif ? Sans clé deviceId : acceptée au temps 1, refusée au temps 2
    // (aucune lecture). Avec la clé : elle doit égaler celle de la session du même compte (UNE lecture de règles ; si la session
    // n'existe pas, get() échoue et l'écriture est refusée). Mesure de COHÉRENCE : un client modifié peut recopier l'identifiant
    // lu dans sa propre session, donc ce n'est pas une barrière de sécurité.
    function fromActiveDevice(d, uid) {
      return ('deviceId' in d && d.deviceId == get(/databases/$(database)/documents/users/$(uid)/session/active).data.deviceId)
        || (!('deviceId' in d) && !deviceIdRequired());
    }

    // Dernière position connue du membre dans UNE Miff (R-LIEU-POS). SEULEMENT latitude, longitude et heure de la mesure
    // (aucune précision, aucune vitesse, aucune altitude, aucun historique : le document est écrasé). Données sensibles.
    //  - lat / lng : nombres dans les plages valides (NaN et l'infini sont refusés par les comparaisons) ;
    //  - measuredAt : heure de la mesure fournie par l'appareil, bornée comme les horodatages du statut (pas plus de 24 h dans
    //    le passé, pas plus de 5 min dans le futur) ;
    //  - consentement : partage actif ET texte de version 3 ou plus APRÈS le lot (getAfter : on peut activer le partage et
    //    écrire la position dans le même lot, mais pas révoquer et écrire). UNE lecture de règles ici (+1 pour l'existence de la Miff dans la règle : 2 au total).
    // La précision des coordonnées (5 décimales, ~1 m) est un contrat du client : une règle ne peut pas la contrôler
    // proprement sur des nombres à virgule flottante.
    function validPosition(miffId, uid) {
      let d = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing;
      return d.keys().hasOnly(['lat', 'lng', 'measuredAt', 'deviceId'])
        && d.keys().hasAll(['lat', 'lng', 'measuredAt'])
        && isCoordinate(d.lat, 90)
        && isCoordinate(d.lng, 180)
        && d.measuredAt is timestamp
        && d.measuredAt >= request.time - duration.value(1, 'd')
        && d.measuredAt <= request.time + duration.value(5, 'm')
        // Un compte, un seul appareil (SESS-1) : même contrôle que le statut (une lecture de règles de plus quand la clé est présente).
        && fromActiveDevice(d, uid)
        && s.enabled == true
        && isPositionConsentVersion(s.consentVersion);
    }

    // Localisation de la photo (R-PHOTO-LOC) : le document a-t-il une localisation ? (clés absentes ou nulles = non). `d` est un document
    // de photo EXISTANT (resource.data) : utilisé UNIQUEMENT à la lecture. Depuis la décision du 2026-11-06 toute photo écrite est localisée,
    // mais un éventuel ancien document sans localisation (écrit avant le resserrage ; aucune application publiée n'en écrit, voir
    // data-model.md) reste lisible comme avant : on ne durcit pas la lecture, on ne l'affaiblit pas non plus. Aucune lecture de règles.
    function photoHasLocation(d) {
      return d.get('lat', null) != null || d.get('lng', null) != null;
    }

    // Localisation de la photo à l'écriture (R-PHOTO-LOC, version OBLIGATOIRE, décision du PM du 2026-11-06 : « une photo d'update doit être
    // attachée à une position, forcément ») : TOUTE photo porte lat, lng et measuredAt (validPhoto en exige la présence), jamais nulles :
    //  - deux coordonnées valides, nombres dans les mêmes plages que validPosition (un null, un texte, NaN ou l'infini échouent) ;
    //  - le consentement APRÈS le lot de version 03 ou plus (jamais de photo, donc jamais de coordonnée enregistrée, sans lui) ;
    //  - measuredAt : l'heure de la mesure faite par l'appareil, même nom et même sémantique que positions/{uid}.measuredAt, bornée comme
    //    elle (pas plus de 24 h dans le passé, pas plus de 5 min après l'heure de la photo, qui est l'heure serveur : createdAt ==
    //    request.time). Sert à afficher « position de il y a X min » ; ne révèle rien de plus que la dernière position. 24 h plutôt que
    //    quelques minutes : une borne serrée refuserait TOUTE la photo (image comprise) pour une mesure un peu ancienne ; la fraîcheur est un
    //    contrat du client (data-model.md), l'affichage dit toujours l'âge de la mesure.
    // Mises à jour partielles : request.resource.data est le document FUSIONNÉ, donc supprimer une clé (FieldValue.delete) le laisse
    // sans cette clé et validPhoto le refuse. Le « ensemble » de lat et lng est inclus (aucune des trois ne peut manquer ni être nulle).
    // s = sharing après le lot. La précision (5 décimales) est un contrat du client. Aucune lecture de règles (s est déjà lu par validPhoto).
    function validPhotoLocation(d, s) {
      return isCoordinate(d.lat, 90) && isCoordinate(d.lng, 180)
        && isPhotoLocationConsentVersion(s.consentVersion)
        && d.measuredAt is timestamp
        && d.measuredAt >= request.time - duration.value(1, 'd')
        && d.measuredAt <= request.time + duration.value(5, 'm');
    }

    // Lecture de la localisation d'une photo (R-PHOTO-LOC) : `d` = resource.data. Sans localisation : toujours (aucune lecture de
    // règles : « || » s'arrête). Avec : l'auteur lui-même (transparence, comme positions/{moi}), ou un membre qui a publié sa propre
    // position. 1 lecture de règles de plus, seulement pour une photo localisée. Réciprocité FORMELLE : elle prouve qu'un document
    // positions/{moi} existe, pas qu'il est vrai. PAS de contrôle « l'auteur partage encore » (décision du PM du 2026-11-06, contrairement à
    // positions/{uid}) : un reliquat éventuel (photo restée après l'arrêt du partage) reste lisible au plus jusqu'à expiresAt (24 h + 1 h),
    // et la sécurité repose sur les lots de purge, que les règles EXIGENT déjà (arrêt du partage, départ, retrait, suppression) : tout futur
    // lot qui arrête un partage DOIT purger la photo.
    function photoLocationReadable(miffId, uid, d) {
      return !photoHasLocation(d)
        || isSelf(uid)
        || positionPublished(miffId);
    }

    // Photo de la dernière update (au plus une par membre et par Miff).
    // Clés : jpeg, createdAt, expiresAt, lat, lng, measuredAt, TOUTES obligatoires (R-PHOTO-LOC : une photo est toujours localisée). PAS de deviceId (SESS-1).
    // + description (DESC-R, ticket docs/tickets/description-update.md) : texte libre FACULTATIF de 1 à 140 unités UTF-16 (même comptage que les noms,
    // isStr), « absente plutôt que vide » : jamais null, jamais "" (le client n'écrit la clé que si le texte nettoyé n'est pas vide). La règle ne peut pas
    // juger les espaces seuls, les retours à la ligne ni les caractères de contrôle : le nettoyage (trim, retours à la ligne remplacés) est un contrat du
    // client. Donnée saisie librement, pouvant contenir des données personnelles : même durée de vie, même lecture et mêmes suppressions que la photo
    // (aucune règle de lecture ni de suppression ne change). Contrôle pur sur les données : aucune lecture de règles de plus.
    // Republication : « set » sans fusion = le document est ÉCRASÉ, description comprise (une republication sans description l'efface) ; une mise à jour
    // PARTIELLE (update / merge) qui ne touche pas la clé GARDE l'ancienne description (document fusionné jugé) : le contrat du client impose « set ».
    function validPhoto(miffId, uid) {
      let d = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing;
      return d.keys().hasOnly(['jpeg', 'createdAt', 'expiresAt', 'lat', 'lng', 'measuredAt', 'description'])
        && d.keys().hasAll(['jpeg', 'createdAt', 'expiresAt', 'lat', 'lng', 'measuredAt'])
        && (!('description' in d) || isStr(d.description, 1, 140))
        && d.jpeg is bytes && d.jpeg.size() > 0 && d.jpeg.size() <= 150000
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        // 24 h + 1 h de marge (expiresAt vient de l'horloge du téléphone). Même durée pour tous les
        // comptes, premium ou non : aucune règle de photo ne dépend de l'abonnement.
        && d.expiresAt <= request.time + duration.value(25, 'h')
        && s.enabled == true
        && validPhotoLocation(d, s);
    }

    // -------------------------------------------------------------------------
    // Demande d'ajout d'un lieu par un membre (LIEU-REQ-A, ticket docs/tickets/demande-ajout-lieu.md, décisions du PM D1 à D9 du 2026-11-11).
    // NON DÉPLOYÉ. Document miffs/{id}/placeRequests/{uid}_{1..3} : TROIS EMPLACEMENTS FIXES par membre (même principe que p1/p2/p3 : les règles ne
    // savent pas compter, elles imposent un identifiant). Un compteur miffs/{id}/meta/placeRequests tient le plafond de 10 par Miff.
    // -------------------------------------------------------------------------
    // Identifiant d'emplacement du demandeur : {uid}_1, {uid}_2 ou {uid}_3 (comparaison de textes, pas d'expression régulière : un uid ne peut
    // pas injecter de motif). Aucune lecture de règles.
    function isOwnRequestId(reqId) {
      return isSignedIn()
        && reqId in [request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3'];
    }

    // Forme d'une demande : EXACTEMENT ces 9 clés (ni statut, ni message, ni nom du demandeur : minimisation). Mêmes bornes qu'un lieu pour les
    // champs communs (nom, type, catégorie, adresse, coordonnées, rayon). Pas de `priority` : le lieu créé à l'acceptation la reçoit du client
    // (validPlaceShape l'exige ; `category` est copiée de la demande). createdAt et requestedBy sont contrôlés par la règle de création. Aucune lecture de règles.
    function validRequestShape(d) {
      return isStr(d.name, 1, 60)
        && d.keys().hasOnly(['requestedBy', 'name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'createdAt'])
        && d.keys().hasAll(['requestedBy', 'name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'createdAt'])
        && (d.type == 'trusted' || d.type == 'risk')
        && isRequestCategory(d.category)
        && (d.address == null || (d.address is string && d.address.size() <= 200))
        && isLatLng(d.lat, d.lng)
        && isPlaceRadius(d.radiusM);
    }

    // Catégorie de la demande : la MÊME liste fermée qu'un lieu (isPlaceCategory, R-LIEU-2), obligatoire ; l'acceptation la copie dans le lieu créé.
    function isRequestCategory(v) {
      return isPlaceCategory(v);
    }

    // Point géographique valide (mêmes bornes que les lieux) et rayon en mètres (mêmes bornes que les lieux : 50 à 2000, entier). Aucune lecture.
    function isLatLng(lat, lng) {
      return isCoordinate(lat, 90) && isCoordinate(lng, 180);
    }

    function isPlaceRadius(v) {
      return v is int && v >= 50 && v <= 2000;
    }

    // Membre qui n'est PAS le créateur, en UNE lecture de règles (la fiche du membre : le rôle est immuable). Échoue (refus) si la fiche n'existe pas.
    function isPlainMember(miffId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid)).data.role == 'member';
    }

    // Le compteur de la Miff est écrit DANS CE LOT et pointe vers CETTE demande : `updatedAt == request.time` prouve que le compteur est écrit dans
    // le lot en cours (un `lastReqId` périmé d'un lot précédent ne suffit pas), `lastReqId == reqId` le lie à la demande. Le sens (+1 / -1), la
    // borne de 10 et l'existence de la demande avant / après sont contrôlés par la règle du compteur (validRequestCounter). UNE lecture de règles.
    function requestCounterMoved(miffId, reqId) {
      let c = getAfter(/databases/$(database)/documents/miffs/$(miffId)/meta/placeRequests).data;
      return c.lastReqId == reqId && c.updatedAt == request.time;
    }

    // Écriture du compteur par un MEMBRE : liée à la création (+1) ou à la suppression (-1) de SA demande dans le même lot. `resource` (état avant)
    // et `request.resource` (état après) ne coûtent aucune lecture ; la demande est lue avant (exists) et après (existsAfter) : 2 lectures.
    // Création de la demande : compteur +1 (1 si le compteur n'existait pas) ; la borne de 10 est dans la forme du compteur (la 11e est refusée).
    // Suppression : compteur -1, jamais en dessous de 0 (un compteur recalé trop bas par le créateur ne doit pas empêcher un membre de retirer sa demande).
    function memberCounterOk(miffId, d) {
      let req = /databases/$(database)/documents/miffs/$(miffId)/placeRequests/$(d.lastReqId);
      let was = exists(req);
      let will = existsAfter(req);
      return isOwnRequestId(d.lastReqId)
        && (
          (!was && will
            && d.pending == (resource == null ? 0 : resource.data.pending) + 1)
          || (was && !will && resource != null
            && d.pending == (resource.data.pending > 0 ? resource.data.pending - 1 : 0))
        );
    }

    // Compteur miffs/{id}/meta/placeRequests : { pending 0..10, lastReqId, updatedAt = heure serveur }. Deux écrivains :
    //  - le CRÉATEUR (lastReqId == null) : valeur libre dans 0..10, c'est lui qui recale le compteur s'il a dérivé (il connaît le nombre réel de demandes) ;
    //  - un MEMBRE : seulement lié à la création ou au retrait de sa propre demande dans le même lot (memberCounterOk). Un membre ne peut jamais fixer
    //    la valeur, la remettre à zéro, ni la gonfler sans créer de demande (anti-blocage du plafond).
    function validRequestCounter(miffId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['pending', 'lastReqId', 'updatedAt'])
        && d.keys().hasAll(['pending', 'lastReqId', 'updatedAt'])
        && d.pending is int && d.pending >= 0 && d.pending <= 10
        && d.updatedAt == request.time
        && (
          (d.lastReqId == null && isOwnerOneRead(miffId))
          || (d.lastReqId != null && memberCounterOk(miffId, d))
        );
    }

    // -------------------------------------------------------------------------
    // Quota d'alertes : 3 DÉBUTS d'alerte au plus par utilisateur et par fenêtre glissante de 24 h, toutes Miffs confondues (décision du PM du 2026-11-18). DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM).
    // Document users/{uid}/quota/alerts : trois cases s0, s1, s2 (heure serveur du début qui l'a remplie, ou null), lastMiffId (Miff du dernier début), updatedAt, expireAt.
    // MÉCANISME : une règle ne sait pas compter, elle valide une transition. Un début d'alerte (création OU ré-armement) n'est accepté que si le MÊME lot écrit ce document
    // en REMPLAÇANT une case libre (null) ou périmée (début d'il y a 24 h ou plus) par request.time : au plus 3 cases pleines dans toute fenêtre de 24 h, donc 3 débuts. Le 4e est
    // refusé (permission-denied) tant qu'aucune case n'a 24 h. Terminer une alerte ne rend aucun crédit ; supprimer et recréer l'alerte en consomme un de plus ; l'heure est celle du SERVEUR
    // (request.time), jamais celle de l'appareil ; le compteur ne s'écrit qu'à l'identique d'un début (une seule case à la fois, valeur = request.time) : on ne peut ni le remettre à zéro, ni
    // reculer une case. Il est lié à UNE Miff par lot (lastMiffId = Miff de l'alerte) : un lot ne peut pas démarrer des alertes dans deux Miffs avec un seul crédit. 0 lecture de règles pour écrire
    // ce document ; +1 lecture (getAfter) pour l'alerte qui le revendique.
    // SUPPRESSION (revue de #274, M1 du delta) : le compteur ne se supprime que si le profil n'existe plus après l'opération (effacement RGPD) ET si les trois cases sont vides ou vieilles de 24 h ou
    // plus (quotaAllFree) : sinon « supprimer le profil, supprimer le compteur, recréer le profil » le remettrait à zéro (le profil se supprime seul : sa règle n'est pas modifiée). CONSÉQUENCE : une
    // suppression de compte dans les 24 h qui suivent un début d'alerte NE PEUT PAS effacer le compteur (refus) ; il reste orphelin jusqu'à la règle TTL `expireAt` (3 jours au plus) ; le client tolère ce refus.
    // LIMITES : (1) un utilisateur qui crée un AUTRE compte Auth (autre uid) repart à zéro : aucune règle ne relie les comptes d'une même personne ; (2) la règle TTL `expireAt` (à poser par le PM AVANT le
    // déploiement des règles) l'efface au plus tard ~3 jours après le dernier début (toutes les cases ont alors plus de 24 h : aucun contournement).
    // -------------------------------------------------------------------------
    // Forme : 6 clés exactes (s0, s1, s2, lastMiffId, updatedAt, expireAt) ; cases = horodatage serveur ou null ; Miff = identifiant bien formé ; expireAt = fenêtre de 1 à 3 jours (contrat du client : appareil + 2 jours).
    function quotaShape(d) {
      return d.keys().hasOnly(['s0', 's1', 's2', 'lastMiffId', 'updatedAt', 'expireAt'])
        && d.keys().hasAll(['s0', 's1', 's2', 'lastMiffId', 'updatedAt', 'expireAt'])
        && (d.s0 == null || d.s0 is timestamp)
        && (d.s1 == null || d.s1 is timestamp)
        && (d.s2 == null || d.s2 is timestamp)
        && isMiffId(d.lastMiffId)
        && d.updatedAt == request.time
        && d.expireAt is timestamp
        && d.expireAt > request.time + duration.value(1, 'd')
        && d.expireAt <= request.time + duration.value(3, 'd');
    }

    // Les trois cases sont vides ou ont 24 h ou plus (aucun crédit en cours) : seule condition pour supprimer le compteur. Aucune lecture de règles (resource.data).
    function quotaAllFree(d) {
      return (d.s0 == null || d.s0 <= request.time - duration.value(24, 'h'))
        && (d.s1 == null || d.s1 <= request.time - duration.value(24, 'h'))
        && (d.s2 == null || d.s2 <= request.time - duration.value(24, 'h'));
    }

    // Création du compteur (premier début) : la case s0 vaut l'heure du serveur, les deux autres sont vides.
    function quotaFirstStart(d) {
      return d.s0 == request.time && d.s1 == null && d.s2 == null;
    }

    // Mise à jour : UNE case (slot) change, elle vaut l'heure du serveur, elle était vide ou avait 24 h ou plus ; seuls cette case, lastMiffId, updatedAt et expireAt bougent.
    function quotaSlotUsed(slot) {
      let d = request.resource.data;
      return affected().hasAll([slot, 'updatedAt'])
        && affected().hasOnly([slot, 'lastMiffId', 'updatedAt', 'expireAt'])
        && d[slot] == request.time
        && (resource.data[slot] == null || resource.data[slot] <= request.time - duration.value(24, 'h'));
    }

    // L'alerte de cette Miff revendique le crédit écrit DANS CE LOT : le compteur (après le lot) porte l'heure du serveur et la Miff de l'alerte. UNE lecture de règles (getAfter).
    // Si le compteur n'existe pas après le lot, getAfter échoue : refus (aucun début d'alerte sans crédit).
    function alertQuotaOk(miffId, uid) {
      let q = getAfter(/databases/$(database)/documents/users/$(uid)/quota/alerts).data;
      return q.updatedAt == request.time && q.lastMiffId == miffId;
    }

    // -------------------------------------------------------------------------
    // Alerte « Je suis en danger » (AD-B1, ticket docs/tickets/alerte-danger.md §10) — DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM). Document miffs/{miffId}/alerts/{uid}.
    // SENSIBLE par nature (une personne se déclare en danger) mais SANS position, SANS texte libre, SANS photo.
    // -------------------------------------------------------------------------
    // Durée de l'alerte : 7 jours AU PLUS, imposés par la règle. Un client ne peut pas écrire « heure du serveur + 7 jours » (la seule valeur serveur est
    // request.time, utilisable pour startedAt), donc expiresAt est calculé par l'appareil et la règle impose une FENÊTRE autour de la valeur exacte :
    // strictement plus de 6 jours et jamais plus de 7 jours après l'heure du serveur. Contrat du client : expiresAt = (heure de l'appareil) + 7 jours - 2 heures
    // (marge pour une horloge en avance de 2 h au plus ; en retard, jusqu'à 22 h). Aucune lecture de règles.
    function alertExpiryWindow(d) {
      return d.expiresAt is timestamp
        && d.expiresAt > request.time + duration.value(6, 'd')
        && d.expiresAt <= request.time + duration.value(7, 'd');
    }

    // Partage de position ACTIF dans cette Miff après le lot (comme la position et la photo) : on ne déclare pas d'alerte dans une Miff où l'on ne partage
    // pas (la fiche doit exister : getAfter échoue sinon, donc refus). UNE lecture de règles.
    function alertSharingAfter(miffId, uid) {
      return getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing.enabled == true;
    }

    // Un compte, un seul appareil (SESS-1) : la clé deviceId est OBLIGATOIRE (nouvelle donnée, aucune application existante à ménager : indépendant du temps 1 /
    // temps 2 de deviceIdRequired) et égale à celle de la session du compte. UNE lecture de règles (si la session n'existe pas, get() échoue : refus).
    // Mesure de COHÉRENCE, pas de sécurité : un client modifié peut recopier l'identifiant lu dans sa propre session.
    function alertDeviceOk(d, uid) {
      return isDeviceId(d.deviceId)
        && get(/databases/$(database)/documents/users/$(uid)/session/active).data.deviceId == d.deviceId;
    }

    // Forme : 7 clés EXACTES, aucune autre ; types ; cohérence état / date de fin (active : endedAt nul ; ended : endedAt présent). Aucune lecture.
    function alertShape(d) {
      return d.keys().hasOnly(['status', 'startedAt', 'expiresAt', 'endedAt', 'seq', 'deviceId', 'purgeAt'])
        && d.keys().hasAll(['status', 'startedAt', 'expiresAt', 'endedAt', 'seq', 'deviceId', 'purgeAt'])
        && d.startedAt is timestamp
        && d.expiresAt is timestamp
        && d.purgeAt is timestamp
        && d.seq is int && d.seq >= 1
        && ((d.status == 'active' && d.endedAt == null) || (d.status == 'ended' && d.endedAt is timestamp));
    }

    // Début d'une alerte (création ou ré-armement) : active, démarrée à l'heure du serveur, durée de 7 jours au plus, pas de fin, suppression automatique 2 jours
    // après l'échéance, appareil de la session. Le numéro de démarrage (seq) est jugé à part par chaque règle. UNE lecture de règles (la session).
    function alertStart(d, uid) {
      return d.status == 'active'
        && d.startedAt == request.time
        && alertExpiryWindow(d)
        && d.endedAt == null
        && d.purgeAt == d.expiresAt + duration.value(2, 'd')
        && alertDeviceOk(d, uid);
    }

    // Ré-armement : le document existe déjà (fin manuelle OU échéance dépassée) ; jamais tant que l'alerte est active et non expirée. seq + 1, au moins 60 s
    // depuis l'ancien startedAt (D20, silencieux : contournable par suppression puis recréation, la fonction reste la vraie barrière), mêmes conditions qu'un
    // début, et crédit du quota d'alertes écrit dans le même lot (3 par 24 h et par utilisateur). 4 lectures de règles : session, Miff, partage, quota.
    function alertRearm(miffId, uid) {
      let d = request.resource.data;
      return (resource.data.status == 'ended' || resource.data.expiresAt <= request.time)
        && request.time >= resource.data.startedAt + duration.value(60, 's')
        && d.seq == resource.data.seq + 1
        && alertQuotaOk(miffId, uid)
        && alertStart(d, uid)
        && miffAlive(miffId)
        && alertSharingAfter(miffId, uid);
    }

    // Fin manuelle : depuis « active » seulement, l'heure de fin est celle du serveur, suppression automatique dans 1 à 3 jours (purgeAt est calculé par
    // l'appareil : fenêtre, comme expiresAt), SEULS status, endedAt, purgeAt et deviceId changent (un autre appareil qui a adopté l'alerte écrit son propre
    // identifiant de session dans le même geste ; un appareil remplacé ne peut plus terminer l'alerte). Une alerte active mais expirée peut aussi être
    // terminée (la fonction ne notifie pas une fin postérieure à l'échéance). UNE lecture de règles (la session).
    function alertEnd(uid) {
      let d = request.resource.data;
      return resource.data.status == 'active'
        && affected().hasOnly(['status', 'endedAt', 'purgeAt', 'deviceId'])
        && d.status == 'ended'
        && d.endedAt == request.time
        && d.purgeAt > request.time + duration.value(1, 'd')
        && d.purgeAt <= request.time + duration.value(3, 'd')
        && alertDeviceOk(d, uid);
    }

    // =========================================================================
    // users/{uid} — profil privé (lisible uniquement par son propriétaire)
    // Les autres membres voient une COPIE du profil dans miffs/*/members/*.
    // =========================================================================
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      // Création = (a) acceptation des CGU et de la politique (obligatoire : sans elle, pas de profil ;
      // heure serveur + version du texte) + (b) consentement facultatif aux statistiques (bloc facultatif :
      // absent = pas de consentement ; sinon voir validAnalyticsConsentCreate). Aucune date de naissance,
      // aucun âge, aucun e-mail : toute autre clé est refusée.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'createdAt', 'termsAcceptedAt', 'termsVersion', 'analyticsConsent'])
        && request.resource.data.keys().hasAll(['firstName', 'lastName', 'phone', 'createdAt', 'termsAcceptedAt', 'termsVersion'])
        && validProfile(request.resource.data)
        && hasValidPhone(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.termsAcceptedAt == request.time
        && isStr(request.resource.data.termsVersion, 1, 20)
        && (!('analyticsConsent' in request.resource.data)
            || validAnalyticsConsentCreate(request.resource.data.analyticsConsent));

      // Mise à jour par le propriétaire : profil et consentement (b) seulement. termsAcceptedAt, termsVersion
      // (a) et createdAt sont figés à la création (décision PM : (a) non modifiable). Le consentement (b) ne
      // change que par une transition valide (activer, retirer, réactiver) ; supprimer le bloc est refusé.
      allow update: if isSelf(uid)
        && affected().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'analyticsConsent'])
        && validProfile(request.resource.data)
        && (!affected().hasAny(['phone']) || hasValidPhone(request.resource.data))
        && isStr(request.resource.data.termsVersion, 1, 20)
        && (!affected().hasAny(['analyticsConsent'])
            || validAnalyticsConsentChange(resource.data.get('analyticsConsent', null), request.resource.data.analyticsConsent));

      // Suppression de compte : le client supprime ses données puis son compte Auth.
      allow delete: if isSelf(uid);

      // ---- Session « un compte, un seul appareil » (SESS-1) -------------------
      // Un seul document, de chemin fixe `active` (aucun autre identifiant, aucune liste). Lisible et écrivable par son propriétaire
      // SEUL : ni le créateur d'une Miff, ni un co-membre ne le lit. Écrit à chaque connexion (la dernière gagne, `set` complet),
      // supprimé à la déconnexion volontaire et à la suppression du compte. Les règles ne savent pas QUI supprime : un client ne doit
      // supprimer la session que si elle porte SON identifiant (transaction), sinon il effacerait celle du nouvel appareil.
      // (Écrit « request.auth.uid == uid » plutôt que isSelf(uid) : les tests par mutation repèrent les règles par leur texte et leur rang.
      // Aucune règle « list » : une requête sur la sous-collection est refusée par défaut, comme tout ce qui n'est pas écrit.)
      match /session/active {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && validSession();
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ---- Index des appartenances (liste "mes Miffs" + slot freemium) -------
      // Clé 'free' = slot gratuit (1 seul possible) ; clé = miffId = premium.
      match /memberships/{key} {
        allow get, list: if isSelf(uid);

        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['miffId', 'joinedAt'])
          && request.resource.data.keys().hasAll(['miffId', 'joinedAt'])
          && isMiffId(request.resource.data.miffId)
          && request.resource.data.joinedAt == request.time
          && (
            key == 'free'
            || (key == request.resource.data.miffId && isPremiumOneRead(uid))
          )
          // Le document membre correspondant est créé dans le même batch.
          && existsAfter(/databases/$(database)/documents/miffs/$(request.resource.data.miffId)/members/$(uid));

        // Immuable : empêche de "recycler" un slot vers une autre Miff.
        allow update: if false;

        // Libérer le slot n'est possible que si on n'est plus membre (sinon : 2 Miffs gratuites).
        allow delete: if isSelf(uid)
          && !existsAfter(/databases/$(database)/documents/miffs/$(resource.data.miffId)/members/$(uid));
      }

      // ---- Quota d'alertes (3 débuts par 24 h et par utilisateur, décision du PM du 2026-11-18) — DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM) ----------------------------------------
      // Lisible de son propriétaire seul (l'app peut annoncer le refus AVANT d'écrire). Création : premier début (case s0 = heure du serveur). Mise à jour : une case libre ou périmée
      // (24 h ou plus) devient l'heure du serveur, rien d'autre ; voir quotaSlotUsed. Suppression : seulement si le profil n'existe plus après l'opération (effacement RGPD) ET si les trois cases
      // sont vides ou vieilles de 24 h ou plus (sinon supprimer le profil puis le compteur puis recréer le profil remettrait le compteur à zéro). 0 lecture de règles pour écrire, 1 pour supprimer. Aucune règle de liste.
      match /quota/alerts {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if isSelf(uid) && quotaShape(request.resource.data) && quotaFirstStart(request.resource.data);
        allow update: if isSelf(uid) && quotaShape(request.resource.data)
          && (quotaSlotUsed('s0') || quotaSlotUsed('s1') || quotaSlotUsed('s2'));
        allow delete: if isSelf(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid)) && quotaAllFree(resource.data);
      }

      // ---- Jetons de notification (SRV-2R) — NON DÉPLOYÉ ---------------------------------------------------------------------
      // Un document par session active : l'identifiant est celui de users/{uid}/session/active. PRIVÉ : ni un co-membre, ni le créateur d'une Miff ne le lit
      // (le serveur le lit avec les droits Admin). Lecture (get et list) par le propriétaire : le nouvel appareil liste les anciens pour les supprimer, la
      // suppression de compte les liste. Création : forme exacte + createdAt = heure serveur. Mise à jour : même forme, createdAt et platform figés. Suppression :
      // propriétaire, sans condition (la session est supprimée avant les jetons à la suppression de compte). 1 lecture de règles à l'écriture, 0 sinon.
      match /devices/{deviceId} {
        allow get, list: if isSelf(uid);
        allow create: if isSelf(uid)
          && validDeviceShape(uid, deviceId)
          && request.resource.data.createdAt == request.resource.data.updatedAt;
        allow update: if isSelf(uid)
          && validDeviceShape(uid, deviceId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.platform == resource.data.platform;
        allow delete: if isSelf(uid);
      }

      // ---- Journal de notifications (CNC-B) — NON DÉPLOYÉ ---------------------------------------------------------------------
      // Une ligne par push reçu par ce compte (update ou alerte), écrite PAR LE SERVEUR SEUL (Admin SDK des fonctions notifierUpdate et notifierAlerte, qui ignore les règles) :
      // v, kind, miffId, actorUid, createdAt, expireAt, rien d'autre (ni prénom, ni photo, ni lieu, ni position). Lecture (get et liste) : le PROPRIÉTAIRE SEUL (ni un membre de
      // la Miff, ni le créateur, ni l'auteur de l'événement, ni un visiteur) ; la liste EXIGE une limite explicite de 100 au plus (une requête sans limite est refusée : le
      // client lit par curseur, 2 pages au plus). Suppression : le propriétaire (« Effacer » efface vraiment, suppression de compte), sans condition. AUCUNE création ni
      // modification par un client, jamais (la forme du document est donc garantie par le serveur, pas par une règle). 0 lecture de règles. Durée de vie : règle TTL
      // Firestore sur le groupe de collections `notifications`, champ `expireAt` (30 jours), à poser par le PM.
      // (Écrit « request.auth != null && request.auth.uid == uid » plutôt que isSelf(uid), comme `session/active` : les tests par mutation repèrent les règles par leur texte et leur rang.)
      match /notifications/{entryId} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if request.auth != null && request.auth.uid == uid && request.query.limit <= 100;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if false;
      }
    }

    // =========================================================================
    // entitlements/{uid} — statut premium. LECTURE seule pour le propriétaire.
    // Écrit uniquement par le serveur (Admin SDK) ou manuellement par le PM
    // dans la console. Le client ne peut JAMAIS s'attribuer le premium.
    // =========================================================================
    match /entitlements/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow write: if false;
    }

    // =========================================================================
    // joinCodes/{code} — résolution du code secret (12 caractères).
    // PAS de `list` : impossible d'énumérer les codes. `get` exige de
    // connaître le code complet. Brute force : voir data-model.md §5.
    // =========================================================================
    match /joinCodes/{code} {
      allow get: if isSignedIn() && isJoinCode(code);
      allow list: if false;

      allow create: if isSignedIn()
        && isJoinCode(code)
        && validJoinCodeCreate(code);

      // Seul le nom affiché peut changer (renommage de la Miff).
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.ownerUid == request.auth.uid
        && affected().hasOnly(['miffName'])
        && isStr(request.resource.data.miffName, 1, 40)
        && getAfter(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.name == request.resource.data.miffName;

      // À supprimer dans le même batch (ou AVANT) que la Miff : après sa
      // suppression, le propriétaire ne serait plus vérifiable.
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.ownerUid == request.auth.uid;
    }

    // =========================================================================
    // miffsDeleted/{miffId} — pierre tombale d'une Miff supprimée (ATK1).
    // Aucune donnée personnelle : seulement la date. Créée par le créateur dans
    // le lot qui supprime la Miff ; jamais lisible, modifiable ni supprimable par
    // un client (les règles de création de Miff la lisent via exists()).
    // =========================================================================
    match /miffsDeleted/{miffId} {
      allow read: if false;
      // isOwner lit l'état d'AVANT le lot (la Miff existe encore) ; existsAfter exige qu'elle disparaisse.
      allow create: if isOwner(miffId)
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId))
        && request.resource.data.keys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt == request.time;
      allow update, delete: if false;
    }

    // =========================================================================
    // miffs/{miffId} — le cercle de confiance
    // =========================================================================
    match /miffs/{miffId} {
      allow get: if isMember(miffId);
      allow list: if false;           // on arrive toujours par un identifiant connu

      allow create: if isSignedIn() && validMiffCreate(miffId);
      // ATTENTION : ce contrôle du propriétaire est aussi la barrière du RETRAIT d'un membre (seul le
      // propriétaire peut changer joinCode, ce que memberDeleteOk exige via codeRenewed). Si cette règle
      // est assouplie, le retrait perd sa barrière (mutation M17-retrait-controle-proprietaire-seul,
      // aujourd'hui équivalente, cesserait de l'être).
      allow update: if isOwner(miffId) && validMiffUpdate(miffId);
      // Suppression : dans le MÊME lot, (1) la pierre tombale miffsDeleted/{id} est créée (l'identifiant
      // ne pourra plus servir) et (2) le code secret joinCodes/{joinCode} est supprimé (aucun code orphelin
      // qui rouvrirait l'accès si la Miff revenait). resource.data.joinCode est lu sur le document supprimé.
      allow delete: if isOwner(miffId)
        && existsAfter(/databases/$(database)/documents/miffsDeleted/$(miffId))
        && !existsAfter(/databases/$(database)/documents/joinCodes/$(resource.data.joinCode));

      // ---- Membres : profil (copie), rôle, consentement --------------------
      match /members/{uid} {
        allow get, list: if isMember(miffId) && miffAlive(miffId);
        allow create: if isSelf(uid) && validMemberCreate(miffId, uid);
        allow update: if isSelf(uid) && validMemberUpdate(miffId, uid);
        allow delete: if memberDeleteOk(miffId, uid);
      }

      // ---- État courant (sensible) : seulement si le partage est activé ----
      // Lecture : réciprocité => il faut partager soi-même (partage activé ET statut publié) pour voir
      // les autres, et la Miff doit exister. Activer le partage = créer son statut dans le même lot.
      match /status/{uid} {
        allow get, list: if miffAlive(miffId) && mySharingOn(miffId) && statusPublished(miffId);
        allow create, update: if isSelf(uid) && validStatus(miffId, uid);
        // Le propriétaire de la Miff peut purger (retrait d'un membre).
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId);
      }

      // ---- Dernière position connue (très sensible, R-LIEU-POS) --------------
      // Lecture : get seulement (un membre à la fois, bouton « Localiser » ; jamais de liste). Soi-même : toujours (transparence,
      // « voir ce que je partage »). Un autre membre : Miff existante, partage actif, statut publié (comme les statuts) ET sa
      // propre position publiée (réciprocité formelle). Le créateur n'a aucun droit de lecture de plus. L'affichage masqué après
      // 24 h est une décision d'AFFICHAGE du client (la date reste affichée) : les règles ne l'appliquent pas, voir data-model.md.
      // Écriture : par soi seul, Miff existante (une position ne s'écrit pas sous une Miff supprimée : sonde X2) et validPosition.
      // Suppression : soi, ou le créateur, À TOUT MOMENT (pas seulement dans le lot de retrait) : comme pour le statut et la photo,
      // c'est un droit de suppression et non de lecture, assumé (sonde X4 / Y5, test DP17). Un ex-membre efface lui-même sa position.
      match /positions/{uid} {
        allow get: if isSelf(uid)
          || (miffAlive(miffId) && mySharingOn(miffId) && statusPublished(miffId) && positionPublished(miffId) && targetSharingOn(miffId, uid));
        allow list: if false;
        allow create, update: if isSelf(uid) && miffAlive(miffId) && validPosition(miffId, uid);
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId);
      }

      // ---- Photo de la dernière update (sensible) ---------------------------
      // Lecture : partage activé (PAS de condition de statut publié pour les photos : décision PM du
      // 2026-10-22), Miff existante, et photo non expirée (expiresAt est appliqué par les règles : aucun
      // nettoyage n'est nécessaire pour qu'elle disparaisse). Photo absente : introuvable, pas une erreur.
      // Photo LOCALISÉE (lat / lng, R-PHOTO-LOC ; depuis le resserrage du 2026-11-06 TOUTE photo écrite l'est) : en plus, l'auteur lui-même ou un
      // membre qui a publié sa propre position (évalué après l'expiration : une photo expirée ne coûte aucune lecture de règles de plus).
      // Ancien document sans localisation (aucune application publiée n'en écrit) : aucune lecture de plus, lisible comme avant.
      // Coût : 3 lectures de règles pour lire la photo d'un autre membre (4 lectures facturées avec le document), 2 pour la sienne.
      // Suppression : l'auteur, le créateur, ou n'importe quel membre une fois la photo expirée.
      match /photos/{uid} {
        allow get: if miffAlive(miffId) && mySharingOn(miffId)
          && (resource == null || resource.data.expiresAt > request.time)
          && (resource == null || photoLocationReadable(miffId, uid, resource.data));
        allow list: if false;
        allow create, update: if isSelf(uid) && validPhoto(miffId, uid);
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId)
          || (isMember(miffId) && resource.data.expiresAt <= request.time);
      }

      // ---- Alerte « Je suis en danger » (SENSIBLE, AD-B1) — DÉPLOYÉ le 2026-11-18 (commit 13ec6177, par le PM) --------------------------------------------------------
      // Lecture (get ET liste : l'écouteur du Feed lit la sous-collection) : tout membre d'une Miff qui existe, SANS réciprocité de partage (D16 : tout membre
      // est prévenu ; le document ne contient aucune position). Un ex-membre, un étranger, un visiteur : refusés. 2 lectures de règles.
      // Création / ré-armement / fin : l'auteur seul (voir alertShape, alertStart, alertRearm, alertEnd). Aucune autre modification. Le créateur ne peut ni
      // créer, ni terminer, ni modifier l'alerte d'un membre.
      // Suppression : l'auteur (à tout moment : lots d'arrêt du partage, de départ, de suppression de compte ; nettoyage de son alerte terminée) ou le créateur,
      // MAIS SEULEMENT dans le lot qui retire ce membre (la fiche du membre n'existe plus après le lot : existsAfter) : le créateur ne peut pas effacer seul, en silence,
      // l'alerte d'un membre (revue de #274, M1). Coût : +1 lecture de règles pour le créateur (2 au lieu de 1) ; le lot de retrait qui supprime aussi l'alerte atteint 20 sur 20.
      match /alerts/{uid} {
        allow get, list: if miffAlive(miffId) && isMember(miffId);
        allow create: if isSelf(uid)
          && miffAlive(miffId)
          && alertShape(request.resource.data)
          && request.resource.data.seq == 1
          && alertQuotaOk(miffId, uid)
          && alertStart(request.resource.data, uid)
          && alertSharingAfter(miffId, uid);
        allow update: if isSelf(uid)
          && alertShape(request.resource.data)
          && (alertRearm(miffId, uid) || alertEnd(uid));
        allow delete: if isSelf(uid)
          || (isOwnerOneRead(miffId) && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)));
      }

      // ---- Lieux (zone de confiance / zone de danger), définis par le créateur
      match /places/{placeId} {
        allow get, list: if isMember(miffId) && miffAlive(miffId);
        allow create: if isOwner(miffId) && validPlaceCreate(placeId);
        allow update: if isOwner(miffId) && validPlaceUpdate();
        allow delete: if isOwner(miffId);
      }

      // ---- Demandes d'ajout d'un lieu (LIEU-REQ-A) — NON DÉPLOYÉ ---------------------------------------------------------------
      // Un membre NON créateur dépose une demande ; seul le créateur la transforme en lieu (règles de `places` INCHANGÉES : limite gratuite et zone
      // de danger Miff+ s'appliquent à l'acceptation comme à une création directe). Lecture : le créateur lit TOUTES les demandes de sa Miff ; le demandeur
      // lit les SIENNES (requête filtrée sur requestedBy, encore membre, Miff existante) ; les autres membres : rien. Création : emplacement
      // {uid}_{1..3} du demandeur, forme exacte (9 clés), requestedBy = soi, createdAt = heure serveur, `type` = `trusted` ou `risk` SANS condition d'abonnement du demandeur (LIEU-DANGER-REQ, point 15), créateur et non-membre exclus,
      // compteur +1 dans le même lot. Aucune modification (update interdit : on retire et on redemande). Suppression : le créateur (refuser, accepter,
      // nettoyer les demandes expirées ou d'un ex-membre : aucune contrainte sur le compteur, il est maître de sa Miff) ou le demandeur (retrait, compteur -1
      // dans le même lot ; sans condition d'appartenance : un ex-membre peut effacer sa propre demande). L'expiration à 30 jours n'est PAS contrôlée par
      // les règles (masquage côté clients, suppression au passage) ; createdAt = request.time garantit qu'une demande n'est jamais créée déjà expirée.
      match /placeRequests/{reqId} {
        allow get: if isOwnerOneRead(miffId)
          || (isOwnRequestId(reqId) && isMember(miffId) && miffAlive(miffId));
        allow list: if isOwnerOneRead(miffId)
          || (resource.data.requestedBy == request.auth.uid && isMember(miffId) && miffAlive(miffId));
        allow create: if isOwnRequestId(reqId)
          && validRequestShape(request.resource.data)
          && request.resource.data.requestedBy == request.auth.uid
          && request.time == request.resource.data.createdAt
          && isPlainMember(miffId)
          && miffAlive(miffId)
          && requestCounterMoved(miffId, reqId);
        allow update: if false;
        allow delete: if isOwnerOneRead(miffId)
          || (isOwnRequestId(reqId) && requestCounterMoved(miffId, reqId));
      }

      // ---- Compteur des demandes en attente (plafond de 10 par Miff) : lisible du créateur seul (get ; aucune règle de liste : une requête sur la
      // collection `meta` tombe dans le refus par défaut). Voir validRequestCounter. ----
      match /meta/placeRequests {
        allow get: if isOwnerOneRead(miffId);
        allow create, update: if validRequestCounter(miffId);
        allow delete: if isOwnerOneRead(miffId);
      }
    }

    // =========================================================================
    // Tout le reste : refusé.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
