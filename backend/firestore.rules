rules_version = '2';

// =============================================================================
// Miff — règles de sécurité Firestore (projet miff-3d283, europe-west9)
//
// STATUT : testées dans l'émulateur Firestore (`backend/rules-test-plan.md`,
// `npm test` dans backend/). Les règles de `main` au 2026-10-23 (commit 1017391) ont été
// déployées sur miff-3d283 depuis le poste du PM ; celles d'AUTH-B (consentements, profil exigé) et
// d'ONB-B (téléphone obligatoire, copie identique dans la fiche de membre) ne sont PAS déployées : ce fichier
// (PR « ONB-B / MIFF-0 ») est donc PLUS STRICT que ce qui tourne en production, et les apps qui écrivent un profil ou
// une fiche sans `phone` y seraient refusées. Tout déploiement suit la procédure du ticket
// docs/tickets/durcissement-regles-firestore.md (§8.2) et l'accord explicite du PM.
// Les évolutions « lieux » (R-LIEU-5, -2, -6) et « dernière position connue » (R-LIEU-POS, principe 9) sont PRÉPARÉES et NON
// déployées : aucun déploiement sans le « oui » explicite du PM (docs/dev/deploiement-regles.md).
//
// Principes :
//  1. Tout est refusé par défaut. Aucune règle ouverte, même temporaire.
//  2. Un utilisateur ne lit que les données des Miffs dont il est membre.
//  3. Le client ne peut JAMAIS écrire son statut premium (`entitlements/*` est
//     en écriture interdite ; seul le serveur / la console l'écrit).
//  4. Consentement de localisation : le statut de présence d'un membre n'existe
//     que s'il a activé le partage, et n'est lisible que par les membres qui
//     partagent eux-mêmes ET ont publié leur propre statut (réciprocité), tant que
//     la Miff existe. Révoquer = supprimer ces données.
//  5. Limites freemium appliquées par des "slots" à identifiant fixe (voir
//     data-model.md §6) : 1 Miff et 2 lieux (p1, p2) en gratuit, sans Cloud Function.
//  6. Téléphone (ONB-B) : donnée de contact obligatoire, sans vérification ni unicité. Il n'est visible de quelqu'un d'autre
//     que par la copie dans la fiche de membre (lisible des seuls membres de la Miff, sans condition de partage : décision
//     N1 du PM) ; la copie est contrainte à être celle du profil users/{uid} après le lot. Une fuite du code d'une Miff est
//     aussi une fuite des numéros de ses membres (risque assumé, data-model.md §11).
//  7. Lot d'entrée (MIFF-0) : adhésion ou création + partage activé + statut initial en UN lot atomique ; aucune règle
//     spécifique, c'est la combinaison des règles members / status / memberships (tests EN1 à EN6).
//  8. Les règles NE PEUVENT PAS faire de limitation de débit : le brute force
//     des codes et les abus de volume sont atténués par App Check (à activer
//     dans la console) + entropie du code (12 caractères, ~59 bits).
//  9. Dernière position connue (R-LIEU-POS, décision du PM du 2026-11-01) — PRÉPARÉ, NON DÉPLOYÉ : un document
//     miffs/{id}/positions/{uid} par membre et par Miff (lat, lng, measuredAt, rien d'autre, aucun historique), SÉPARÉ du
//     statut (le statut ne contient toujours aucune coordonnée). Écriture : par l'intéressé seul, partage actif ET texte de
//     consentement de version 3 ou plus (jamais de position sans ce nouveau consentement). Lecture d'un autre membre : mêmes
//     conditions que les statuts (Miff existante, partage actif, statut publié) PLUS avoir publié sa propre position
//     (réciprocité réelle, comme ATK3) ; get seulement, jamais de liste. Le créateur n'a AUCUN droit de lecture de plus. Effacée
//     dans le MÊME lot que le statut et la photo (arrêt du partage, départ, retrait) : les règles le EXIGENT.
//     L'écriture de position lit UN document (getAfter de la fiche du membre) et ne doit jamais partager un lot avec des lieux.
//
// Coût : chaque get()/exists()/getAfter()/existsAfter() dans une règle est
// facturé comme une lecture (même si la requête est refusée) et est limité à
// 10 appels par requête simple, 20 par batch/transaction. Les écritures
// multi-documents (créer une Miff, rejoindre, quitter) doivent donc rester
// des batches courts (voir data-model.md §8).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers génériques
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isNullOrStr(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Champ binaire optionnel (absent ou null accepté) borné en taille.
    function optBytes(d, k, maxSize) {
      return !(k in d) || d[k] == null || (d[k] is bytes && d[k].size() <= maxSize);
    }

    // Clés modifiées par l'écriture en cours (update uniquement).
    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Code secret : exactement 12 caractères, alphabet de 31 symboles sans
    // ambiguïté visuelle (pas de I, L, O, 0, 1) => 31^12 ~ 7,9e17 (~59 bits).
    function isJoinCode(code) {
      return code is string && code.matches('^[A-HJ-KM-NP-Z2-9]{12}$');
    }

    // Identifiant de Miff : ID auto Firestore (20 caractères alphanumériques).
    // Empêche les collisions avec les identifiants fixes 'free' et 'p1'.
    function isMiffId(id) {
      return id is string && id.matches('^[A-Za-z0-9]{20}$');
    }

    // -------------------------------------------------------------------------
    // Appartenance / rôle / premium
    // -------------------------------------------------------------------------
    // Membre = existence du document members/{uid} de la Miff (état AVANT écriture).
    function isMember(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid));
    }

    // Créateur de la Miff (ownerUid immuable).
    function isOwner(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId))
        && get(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == request.auth.uid;
    }

    // Créateur de la Miff en UNE seule lecture de règles (isOwner en coûte 2 : exists + get). Même résultat quand la Miff
    // n'existe pas : get() échoue et la requête est refusée. À n'utiliser que dans une conjonction ou une disjonction
    // POSITIVE, jamais derrière « ! ». Sert aux purges du créateur (statut, photo, position) pour que le lot de retrait d'un
    // membre reste à 18 lectures de règles sur 20 une fois la position ajoutée (data-model.md §12).
    function isOwnerOneRead(miffId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == request.auth.uid;
    }

    // Membre qui a lui-même activé le partage de position dans cette Miff.
    // (get() échoue si non-membre => refus.) Sert à la réciprocité.
    function mySharingOn(miffId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid)).data.sharing.enabled == true;
    }

    // La Miff existe encore. Les sous-collections d'une Miff supprimée ne sont pas effacées par
    // Firestore : sans ce contrôle, la fiche d'un membre survivant (isMember) garderait l'accès en
    // lecture aux lieux, membres, statuts et photos d'une Miff qui n'existe plus.
    function miffAlive(miffId) {
      return exists(/databases/$(database)/documents/miffs/$(miffId));
    }

    // Réciprocité réelle (ATK3) : avoir PUBLIÉ son propre statut dans cette Miff (le document
    // status/{moi} existe), pas seulement avoir activé le partage.
    function statusPublished(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/status/$(request.auth.uid));
    }

    // Réciprocité réelle de la position (R-LIEU-POS, même logique que ATK3) : avoir PUBLIÉ sa propre dernière position dans
    // cette Miff (le document positions/{moi} existe). Un membre qui n'en partage aucune ne lit pas celle des autres. Comme
    // ce document ne peut exister qu'avec un partage actif et le consentement de version 3 ou plus (validPosition), et
    // disparaît à l'arrêt du partage, cette condition prouve aussi que le lecteur a accepté le même texte.
    function positionPublished(miffId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/miffs/$(miffId)/positions/$(request.auth.uid));
    }

    // Retrait d'un membre (ATK4) : le code secret de la Miff CHANGE dans le même lot (l'ancien code
    // est supprimé par validMiffUpdate), sinon l'ex-membre reviendrait avec le code qu'il connaît.
    // getAfter échoue si la Miff est supprimée dans le lot => un retrait n'est pas possible dans le
    // lot qui supprime la Miff (les membres sont retirés avant, un par lot).
    function codeRenewed(miffId) {
      return getAfter(/databases/$(database)/documents/miffs/$(miffId)).data.joinCode
        != get(/databases/$(database)/documents/miffs/$(miffId)).data.joinCode;
    }

    // Premium = document entitlements/{uid} écrit UNIQUEMENT par le serveur / la
    // console, actif et non expiré (expiration vérifiée côté règles : pas besoin
    // de Cloud Function pour "éteindre" un abonnement arrivé à échéance).
    function isPremium(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.active == true
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.expiresAt > request.time;
    }

    // -------------------------------------------------------------------------
    // Validation de forme : profil, consentement
    // -------------------------------------------------------------------------
    // Nom : 1..50 caractères (la règle UX "3 caractères minimum" des maquettes
    // exclurait des prénoms réels comme "Li" ou "Jo" : voir question ouverte).
    function validProfile(d) {
      return isStr(d.firstName, 1, 50)
        && isStr(d.lastName, 1, 50)
        && optBytes(d, 'avatar', 20000);
    }

    // -------------------------------------------------------------------------
    // Téléphone (ONB-B, décision Q1 du PM) : numéro au format E.164, obligatoire à la création du profil et de la fiche de
    // membre. « + », un premier chiffre de 1 à 9, puis 6 à 14 chiffres : 7 à 15 chiffres, 8 à 16 caractères au total, aucun
    // espace ni séparateur (la mise en forme est faite par le client). Forme seulement : aucune vérification que la personne
    // possède le numéro (pas de SMS sur Spark) et aucune unicité. [+] plutôt que « \+ » : pas de caractère d'échappement.
    // -------------------------------------------------------------------------
    function isPhone(v) {
      return v is string && v.matches('^[+][1-9][0-9]{6,14}$');
    }

    // La clé phone du document résultant existe et est valide (un numéro ne se vide ni ne se supprime).
    function hasValidPhone(d) {
      return 'phone' in d && isPhone(d.phone);
    }

    // Copie du numéro dans la fiche de membre : elle doit être celle du profil users/{uid} APRÈS le lot (getAfter), donc
    // soit le profil existant, soit le profil créé ou modifié dans le même lot. C'est le même document que termsAcceptedAfter.
    // get('phone', null) évite une erreur d'évaluation quand le profil (compte antérieur à ONB-B) n'a pas de numéro : la
    // comparaison est alors simplement fausse.
    function phoneMatchesProfile(uid, phone) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.get('phone', null) == phone;
    }

    // -------------------------------------------------------------------------
    // Consentement facultatif (b) « statistiques d'usage et rapports de plantage anonymes » (AUTH-B).
    // Bloc `analyticsConsent` de users/{uid} : mêmes quatre clés que members.sharing, TOUJOURS toutes
    // présentes (null si non applicable). Absence du bloc = pas de consentement. Jamais de position.
    // -------------------------------------------------------------------------
    // Version du texte de consentement : AAAA-MM-vNN. Le zéro de tête et le format fixe rendent l'ordre
    // lexicographique identique à l'ordre chronologique (utile pour refuser une rétrogradation de version).
    function isConsentVersion(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-v[0-9]{2}$');
    }

    // Les 4 clés exactes (ni plus, ni moins).
    function hasConsentKeys(c) {
      return c is map
        && c.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && c.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt']);
    }

    // À la création du profil : soit « non consenti » (case décochée : aucune date, aucune version),
    // soit « consenti » avec l'heure du serveur (request.time) et la version du texte affiché.
    function validAnalyticsConsentCreate(c) {
      return hasConsentKeys(c)
        && c.revokedAt == null
        && (
          (c.enabled == false && c.consentedAt == null && c.consentVersion == null)
          || (c.enabled == true && c.consentedAt == request.time && isConsentVersion(c.consentVersion))
        );
    }

    // Changement ultérieur (Réglages) ; prev = ancien bloc (null si le profil n'en a pas), next = nouveau.
    //  - activer / réactiver (depuis « absent » ou « non consenti ») : heure serveur, version du texte, revokedAt vidé,
    //    et version jamais plus ancienne que la dernière enregistrée (pas de rétrogradation) ;
    //  - retirer (depuis « consenti » uniquement) : revokedAt = heure serveur, la trace du consentement
    //    (date et version) est conservée. Réécrire un consentement actif sans le retirer d'abord est refusé.
    function validAnalyticsConsentChange(prev, next) {
      return hasConsentKeys(next)
        && (
          ((prev == null || prev.enabled == false)
            && next.enabled == true
            && next.consentedAt == request.time
            && isConsentVersion(next.consentVersion)
            && next.revokedAt == null
            && (prev == null || prev.consentVersion == null || next.consentVersion >= prev.consentVersion))
          ||
          (prev != null && prev.enabled == true
            && next.enabled == false
            && next.revokedAt == request.time
            && next.consentedAt == prev.consentedAt
            && next.consentVersion == prev.consentVersion)
        );
    }

    // Texte de consentement qui couvre la DERNIÈRE POSITION CONNUE (R-LIEU-POS, décision du PM du 2026-11-01 : nouveau
    // consentement avant toute écriture de position). Les versions du partage s'écrivent AAAA-MM-vN (2026-10-v1, 2026-10-v2
    // pour les textes sans position) ; le texte « position » est la version 3 : le NUMÉRO N doit valoir 3 ou plus (zéros de tête
    // tolérés), quel que soit le mois. Hypothèse à confirmer avec les clients (le numéro 3 et le format viennent de la
    // demande du PM, pas d'un texte déjà publié) : changer ce numéro est une ligne, un test et une mutation.
    function isPositionConsentVersion(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-v0*([3-9]|[1-9][0-9]+)$');
    }

    // Consentement à la création du document membre.
    // Les 4 clés sont TOUJOURS présentes (null si non applicable).
    function validSharingCreate(s) {
      return s is map
        && s.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && s.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && s.revokedAt == null
        && (
          (s.enabled == false && s.consentedAt == null && s.consentVersion == null)
          || (s.enabled == true && s.consentedAt == request.time && isStr(s.consentVersion, 1, 20))
        );
    }

    // Changement de consentement (o = ancien, n = nouveau).
    //  - activer   : consentedAt = maintenant, version du texte acceptée, revokedAt vidé
    //  - révoquer  : revokedAt = maintenant ET statut + photo + dernière position supprimés dans le même batch
    function validSharingChange(miffId, uid, o, n) {
      return n is map
        && n.keys().hasOnly(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && n.keys().hasAll(['enabled', 'consentedAt', 'consentVersion', 'revokedAt'])
        && (
          (o.enabled == false && n.enabled == true
            && n.consentedAt == request.time
            && isStr(n.consentVersion, 1, 20)
            && n.revokedAt == null)
          ||
          (o.enabled == true && n.enabled == false
            && n.revokedAt == request.time
            && n.consentedAt == o.consentedAt
            && n.consentVersion == o.consentVersion
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/status/$(uid))
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/photos/$(uid))
            && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/positions/$(uid)))
        );
    }

    // -------------------------------------------------------------------------
    // Slot d'appartenance (limite freemium "1 Miff à la fois")
    // L'index users/{uid}/memberships/{key} doit exister APRÈS le batch et
    // pointer vers cette Miff. Sa propre règle de création impose key == 'free'
    // (un seul slot gratuit) ou key == miffId avec premium actif.
    // -------------------------------------------------------------------------
    function indexAfterOk(uid, miffId) {
      return (
        existsAfter(/databases/$(database)/documents/users/$(uid)/memberships/free)
        && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/free).data.miffId == miffId
      ) || (
        existsAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(miffId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/memberships/$(miffId)).data.miffId == miffId
      );
    }

    // Créateur : le document Miff est créé dans le même batch (n'existe pas avant).
    function ownerCreateOk(miffId, uid) {
      return !exists(/databases/$(database)/documents/miffs/$(miffId))
        && getAfter(/databases/$(database)/documents/miffs/$(miffId)).data.ownerUid == uid
        && indexAfterOk(uid, miffId);
    }

    // Rejoindre : preuve de connaissance du code secret. Le document
    // joinCodes/{code} doit exister et pointer vers CETTE Miff.
    function memberJoinOk(miffId, uid, d) {
      return isJoinCode(d.joinCode)
        && get(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId
        && exists(/databases/$(database)/documents/miffs/$(miffId))
        && indexAfterOk(uid, miffId);
    }

    // Profil (a) : pas de Miff créée ni rejointe sans un profil users/{uid} qui porte l'acceptation des CGU
    // (termsAcceptedAt, termsVersion). getAfter : le profil peut être créé dans le MÊME lot que la Miff ou l'adhésion.
    // Une seule fiche membre est créée dans les deux cas (créateur ou code), donc un seul point de contrôle ; la
    // création de la Miff exige déjà la fiche du créateur (validMiffCreate). Échoue (refus) si le profil est absent.
    function termsAcceptedAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.keys().hasAll(['termsAcceptedAt', 'termsVersion']);
    }

    function validMemberCreate(miffId, uid) {
      let d = request.resource.data;
      // Téléphone (ONB-B) : obligatoire, E.164, et identique à celui du profil users/{uid} (profil existant ou créé dans le lot).
      return d.keys().hasOnly(['role', 'firstName', 'lastName', 'avatar', 'phone', 'joinedAt', 'joinCode', 'sharing'])
        && d.keys().hasAll(['role', 'firstName', 'lastName', 'phone', 'joinedAt', 'sharing'])
        && validProfile(d)
        && hasValidPhone(d)
        && phoneMatchesProfile(uid, d.phone)
        && d.joinedAt == request.time
        && validSharingCreate(d.sharing)
        && termsAcceptedAfter(uid)
        && (
          (d.role == 'owner' && !('joinCode' in d) && ownerCreateOk(miffId, uid))
          || (d.role == 'member' && memberJoinOk(miffId, uid, d))
        );
    }

    // Un membre ne modifie que son profil (copie) et son consentement.
    // role, joinedAt, joinCode : immuables.
    // Téléphone (ONB-B) : si la copie change, elle reste valide, ne se supprime pas et est celle du profil users/{uid} APRÈS le
    // lot (mise à jour atomique profil + fiches par le client). Une fiche antérieure sans numéro reste modifiable sans lui.
    function validMemberUpdate(miffId, uid) {
      let d = request.resource.data;
      return affected().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'sharing'])
        && validProfile(d)
        && (!affected().hasAny(['phone']) || (hasValidPhone(d) && phoneMatchesProfile(uid, d.phone)))
        && (
          !affected().hasAny(['sharing'])
          || validSharingChange(miffId, uid, resource.data.sharing, d.sharing)
        );
    }

    // Quitter / être retiré : le statut, la photo et la dernière position doivent disparaître dans le
    // même batch (sinon une trace de position resterait visible d'un ex-membre).
    function memberDeleteOk(miffId, uid) {
      return isSignedIn()
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/status/$(uid))
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/photos/$(uid))
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)/positions/$(uid))
        && (
          (isSelf(uid) && resource.data.role == 'member')
          // Le créateur ne peut partir qu'en supprimant la Miff dans le même batch.
          || (isSelf(uid) && resource.data.role == 'owner'
              && !existsAfter(/databases/$(database)/documents/miffs/$(miffId)))
          // Seul le créateur retire un autre membre, ET le code de la Miff est renouvelé dans le même
          // lot (décision PM du 2026-10-22). Le départ volontaire (ci-dessus) n'impose rien.
          || (!isSelf(uid) && isOwner(miffId) && codeRenewed(miffId))
        );
    }

    // -------------------------------------------------------------------------
    // Validation de forme : Miff, code, lieux, statut, photo
    // -------------------------------------------------------------------------
    function validMiffCreate(miffId) {
      let d = request.resource.data;
      return isMiffId(miffId)
        // Pierre tombale : un identifiant de Miff supprimée n'est JAMAIS réutilisable (sinon un ancien
        // membre se déclare créateur de la Miff « ressuscitée » et relit les lieux / statuts restés en base).
        // Le contrôle est ici (sur le document Miff lui-même) et non seulement sur la fiche membre du
        // créateur : un créateur qui a gardé sa fiche membre créerait sinon la Miff sans écrire de fiche.
        && !exists(/databases/$(database)/documents/miffsDeleted/$(miffId))
        && d.keys().hasOnly(['ownerUid', 'name', 'joinCode', 'createdAt'])
        && d.keys().hasAll(['ownerUid', 'name', 'joinCode', 'createdAt'])
        && d.ownerUid == request.auth.uid
        && isStr(d.name, 1, 40)
        && isJoinCode(d.joinCode)
        && d.createdAt == request.time
        // Pas de Miff "à moitié créée" : le membre créateur existe après le batch, et le code existe après le
        // batch ET pointe vers CETTE Miff (sinon on pourrait se donner le code d'une autre Miff : getAfter
        // échoue si le document n'existe pas => refus).
        && existsAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId;
    }

    // Renommer, ou régénérer le code. Régénérer = l'ancien code DOIT disparaître
    // dans le même batch (sinon un ex-membre garderait un code valide).
    function validMiffUpdate(miffId) {
      let d = request.resource.data;
      return affected().hasOnly(['name', 'joinCode'])
        && isStr(d.name, 1, 40)
        && isJoinCode(d.joinCode)
        && (
          !affected().hasAny(['joinCode'])
          || (
            getAfter(/databases/$(database)/documents/joinCodes/$(d.joinCode)).data.miffId == miffId
            && !existsAfter(/databases/$(database)/documents/joinCodes/$(resource.data.joinCode))
          )
        );
    }

    // joinCodes/{code} : n'expose que miffId + nom (pour l'écran "Rejoindre ...").
    // Créé uniquement par le créateur, en cohérence avec le document Miff.
    function validJoinCodeCreate(code) {
      let d = request.resource.data;
      return d.keys().hasOnly(['miffId', 'miffName', 'createdAt'])
        && d.keys().hasAll(['miffId', 'miffName', 'createdAt'])
        && isMiffId(d.miffId)
        && isStr(d.miffName, 1, 40)
        && d.createdAt == request.time
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.joinCode == code
        && getAfter(/databases/$(database)/documents/miffs/$(d.miffId)).data.name == d.miffName;
    }

    // Catégorie du lieu (R-LIEU-2, décision du PM du 2026-11-01) : OBLIGATOIRE, liste fermée. Valeurs techniques (anglais,
    // stables) ; les libellés FR/EN sont côté client : home = Maison, work = Travail, school = École, sport = Sport,
    // relative = Chez un proche, leisure = Loisir, other = Autre.
    function isPlaceCategory(v) {
      return v in ['home', 'work', 'school', 'sport', 'relative', 'leisure', 'other'];
    }

    function validPlaceShape(d) {
      return d.keys().hasOnly(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'createdBy', 'createdAt', 'updatedAt'])
        && isStr(d.name, 1, 60)
        && d.type in ['trusted', 'risk']
        && isPlaceCategory(d.category)
        && isNullOrStr(d.address, 200)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.radiusM is int && d.radiusM >= 50 && d.radiusM <= 2000
        && (d.priority == null || (d.priority is int && d.priority >= 0 && d.priority <= 999));
    }

    // Premium en UNE seule lecture de règles (budget des lots multi-Miffs : data-model.md §12), contre 3 appels pour
    // isPremium. Différence : sans document entitlements/{uid}, get() échoue et la requête est refusée, ce qui est bien le
    // résultat voulu (pas de premium). À n'utiliser que dans une conjonction ou une disjonction POSITIVE, jamais derrière « ! ».
    function isPremiumOneRead(uid) {
      let e = get(/databases/$(database)/documents/entitlements/$(uid)).data;
      return e.active == true && e.expiresAt > request.time;
    }

    // Limite freemium "2 lieux" (R-LIEU-5, décision du PM du 2026-11-01) : en gratuit, SEULS les identifiants 'p1' et 'p2' et
    // le type 'trusted' sont acceptés (recréer un identifiant existant est une mise à jour, soumise à validPlaceUpdate).
    // Premium : identifiants libres et zones à risque. Un lieu rattaché à plusieurs Miffs = UN document par Miff avec le MÊME
    // identifiant (généré une fois par le client) : chaque document est évalué séparément, aucune règle ne compare les copies.
    function validPlaceCreate(placeId) {
      let d = request.resource.data;
      return placeId.matches('^[A-Za-z0-9]{1,20}$')
        && validPlaceShape(d)
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && (
          (placeId in ['p1', 'p2'] && d.type == 'trusted')
          || isPremiumOneRead(request.auth.uid)
        );
    }

    // Modifiables : nom, type (R-LIEU-6), catégorie, adresse, coordonnées, rayon, priorité. createdBy et createdAt restent
    // immuables. Le type change dans les deux sens, mais passer à 'risk' (zone de danger) exige le premium, comme à la
    // création : sinon un compte gratuit contournerait la réserve premium en créant « confiance » puis en modifiant.
    // Repasser à 'trusted' est toujours permis. Un lieu ne change jamais de Miff (le chemin du document est son identité).
    function validPlaceUpdate() {
      let d = request.resource.data;
      return affected().hasOnly(['name', 'type', 'category', 'address', 'lat', 'lng', 'radiusM', 'priority', 'updatedAt'])
        && validPlaceShape(d)
        && d.updatedAt == request.time
        && (!affected().hasAny(['type']) || d.type == 'trusted' || isPremiumOneRead(request.auth.uid));
    }

    // État courant du membre dans UNE Miff. Jamais de coordonnées brutes :
    // uniquement l'état (dans un lieu / hors lieu / zone à risque) + horodatages.
    // Toutes les clés sont toujours présentes (null si non applicable).
    function validStatus(miffId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['presence', 'placeId', 'presenceAt', 'lastUpdateAt', 'updateText', 'hasPhoto', 'batteryPct', 'locationAccess', 'escalationDueAt', 'updatedAt'])
        && d.keys().hasAll(['presence', 'placeId', 'presenceAt', 'lastUpdateAt', 'updateText', 'hasPhoto', 'batteryPct', 'locationAccess', 'escalationDueAt', 'updatedAt'])
        && d.presence in ['in_trusted', 'out', 'in_risk', 'unknown']
        && (d.placeId == null || isStr(d.placeId, 1, 40))
        // Horodatages d'événement fournis par l'appareil (utile hors-ligne),
        // bornés : pas plus de 24 h dans le passé, pas plus de 5 min dans le futur.
        && d.presenceAt is timestamp
        && d.presenceAt >= request.time - duration.value(1, 'd')
        && d.presenceAt <= request.time + duration.value(5, 'm')
        && d.lastUpdateAt is timestamp
        && d.lastUpdateAt >= request.time - duration.value(1, 'd')
        && d.lastUpdateAt <= request.time + duration.value(5, 'm')
        && isNullOrStr(d.updateText, 140)
        && d.hasPhoto is bool
        && (d.batteryPct == null || (d.batteryPct is int && d.batteryPct >= 0 && d.batteryPct <= 100))
        && d.locationAccess in ['background', 'foreground', 'denied', 'unknown']
        && (d.escalationDueAt == null
            || (d.escalationDueAt is timestamp
                && d.escalationDueAt >= request.time - duration.value(1, 'd')
                && d.escalationDueAt <= request.time + duration.value(1, 'd')))
        && d.updatedAt == request.time
        // Consentement actif APRÈS le batch (le membre peut activer le partage
        // et créer son statut dans le même batch).
        && getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing.enabled == true;
    }

    // Coordonnée valide : un nombre dans [-max, max] (NaN et l'infini échouent aux comparaisons).
    function isCoordinate(v, max) {
      return v is number && v >= -max && v <= max;
    }

    // Dernière position connue du membre dans UNE Miff (R-LIEU-POS). SEULEMENT latitude, longitude et heure de la mesure
    // (aucune précision, aucune vitesse, aucune altitude, aucun historique : le document est écrasé). Données sensibles.
    //  - lat / lng : nombres dans les plages valides (NaN et l'infini sont refusés par les comparaisons) ;
    //  - measuredAt : heure de la mesure fournie par l'appareil, bornée comme les horodatages du statut (pas plus de 24 h dans
    //    le passé, pas plus de 5 min dans le futur) ;
    //  - consentement : partage actif ET texte de version 3 ou plus APRÈS le lot (getAfter : on peut activer le partage et
    //    écrire la position dans le même lot, mais pas révoquer et écrire). UNE seule lecture de règles, aucune autre.
    // La précision des coordonnées (5 décimales, ~1 m) est un contrat du client : une règle ne peut pas la contrôler
    // proprement sur des nombres à virgule flottante.
    function validPosition(miffId, uid) {
      let d = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing;
      return d.keys().hasOnly(['lat', 'lng', 'measuredAt'])
        && d.keys().hasAll(['lat', 'lng', 'measuredAt'])
        && isCoordinate(d.lat, 90)
        && isCoordinate(d.lng, 180)
        && d.measuredAt is timestamp
        && d.measuredAt >= request.time - duration.value(1, 'd')
        && d.measuredAt <= request.time + duration.value(5, 'm')
        && s.enabled == true
        && isPositionConsentVersion(s.consentVersion);
    }

    // Photo de la dernière update (au plus une par membre et par Miff).
    function validPhoto(miffId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['jpeg', 'createdAt', 'expiresAt'])
        && d.keys().hasAll(['jpeg', 'createdAt', 'expiresAt'])
        && d.jpeg is bytes && d.jpeg.size() > 0 && d.jpeg.size() <= 150000
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        // 24 h + 1 h de marge (expiresAt vient de l'horloge du téléphone). Même durée pour tous les
        // comptes, premium ou non : aucune règle de photo ne dépend de l'abonnement.
        && d.expiresAt <= request.time + duration.value(25, 'h')
        && getAfter(/databases/$(database)/documents/miffs/$(miffId)/members/$(uid)).data.sharing.enabled == true;
    }

    // =========================================================================
    // users/{uid} — profil privé (lisible uniquement par son propriétaire)
    // Les autres membres voient une COPIE du profil dans miffs/*/members/*.
    // =========================================================================
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      // Création = (a) acceptation des CGU et de la politique (obligatoire : sans elle, pas de profil ;
      // heure serveur + version du texte) + (b) consentement facultatif aux statistiques (bloc facultatif :
      // absent = pas de consentement ; sinon voir validAnalyticsConsentCreate). Aucune date de naissance,
      // aucun âge, aucun e-mail : toute autre clé est refusée.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'createdAt', 'termsAcceptedAt', 'termsVersion', 'analyticsConsent'])
        && request.resource.data.keys().hasAll(['firstName', 'lastName', 'phone', 'createdAt', 'termsAcceptedAt', 'termsVersion'])
        && validProfile(request.resource.data)
        && hasValidPhone(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.termsAcceptedAt == request.time
        && isStr(request.resource.data.termsVersion, 1, 20)
        && (!('analyticsConsent' in request.resource.data)
            || validAnalyticsConsentCreate(request.resource.data.analyticsConsent));

      // Mise à jour par le propriétaire : profil et consentement (b) seulement. termsAcceptedAt, termsVersion
      // (a) et createdAt sont figés à la création (décision PM : (a) non modifiable). Le consentement (b) ne
      // change que par une transition valide (activer, retirer, réactiver) ; supprimer le bloc est refusé.
      allow update: if isSelf(uid)
        && affected().hasOnly(['firstName', 'lastName', 'avatar', 'phone', 'analyticsConsent'])
        && validProfile(request.resource.data)
        && (!affected().hasAny(['phone']) || hasValidPhone(request.resource.data))
        && isStr(request.resource.data.termsVersion, 1, 20)
        && (!affected().hasAny(['analyticsConsent'])
            || validAnalyticsConsentChange(resource.data.get('analyticsConsent', null), request.resource.data.analyticsConsent));

      // Suppression de compte : le client supprime ses données puis son compte Auth.
      allow delete: if isSelf(uid);

      // ---- Index des appartenances (liste "mes Miffs" + slot freemium) -------
      // Clé 'free' = slot gratuit (1 seul possible) ; clé = miffId = premium.
      match /memberships/{key} {
        allow get, list: if isSelf(uid);

        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['miffId', 'joinedAt'])
          && request.resource.data.keys().hasAll(['miffId', 'joinedAt'])
          && isMiffId(request.resource.data.miffId)
          && request.resource.data.joinedAt == request.time
          && (
            key == 'free'
            || (key == request.resource.data.miffId && isPremium(uid))
          )
          // Le document membre correspondant est créé dans le même batch.
          && existsAfter(/databases/$(database)/documents/miffs/$(request.resource.data.miffId)/members/$(uid));

        // Immuable : empêche de "recycler" un slot vers une autre Miff.
        allow update: if false;

        // Libérer le slot n'est possible que si on n'est plus membre (sinon : 2 Miffs gratuites).
        allow delete: if isSelf(uid)
          && !existsAfter(/databases/$(database)/documents/miffs/$(resource.data.miffId)/members/$(uid));
      }

      // ---- Jetons FCM (à n'utiliser qu'avec le push, donc Blaze) ------------
      match /devices/{deviceId} {
        allow get, list: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'platform', 'updatedAt'])
          && isStr(request.resource.data.token, 1, 512)
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.updatedAt == request.time
          && deviceId.matches('^[A-Za-z0-9_-]{1,64}$');
        allow delete: if isSelf(uid);
      }
    }

    // =========================================================================
    // entitlements/{uid} — statut premium. LECTURE seule pour le propriétaire.
    // Écrit uniquement par le serveur (Admin SDK) ou manuellement par le PM
    // dans la console. Le client ne peut JAMAIS s'attribuer le premium.
    // =========================================================================
    match /entitlements/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow write: if false;
    }

    // =========================================================================
    // joinCodes/{code} — résolution du code secret (12 caractères).
    // PAS de `list` : impossible d'énumérer les codes. `get` exige de
    // connaître le code complet. Brute force : voir data-model.md §5.
    // =========================================================================
    match /joinCodes/{code} {
      allow get: if isSignedIn() && isJoinCode(code);
      allow list: if false;

      allow create: if isSignedIn()
        && isJoinCode(code)
        && validJoinCodeCreate(code);

      // Seul le nom affiché peut changer (renommage de la Miff).
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.ownerUid == request.auth.uid
        && affected().hasOnly(['miffName'])
        && isStr(request.resource.data.miffName, 1, 40)
        && getAfter(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.name == request.resource.data.miffName;

      // À supprimer dans le même batch (ou AVANT) que la Miff : après sa
      // suppression, le propriétaire ne serait plus vérifiable.
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/miffs/$(resource.data.miffId)).data.ownerUid == request.auth.uid;
    }

    // =========================================================================
    // miffsDeleted/{miffId} — pierre tombale d'une Miff supprimée (ATK1).
    // Aucune donnée personnelle : seulement la date. Créée par le créateur dans
    // le lot qui supprime la Miff ; jamais lisible, modifiable ni supprimable par
    // un client (les règles de création de Miff la lisent via exists()).
    // =========================================================================
    match /miffsDeleted/{miffId} {
      allow read: if false;
      // isOwner lit l'état d'AVANT le lot (la Miff existe encore) ; existsAfter exige qu'elle disparaisse.
      allow create: if isOwner(miffId)
        && !existsAfter(/databases/$(database)/documents/miffs/$(miffId))
        && request.resource.data.keys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt == request.time;
      allow update, delete: if false;
    }

    // =========================================================================
    // miffs/{miffId} — le cercle de confiance
    // =========================================================================
    match /miffs/{miffId} {
      allow get: if isMember(miffId);
      allow list: if false;           // on arrive toujours par un identifiant connu

      allow create: if isSignedIn() && validMiffCreate(miffId);
      // ATTENTION : ce contrôle du propriétaire est aussi la barrière du RETRAIT d'un membre (seul le
      // propriétaire peut changer joinCode, ce que memberDeleteOk exige via codeRenewed). Si cette règle
      // est assouplie, le retrait perd sa barrière (mutation M17-retrait-controle-proprietaire-seul,
      // aujourd'hui équivalente, cesserait de l'être).
      allow update: if isOwner(miffId) && validMiffUpdate(miffId);
      // Suppression : dans le MÊME lot, (1) la pierre tombale miffsDeleted/{id} est créée (l'identifiant
      // ne pourra plus servir) et (2) le code secret joinCodes/{joinCode} est supprimé (aucun code orphelin
      // qui rouvrirait l'accès si la Miff revenait). resource.data.joinCode est lu sur le document supprimé.
      allow delete: if isOwner(miffId)
        && existsAfter(/databases/$(database)/documents/miffsDeleted/$(miffId))
        && !existsAfter(/databases/$(database)/documents/joinCodes/$(resource.data.joinCode));

      // ---- Membres : profil (copie), rôle, consentement --------------------
      match /members/{uid} {
        allow get, list: if isMember(miffId) && miffAlive(miffId);
        allow create: if isSelf(uid) && validMemberCreate(miffId, uid);
        allow update: if isSelf(uid) && validMemberUpdate(miffId, uid);
        allow delete: if memberDeleteOk(miffId, uid);
      }

      // ---- État courant (sensible) : seulement si le partage est activé ----
      // Lecture : réciprocité => il faut partager soi-même (partage activé ET statut publié) pour voir
      // les autres, et la Miff doit exister. Activer le partage = créer son statut dans le même lot.
      match /status/{uid} {
        allow get, list: if miffAlive(miffId) && mySharingOn(miffId) && statusPublished(miffId);
        allow create, update: if isSelf(uid) && validStatus(miffId, uid);
        // Le propriétaire de la Miff peut purger (retrait d'un membre).
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId);
      }

      // ---- Dernière position connue (très sensible, R-LIEU-POS) --------------
      // Lecture : get seulement (un membre à la fois, bouton « Localiser » ; jamais de liste). Soi-même : toujours (transparence,
      // « voir ce que je partage »). Un autre membre : Miff existante, partage actif, statut publié (comme les statuts) ET sa
      // propre position publiée (réciprocité réelle). Le créateur n'a aucun droit de lecture de plus. L'affichage masqué après
      // 24 h est une décision d'AFFICHAGE du client (la date reste affichée) : les règles ne l'appliquent pas, voir data-model.md.
      // Écriture : par soi seul (validPosition). Suppression : soi, ou le créateur dans le lot de retrait d'un membre.
      match /positions/{uid} {
        allow get: if isSelf(uid)
          || (miffAlive(miffId) && mySharingOn(miffId) && statusPublished(miffId) && positionPublished(miffId));
        allow list: if false;
        allow create, update: if isSelf(uid) && validPosition(miffId, uid);
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId);
      }

      // ---- Photo de la dernière update (sensible) ---------------------------
      // Lecture : partage activé (PAS de condition de statut publié pour les photos : décision PM du
      // 2026-10-22), Miff existante, et photo non expirée (expiresAt est appliqué par les règles : aucun
      // nettoyage n'est nécessaire pour qu'elle disparaisse). Photo absente : introuvable, pas une erreur.
      // Suppression : l'auteur, le créateur, ou n'importe quel membre une fois la photo expirée.
      match /photos/{uid} {
        allow get: if miffAlive(miffId) && mySharingOn(miffId)
          && (resource == null || resource.data.expiresAt > request.time);
        allow list: if false;
        allow create, update: if isSelf(uid) && validPhoto(miffId, uid);
        allow delete: if isSelf(uid) || isOwnerOneRead(miffId)
          || (isMember(miffId) && resource.data.expiresAt <= request.time);
      }

      // ---- Lieux (zone de confiance / zone à risque), définis par le créateur
      match /places/{placeId} {
        allow get, list: if isMember(miffId) && miffAlive(miffId);
        allow create: if isOwner(miffId) && validPlaceCreate(placeId);
        allow update: if isOwner(miffId) && validPlaceUpdate();
        allow delete: if isOwner(miffId);
      }
    }

    // =========================================================================
    // Tout le reste : refusé.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
