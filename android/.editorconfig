root = false

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
ktlint_code_style = ktlint_official
# Jetpack Compose: composable functions are PascalCase, like classes.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_function-expression-body = disabled

[*.{xml,toml,properties,md}]
indent_style = space
indent_size = 4
insert_final_newline = true

[*.{xml,toml}]
indent_size = 4
