<?xml version="1.0" encoding="utf-8"?>
<!--
    ENGLISH strings = unqualified resources = fallback language (see res/resources.properties).
    French (source language of the product copy) lives in values-fr/strings.xml. Keys are shared with iOS:
    snake_case with a feature prefix; platform-only keys are prefixed android_.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="android_app_name" translatable="false">Miff</string>

    <!-- Welcome screen -->
    <string name="home_tagline">Know your loved ones are fine, without bothering them.</string>
    <!-- Kept for the iOS/Android key parity (docs/contracts/i18n-keys.md): the Android welcome screen shows the wordmark instead. Remove on both platforms together. -->
    <string name="home_title" tools:ignore="UnusedResources">Miff</string>
    <string name="home_logo_a11y">Miff logo</string>

    <!-- Diagnostic screen: header and build identity -->
    <string name="diag_title">Internal diagnostic</string>
    <string name="diag_subtitle">Internal screen, test builds only. Nothing here is shown to the public.</string>
    <string name="diag_open_home">Open the app</string>
    <string name="diag_build_title">Build</string>
    <string name="diag_build_version">Version: %1$s (build %2$d)</string>
    <string name="diag_build_type">Configuration: %1$s</string>
    <string name="diag_build_app_id">Application: %1$s</string>
    <string name="diag_build_android">Android %1$s (API %2$d)</string>
    <string name="diag_build_language">Language: %1$s</string>
    <string name="diag_build_direction">Text direction: %1$s</string>
    <string name="diag_direction_ltr">left to right</string>
    <string name="diag_direction_rtl">right to left</string>
    <string name="diag_build_project">Firebase project: %1$s</string>
    <string name="diag_project_ok">This is the expected Miff project.</string>
    <string name="diag_project_warning">Unexpected project (expected: %1$s). Please stop here and tell the team.</string>
    <string name="diag_project_unknown">Project not identified. Please tell the team.</string>

    <!-- Test 1 -->
    <string name="diag_test1_title">Test 1 · Reading without signing in</string>
    <string name="diag_test1_description">Tries to read a Miff without being signed in. The expected answer is a refusal. If you were signed in, you are signed out first.</string>
    <string name="diag_test1_action">Run test 1</string>
    <string name="diag_test1_running">Test in progress…</string>
    <string name="diag_test1_ok">Rules active: OK</string>
    <string name="diag_test1_ok_detail">The server refused the read without sign-in, as expected.</string>
    <string name="diag_test1_open">Warning: the read worked without signing in. The rules look open. Please do not continue and tell the team.</string>
    <string name="diag_test1_offline">No connection for now. Try again when the network is back.</string>
    <string name="diag_test1_inconclusive">The test could not be completed this time. Try again a bit later.</string>

    <!-- Test 2 -->
    <string name="diag_test2_title">Test 2 · Reading with a test account</string>
    <string name="diag_test2_description">Signs in with the test account created in the Firebase console, reads your profile and plan documents, then signs out. Nothing is written. The details are typed here only: they are never stored.</string>
    <string name="diag_test2_email_label">Test account e-mail</string>
    <string name="diag_test2_password_label">Password</string>
    <string name="diag_test2_action">Sign in and read</string>
    <string name="diag_test2_running">Test in progress…</string>
    <string name="diag_test2_success">Test 2: OK</string>
    <string name="diag_test2_profile_found">Profile: found</string>
    <string name="diag_test2_profile_missing">No profile yet</string>
    <string name="diag_test2_offer_classic">Plan: Classic</string>
    <string name="diag_test2_offer_premium">Plan: Premium until %1$s</string>
    <string name="diag_test2_read_denied">Signed in, but the rules refused the read of your own documents. Please tell the team.</string>
    <string name="diag_test2_read_failed">Signed in, but reading the documents did not work this time. Try again a bit later.</string>
    <string name="diag_signin_invalid">We could not sign in with these details. Please check them and try again.</string>
    <string name="diag_signin_network">No connection for now. Try again when the network is back.</string>
    <string name="diag_signin_too_many">Too many attempts for now. Please wait a few minutes.</string>
    <string name="diag_signin_disabled">This test account is turned off.</string>
    <string name="diag_signin_unknown">Sign-in did not work this time. Try again a bit later.</string>
