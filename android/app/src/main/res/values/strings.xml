    <string name="diag_input_email_invalid">This e-mail address does not look right.</string>
    <string name="diag_input_password_empty">Please enter the password.</string>
    <string name="diag_input_too_long">This entry is too long.</string>

    <!-- App Check -->
    <string name="diag_appcheck_title">App Check</string>
    <string name="diag_appcheck_description">Checks that the app can get an App Check token. It is not enforced yet: a missing token blocks nothing.</string>
    <string name="diag_appcheck_action">Check</string>
    <string name="diag_appcheck_running">Check in progress…</string>
    <string name="diag_appcheck_ok">Token obtained</string>
    <string name="diag_appcheck_none">No token for now. No impact yet, App Check is not enforced. In test builds, the debug token shown in Logcat can be registered in the Firebase console.</string>

