    "ios_about_licenses_binary_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository dieses Pakets veröffentlicht diesen Text. Die ausgelieferte Binärdatei kann außerdem den Nutzungsbedingungen von Google unterliegen, die wir nicht geprüft haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository of this package publishes this text. The shipped binary may also fall under Google terms of service, which we have not reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio de este paquete publica este texto. El binario entregado también puede estar sujeto a las condiciones de servicio de Google, que no hemos revisado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt de ce paquet publie ce texte. Le binaire livré peut aussi relever des conditions de service de Google, que nous n'avons pas relues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository di questo pacchetto pubblica questo testo. Il binario fornito può dipendere anche dalle condizioni di servizio di Google, che non abbiamo riletto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório deste pacote publica este texto. O binário fornecido pode também estar sujeito aos termos de serviço da Google, que não revimos."
          }
        }
      }
    },
    "ios_account_apple": {
