    "settings_delete_signin_again": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung wurde beendet, bevor das Löschen deines Kontos abgeschlossen war. Melde dich mit demselben Konto wieder an, dann schließen wir es ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session closed before the deletion of your account was finished. Sign in again with the same account and we’ll finish it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cerrado tu sesión antes de que terminara la eliminación de tu cuenta. Vuelve a iniciar sesión con la misma cuenta: la terminamos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta session s’est fermée avant la fin de la suppression de ton compte. Reconnecte-toi avec le même compte : on la termine."
