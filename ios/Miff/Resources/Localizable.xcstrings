          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera do teu consentimento"
          }
        }
      }
    },
    "miff_waiting_feed_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff aktualisiert deinen Status für „%1$@“ nicht mehr, bis du zugestimmt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no longer updates your status with \"%1$@\" until you agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ya no actualiza tu estado con «%1$@» hasta que des tu consentimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ne met plus à jour ton statut avec « %1$@ » tant que tu n'as pas donné ton accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff non aggiorna più il tuo stato con «%1$@» finché non dai il tuo consenso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff já não atualiza o teu estado com «%1$@» enquanto não deres o teu consentimento."
          }
        }
      }
    },
    "miff_waiting_feed_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst hier wieder den Status deiner Liebsten, sobald du zugestimmt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see your loved ones' statuses here again once you've agreed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volverás a ver aquí los estados de tus seres queridos en cuanto des tu consentimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu verras de nouveau les statuts de tes proches ici dès que tu auras donné ton accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedrai di nuovo qui gli stati dei tuoi cari non appena avrai dato il tuo consenso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltarás a ver aqui o estado dos teus entes queridos assim que deres o teu consentimento."
          }
        }
      }
    },
    "miff_waiting_miff_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff aktualisiert deinen Status für diese Miff nicht mehr, bis du zugestimmt hast. Dein letzter Status bleibt für ihre Mitglieder sichtbar, bis du das Teilen beendest. Du kannst sie auch verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no longer updates your status with this Miff until you agree. Your last status stays visible to its members until you stop sharing. You can also leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ya no actualiza tu estado con esta Miff hasta que des tu consentimiento. Tu último estado sigue siendo visible para sus miembros hasta que dejes de compartir. También puedes salir de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ne met plus à jour ton statut avec cette Miff tant que tu n'as pas donné ton accord. Ton dernier statut reste visible de ses membres jusqu'à ce que tu arrêtes de partager. Tu peux aussi la quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff non aggiorna più il tuo stato con questa Miff finché non dai il tuo consenso. Il tuo ultimo stato resta visibile ai suoi membri finché non smetti di condividere. Puoi anche lasciarla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff já não atualiza o teu estado com esta Miff enquanto não deres o teu consentimento. O teu último estado continua visível para os membros até deixares de partilhar. Também podes sair desta Miff."
          }
        }
      }
    },
