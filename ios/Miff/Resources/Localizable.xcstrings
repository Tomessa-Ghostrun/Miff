    "update_retry_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich mit einem Foto melden, sobald die Kamera erlaubt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be able to share news with a photo as soon as the camera is allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás dar noticias con una foto en cuanto se permita la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras donner de tes nouvelles en photo dès que la caméra sera autorisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai dare notizie con una foto appena la fotocamera sarà consentita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vais poder dar notícias com uma foto assim que a câmara estiver autorizada."
          }
        }
      }
    },
    "update_disabled_title": {
