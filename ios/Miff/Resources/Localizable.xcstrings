      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail address"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse e-mail"
          }
        }
      }
    },
    "auth_error_account_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is not available for now. If you need help, write to us at %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'est pas disponible pour le moment. Si tu as besoin d'aide, écris-nous à %1$@."
          }
        }
      }
    },
    "auth_error_email_format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This e-mail address doesn't look right."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail ne semble pas correcte."
          }
        }
      }
    },
    "auth_error_email_in_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account already exists with this address. You can sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cette adresse. Tu peux te connecter."
          }
        }
      }
    },
    "auth_error_invalid_credentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination does not work. Check your e-mail address and your password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison ne fonctionne pas. Vérifie ton adresse e-mail et ton mot de passe."
          }
        }
      }
    },
    "auth_error_network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection for now. Try again as soon as you have a network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion pour le moment. Réessaie dès que tu as du réseau."
          }
        }
      }
    },
    "auth_error_other_method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account already exists with this address, using another way to sign in. Try the other option."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cette adresse, avec un autre mode de connexion. Essaie l'autre option."
          }
        }
      }
    },
    "auth_error_password_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 characters minimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 caractères minimum."
          }
        }
      }
    },
    "auth_error_too_many": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few too many attempts for now. Please wait a few minutes before trying again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu trop d'essais pour le moment. Patiente quelques minutes avant de réessayer."
