    "ios_permission_location_upgrade_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To let your Miff know even when the app is closed, Miff needs the \"Always\" option."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour te signaler à ta Miff même quand l'app est fermée, Miff a besoin de l'option « Toujours »."
          }
