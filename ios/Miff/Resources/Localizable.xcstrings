    "ios_permission_location_settings_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Entscheidung jederzeit in den Einstellungen deines iPhones ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this choice at any time in your iPhone's Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás cambiar esta elección en cualquier momento en los ajustes de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras changer ce choix à tout moment dans les Réglages de ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai cambiare questa scelta in qualsiasi momento nelle Impostazioni del tuo iPhone."
