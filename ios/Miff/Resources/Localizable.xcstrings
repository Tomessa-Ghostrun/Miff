    "settings_privacy_withdrawal_not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Statistiken sind auf diesem Telefon ausgeschaltet, auch nach einem Neustart. Deine Auswahl wird gespeichert, sobald die Verbindung wieder da ist; du kannst auch auf „Auswahl speichern“ tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is switched off on this phone, even after a restart. Your choice will be saved as soon as the connection is back; you can also tap “Save my choice”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está desactivado en este teléfono, incluso después de reiniciarlo. Tu elección se guardará en cuanto vuelva la conexión; también puedes tocar «Guardar mi elección»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est coupé sur ce téléphone, même après un redémarrage. Ton choix sera enregistré dès que la connexion revient ; tu peux aussi toucher « Enregistrer mon choix »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disattivato su questo telefono, anche dopo un riavvio. La tua scelta verrà registrata appena la connessione torna; puoi anche toccare «Salva la scelta»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está desativado neste telemóvel, mesmo depois de o reiniciares. A tua escolha será guardada assim que a ligação voltar; também podes tocar em «Guardar a minha escolha»."
          }
        }
      }
    },
