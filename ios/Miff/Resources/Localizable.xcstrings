            "state": "translated",
            "value": "El formulario se abre en tu navegador, en un sitio externo a Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formulaire s'ouvre dans ton navigateur, sur un site extérieur à Miff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modulo si apre nel tuo browser, su un sito esterno a Miff."
