      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No worries, your account was not created. You can create it whenever you like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de souci, ton compte n'a pas été créé. Tu pourras le créer quand tu veux."
