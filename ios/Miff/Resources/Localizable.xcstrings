    "miff_consent3_places_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vertrauten Orte dieser Miff werden von der Person festgelegt, die sie erstellt hat, und sind für alle Mitglieder sichtbar, einschließlich der Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trusted places of this Miff are chosen by its creator and visible to all its members, address included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lugares de confianza de esta Miff los elige quien la creó y son visibles para todos sus miembros, con su dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux de confiance de cette Miff sont choisis par son créateur et visibles de tous ses membres, adresse comprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I luoghi di fiducia di questa Miff sono scelti da chi l’ha creata e visibili a tutti i suoi membri, indirizzo compreso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os locais de confiança desta Miff são escolhidos por quem a criou e visíveis para todos os seus membros, morada incluída."
          }
        }
      }
    },
    "miff_consent3_system_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon fragt dich separat nach dem Zugriff auf deinen Standort. Miff braucht die Option „Immer“, um zu funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone will ask separately for access to your location. Miff needs the \"Always\" option to work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono te pedirá por separado el acceso a tu ubicación. Miff necesita la opción «Siempre» para funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone te demandera séparément l'accès à ta position. Miff a besoin de l'option « Toujours » pour fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo telefono ti chiederà separatamente l’accesso alla tua posizione. Miff ha bisogno dell’opzione «Sempre» per funzionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu telemóvel vai pedir-te separadamente o acesso à tua localização. A Miff precisa da opção «Sempre» para funcionar."
          }
        }
      }
    },
    "miff_renewal_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Hinweis dazu, was du teilst"
          }
        },
        "en": {
