    "diag_event_location_refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused, as expected: an event with a position is never sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
