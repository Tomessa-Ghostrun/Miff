    "update_unavailable_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist gerade nicht verfügbar. Schließe andere Apps, die sie nutzen, und versuch es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't available right now. Close any other app using it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible por ahora. Cierra las demás aplicaciones que la usen e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra n'est pas disponible pour le moment. Ferme les autres applications qui l'utilisent, puis réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile al momento. Chiudi le altre app che la usano, poi riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara não está disponível de momento. Fecha as outras apps que a estejam a usar e tenta novamente."
          }
        }
      }
    },
    "update_action_retry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nochmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
