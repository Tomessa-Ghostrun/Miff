    "settings_privacy_analytics_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten helfen uns, Probleme in der App zu beheben. Dein Standort ist darin niemals enthalten. Du kannst es dir jederzeit anders überlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They help us fix the app. They never contain your location. You can change your mind at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos ayudan a arreglar la app. Nunca contienen tu ubicación. Puedes cambiar de opinión en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils nous aident à réparer l'app. Ils ne contiennent jamais ta position. Tu peux changer d'avis à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci aiutano a sistemare l’app. Non contengono mai la tua posizione. Puoi cambiare idea in qualsiasi momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajudam-nos a corrigir a app. Nunca contêm a tua localização. Podes mudar de ideias a qualquer momento."
          }
        }
      }
    },
