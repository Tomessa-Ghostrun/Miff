    "alert_not_emergency_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ist kein Notdienst. Bei unmittelbarer Gefahr ruf die Notdienste an (in Europa die 112)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff is not an emergency service. If you're in immediate danger, call the emergency services (112 in Europe)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no es un servicio de emergencias. En caso de peligro inmediato, llama a los servicios de emergencias (el 112 en Europa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff n'est pas un service d'urgence. En cas de danger immédiat, appelle les secours (le 112 en Europe)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff non è un servizio di emergenza. In caso di pericolo immediato, chiama i soccorsi (il 112 in Europa)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff não é um serviço de emergência. Em caso de perigo imediato, liga para os serviços de emergência (o 112 na Europa)."
          }
        }
      }
    },
    "alert_delivery_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Liebsten sehen deine Warnung in Miff und werden benachrichtigt, wenn sie Benachrichtigungen aktiviert haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your circle will see your alert in Miff and get a notification if they've turned notifications on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus seres queridos verán tu alerta en Miff y recibirán una notificación si tienen las notificaciones activadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes proches verront ton alerte dans Miff et seront notifiés s'ils ont activé les notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi cari vedranno la tua allerta in Miff e riceveranno una notifica se hanno attivato le notifiche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus entes queridos vão ver o teu alerta na Miff e serão notificados se tiverem ativado as notificações."
          }
        }
      }
    },
