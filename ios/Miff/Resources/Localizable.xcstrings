    "settings_delete_progress_long": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann ein paar Minuten dauern, wenn deine Miff viele Mitglieder hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a few minutes if your Miff has many members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede tardar unos minutos si tu Miff tiene muchos seres queridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça peut prendre quelques minutes si ta Miff compte beaucoup de proches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può volerci qualche minuto se nella tua Miff ci sono molte persone care."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode demorar alguns minutos se a tua Miff tiver muitos entes queridos."
          }
        }
      }
    },
    "settings_delete_miffs_blocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Löschens ist eine Miff hinzugekommen, deshalb wurde dein Konto nicht gelöscht. Du kannst das Löschen jederzeit über Einstellungen > Mein Konto neu starten. Eine Frage? Schreib uns: %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff appeared during the deletion, so your account was not deleted. You can start the deletion again from Settings > My account whenever you like. Any question? Write to us: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha aparecido una Miff durante la eliminación, así que tu cuenta no se ha eliminado. Puedes volver a iniciar la eliminación desde Ajustes > Mi cuenta cuando quieras. ¿Alguna duda? Escríbenos: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Miff est apparue pendant la suppression : ton compte n’a donc pas été supprimé. Tu peux relancer la suppression depuis Réglages > Mon compte quand tu veux. Une question ? Écris-nous : %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È comparsa una Miff durante l’eliminazione, quindi il tuo account non è stato eliminato. Puoi riavviare l’eliminazione da Impostazioni > Il mio account quando vuoi. Hai una domanda? Scrivici: %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apareceu uma Miff durante a eliminação, por isso a tua conta não foi eliminada. Podes voltar a iniciar a eliminação em Definições > A minha conta quando quiseres. Alguma dúvida? Escreve-nos: %1$@."
          }
        }
      }
    },
