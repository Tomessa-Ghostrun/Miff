    "paywall_error_calm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte diesmal nicht abgeschlossen werden. Falls eine Zahlung erfolgt ist, erscheint dein Abonnement automatisch; andernfalls versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't complete the purchase this time. If a payment went through, your subscription will show up automatically; otherwise, try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar la compra esta vez. Si se ha realizado un pago, tu suscripción aparecerá automáticamente; si no, inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas pu être finalisé cette fois. Si un paiement a été effectué, ton abonnement apparaîtra automatiquement ; sinon, réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa volta non è stato possibile completare l’acquisto. Se il pagamento è stato effettuato, il tuo abbonamento comparirà automaticamente; altrimenti riprova tra un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desta vez não foi possível concluir a compra. Se o pagamento foi efetuado, a tua subscrição aparecerá automaticamente; caso contrário, tenta novamente daqui a pouco."
          }
        }
      }
    },
