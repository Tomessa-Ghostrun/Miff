    "ios_permission_location_approximate_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff braucht deinen genauen Standort, nicht nur ein ungefähres Gebiet, um zu erkennen, wann du an deinen Orten ankommst oder sie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs your exact location, not an approximate area, to know when you arrive at or leave your places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff necesita tu ubicación exacta, y no una zona aproximada, para saber cuándo llegas a tus lugares o sales de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin de ta position exacte, et non d'une zone approximative, pour savoir quand tu arrives ou pars de tes lieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha bisogno della tua posizione precisa, e non di una zona approssimativa, per sapere quando arrivi nei tuoi luoghi o ne esci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff precisa da tua localização precisa, e não de uma zona aproximada, para saber quando chegas aos teus locais ou sais deles."
          }
        }
      }
    },
