        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu trop d'essais pour le moment. Patiente quelques minutes ou réinitialise ton mot de passe."
          }
        }
      }
    },
    "auth_error_too_many_requests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few too many requests for now. Please wait a few minutes before trying again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu trop de demandes pour le moment. Patiente quelques minutes avant de réessayer."
