    "ios_settings_delete_not_erased": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bleibt: Die Statistiken, die mit deiner Zustimmung bereits gesendet wurden, enthalten weder deinen Namen noch dein Konto und folgen der Aufbewahrungsdauer der Datenschutzerklärung; die Kopien deiner Karte auf den Telefonen der anderen Mitglieder verschwinden bei deren nächster Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What remains: statistics already sent with your consent contain neither your name nor your account and follow the retention period of the privacy policy; copies of your card kept on other members’ phones disappear the next time they connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que permanece: las estadísticas ya enviadas con tu consentimiento no contienen ni tu nombre ni tu cuenta y siguen el plazo de conservación de la política de privacidad; las copias de tu tarjeta guardadas en el teléfono de los demás miembros desaparecen la próxima vez que se conecten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste : les statistiques déjà envoyées avec ton accord ne contiennent ni ton nom ni ton compte et suivent la durée de conservation de la politique de confidentialité ; les copies de ta fiche gardées sur le téléphone des autres membres disparaissent à leur prochaine connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa resta: le statistiche già inviate con il tuo consenso non contengono né il tuo nome né il tuo account e seguono il periodo di conservazione dell’informativa sulla privacy; le copie della tua scheda conservate sul telefono degli altri membri scompaiono alla loro prossima connessione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que permanece: as estatísticas já enviadas com o teu consentimento não contêm o teu nome nem a tua conta e seguem o prazo de conservação previsto na política de privacidade; as cópias do teu cartão guardadas no telemóvel dos outros membros desaparecem quando se voltarem a ligar."
          }
        }
      }
    },
    "ios_settings_delete_miffs_blocked_more": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Miffs, die du bei diesem Versuch bereits verlassen oder gelöscht hast, bleiben verlassen bzw. gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Miffs you had already left or deleted during this attempt stay that way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Miffs de las que ya habías salido o que habías eliminado durante este intento siguen así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Miffs que tu avais déjà quittées ou supprimées pendant cette tentative le restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Miff che avevi già lasciato o eliminato durante questo tentativo restano tali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Miffs de que já tinhas saído ou que já tinhas eliminado durante esta tentativa continuam nesse estado."
          }
        }
      }
    },
    "ios_settings_delete_reauth_apple": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bittet dich, das zu bestätigen. Danach versuchen wir, die Berechtigung „Mit Apple anmelden“ von deiner Apple-ID zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple will ask you to confirm. We’ll then try to remove the “Sign in with Apple” authorization from your Apple account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple te pedirá que confirmes. Después intentaremos retirar la autorización «Iniciar sesión con Apple» de tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple va te demander de confirmer. On essaiera ensuite de retirer l’autorisation « Se connecter avec Apple » de ton compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ti chiederà di confermare. Poi proveremo a revocare l’autorizzazione «Accedi con Apple» dal tuo account Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple vai pedir-te que confirmes. Depois, vamos tentar retirar a autorização «Iniciar sessão com a Apple» da tua conta Apple."
          }
        }
      }
    },
    "ios_settings_delete_apple_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Berechtigung „Mit Apple anmelden“ nicht automatisch entfernen. Du kannst das in den Einstellungen deiner Apple-ID tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t remove the “Sign in with Apple” authorization automatically. You can do it in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido retirar la autorización «Iniciar sesión con Apple» automáticamente. Puedes hacerlo en los ajustes de tu ID de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On n’a pas pu retirer l’autorisation « Se connecter avec Apple » automatiquement. Tu peux le faire dans les réglages de ton identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile revocare automaticamente l’autorizzazione «Accedi con Apple». Puoi farlo nelle impostazioni del tuo ID Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos retirar automaticamente a autorização «Iniciar sessão com a Apple». Podes fazê-lo nas definições do teu ID Apple."
          }
        }
      }
    },
    "ios_settings_delete_entry_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine Seite, die erklärt, was gelöscht wird. Es wird noch nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a page that explains what will be deleted. Nothing is deleted yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una página que explica lo que se eliminará. Todavía no se elimina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une page qui explique ce qui sera supprimé. Rien n’est supprimé tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una pagina che spiega cosa verrà eliminato. Per ora non viene eliminato nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma página que explica o que será eliminado. Nada é eliminado de imediato."
          }
        }
      }
