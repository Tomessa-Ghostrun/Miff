    "settings_delete_sub_body_play": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dein Konto löschst, wird dein Miff+-Abonnement nicht gekündigt. Damit nichts mehr abgebucht wird, kündige es bei Google Play."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account does not cancel your Miff+ subscription. To stop being charged, cancel it in Google Play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar tu cuenta no cancela tu suscripción de Miff+. Para que dejen de cobrarte, cancélala en Google Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ton compte ne résilie pas ton abonnement Miff+. Pour ne plus être facturé, résilie-le dans Google Play."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare il tuo account non annulla il tuo abbonamento Miff+. Per interrompere gli addebiti, annullalo su Google Play."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar a tua conta não cancela a tua subscrição Miff+. Para não haver mais cobranças, cancela-a no Google Play."
          }
        }
      }
    },
