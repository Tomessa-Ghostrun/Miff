    "ios_detection_help_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An arrival or a departure can take a few minutes to be noticed. If it takes longer, these points may help."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une arrivée ou un départ peut mettre quelques minutes à être repéré. Si ça tarde, ces points peuvent aider."
          }
        }
      }
    },
    "ios_detection_help_step_location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In the Miff settings, location must be set to “Always”, with “Precise Location” turned on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Dans les réglages de Miff, la localisation doit être sur « Toujours », avec « Position exacte » activée."
          }
        }
      }
    },
    "ios_detection_help_step_refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Keep “Background App Refresh” turned on for Miff (Settings > General)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Garde « Actualisation en arrière-plan » activée pour Miff (Réglages > Général)."
          }
        }
      }
    },
    "ios_detection_help_step_saver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Low Power Mode can delay detections: if you can, avoid it while you are on the move."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Le mode économie d'énergie peut retarder les détections : si possible, évite-le pendant tes déplacements."
          }
        }
      }
    },
    "ios_detection_help_step_swipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. If a detection is late, opening Miff once lets you check that everything is in order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Si une détection tarde, rouvrir Miff une fois permet de vérifier que tout est en ordre."
          }
        }
      }
    },
    "ios_detection_help_outro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact names of the settings can change depending on the iOS version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms exacts des réglages peuvent changer selon la version d'iOS."
          }
        }
      }
    },
    "update_permission_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo for your loved ones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo pour tes proches"
          }
        }
      }
    },
    "update_permission_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To take a photo of you, or of what's around you, Miff needs access to your camera. The photo can be seen by the members of your Miffs for 24 hours, then it can no longer be read. Nothing is saved to your gallery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour te prendre en photo, ou photographier ce qui t'entoure, Miff a besoin d'accéder à ta caméra. La photo est visible des membres de tes Miffs pendant 24 h, puis elle n'est plus lisible. Rien n'est enregistré dans ta galerie."
          }
        }
      }
    },
