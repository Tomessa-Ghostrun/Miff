          "stringUnit": {
            "state": "translated",
            "value": "Poderás alterar esta escolha a qualquer momento nas Definições do iPhone."
          }
        }
      }
    },
    "ios_permission_location_denied_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen deinen Standort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a besoin de ta localisation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo bisogno della tua posizione"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos da tua localização"
          }
        }
      }
    },
    "ios_permission_location_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist für Miff auf deinem iPhone ausgeschaltet. Ohne ihn kann deine Miff nicht erfahren, wann du an deinen Orten ankommst oder sie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is turned off for Miff on your iPhone. Without it, your Miff can't know when you arrive at or leave your places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está desactivada para Miff en tu iPhone. Sin ella, tu Miff no puede saber cuándo llegas a tus lugares o sales de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée pour Miff sur ton iPhone. Sans elle, ta Miff ne peut pas savoir quand tu arrives ou pars de tes lieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è disattivata per Miff sul tuo iPhone. Senza di essa, la tua Miff non può sapere quando arrivi nei tuoi luoghi o ne esci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização está desativada para a Miff no teu iPhone. Sem ela, a tua Miff não consegue saber quando chegas aos teus locais ou sais deles."
          }
        }
      }
    },
    "ios_permission_location_denied_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es dir jederzeit in den Einstellungen anders überlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your mind at any time in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de opinión en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer d'avis à tout moment dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare idea in qualsiasi momento nelle Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes mudar de ideias a qualquer momento nas Definições."
          }
        }
      }
    },
    "ios_permission_location_services_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ortungsdienste sind auf deinem iPhone ausgeschaltet. Damit Miff funktioniert, müssen sie eingeschaltet sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are turned off on your iPhone. For Miff to work, they need to be turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de localización están desactivados en tu iPhone. Para que Miff funcione, hace falta activarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services de localisation sont désactivés sur ton iPhone. Pour que Miff fonctionne, ils doivent être activés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi di localizzazione sono disattivati sul tuo iPhone. Perché Miff funzioni, devono essere attivi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços de localização estão desativados no teu iPhone. Para a Miff funcionar, é preciso que estejam ativados."
          }
        }
      }
    },
