    "feed_refresh_position_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort konnte nicht aktualisiert werden. Dafür muss der Standort aktiviert sein und Miff den Zugriff „Immer“ mit genauem Standort haben. Das kannst du in den Einstellungen deines iPhones ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position couldn't be refreshed. For that, Miff needs location turned on, set to \"Always\" with precise location. You can change this in your iPhone's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar tu ubicación. Para ello, Miff necesita que la ubicación esté activada, en «Siempre» y con la ubicación exacta. Puedes cambiarlo en los ajustes de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n'a pas pu être actualisée. Pour cela, Miff a besoin que la localisation soit activée, sur « Toujours » avec la position exacte. Tu peux régler ça dans les réglages de ton iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare la tua posizione. Per farlo, Miff ha bisogno che la posizione sia attiva, su «Sempre» con Posizione precisa. Puoi regolarlo nelle impostazioni del tuo iPhone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar a tua localização. Para isso, a Miff precisa de ter a localização ativada, em «Sempre» e com localização precisa. Podes ajustar isto nas definições do iPhone."
          }
        }
      }
    },
