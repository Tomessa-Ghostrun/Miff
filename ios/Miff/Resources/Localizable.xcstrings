    "ios_permission_location_restricted_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist auf deinem iPhone durch eine Einstellung eingeschränkt, die du hier nicht ändern kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is limited on your iPhone by a setting you can't change here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está limitada en tu iPhone por una configuración que no puedes cambiar desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est limitée sur ton iPhone par un réglage que tu ne peux pas modifier ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è limitata sul tuo iPhone da un’impostazione che da qui non puoi modificare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização está limitada no teu iPhone por uma definição que não podes alterar aqui."
          }
        }
