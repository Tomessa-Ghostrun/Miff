    "review_feedback_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir möchten es besser machen. Wenn du uns sagen magst, was besser sein könnte, schreib uns: Das hilft uns weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We want to do better. If you'd like to tell us what could be improved, write to us: it helps us move forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queremos hacerlo mejor. Si quieres contarnos qué podría mejorar, escríbenos: nos ayuda a avanzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a envie de faire mieux. Si tu veux nous expliquer ce qui pourrait être mieux, écris-nous : ça nous aide à avancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vogliamo fare meglio. Se vuoi spiegarci cosa potrebbe andare meglio, scrivici: ci aiuta a crescere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queremos fazer melhor. Se nos quiseres explicar o que podia ser melhor, escreve-nos: ajuda-nos a avançar."
          }
        }
      }
    },
