    "place_request_paywall_limit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Grenze der kostenlosen Orte erreicht. Mit Miff+ kannst du diesen und viele weitere hinzufügen. Der Vorschlag bleibt offen, du kannst ihn auch ablehnen."
          }
        },
        "en": {
          "stringUnit": {
