            "state": "translated",
            "value": "Tu perfil, tu foto y tu número de teléfono se eliminarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton profil, ta photo et ton numéro de téléphone seront supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo, la tua foto e il tuo numero di telefono verranno eliminati."
          }
        },
        "pt": {
