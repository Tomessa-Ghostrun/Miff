    "miff_remove_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat dann keinen Zugriff mehr auf diesen Kreis. Ein neuer Code wird erstellt: Der alte funktioniert nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will no longer have access to this circle. A new code will be created: the old one will stop working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya no tendrá acceso a este círculo. Se creará un código nuevo: el anterior dejará de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'aura plus accès à ce cercle. Un nouveau code sera créé : l'ancien ne fonctionnera plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non avrà più accesso a questa cerchia. Verrà creato un nuovo codice: il vecchio non funzionerà più."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixará de ter acesso a este círculo. Será criado um novo código: o anterior deixará de funcionar."
          }
        }
      }
    },
