    "settings_delete_owned_explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Miffs werden samt ihren Orten gelöscht. Die Mitglieder haben dann keinen Zugriff mehr. Wenn du magst, kannst du sie vorher informieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These Miffs will be deleted, along with their places. Their members will no longer have access. If you prefer, you can let them know first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas Miffs se eliminarán, con sus lugares. Sus miembros ya no tendrán acceso. Si lo prefieres, puedes avisarles antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces Miffs seront supprimées, avec leurs lieux. Leurs membres n’y auront plus accès. Si tu préfères, tu peux d’abord les prévenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste Miff verranno eliminate, insieme ai loro luoghi. I loro membri non vi avranno più accesso. Se preferisci, puoi prima avvisarli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas Miffs serão eliminadas, com os respetivos locais. Os membros deixarão de ter acesso a elas. Se preferires, podes avisá-los primeiro."
          }
        }
      }
    },
    "settings_delete_owned_explain_one": {
      "extractionState": "manual",
      "localizations": {
