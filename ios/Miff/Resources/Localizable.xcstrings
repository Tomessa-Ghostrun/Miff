    "diag_lang_long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a deliberately long sentence, to check how the layout reacts when a translated text is much longer than the original, including wrapping over several lines with a large font size."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici une phrase volontairement longue, pour vérifier comment la mise en page réagit quand un texte traduit est bien plus long que l'original, y compris avec un retour à la ligne sur plusieurs lignes et une grande taille de police."
          }
        }
      }
    },
    "diag_lang_members": {
