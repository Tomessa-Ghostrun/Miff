    "update_notice_location_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position isn't available: your phone's location is off, or Miff is no longer allowed to use it. You can turn it back on in the settings, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n'est pas accessible : la localisation du téléphone est éteinte, ou Miff n'a plus le droit de l'utiliser. Tu peux la rallumer dans les réglages, puis réessayer."
          }
        }
      }
    },
