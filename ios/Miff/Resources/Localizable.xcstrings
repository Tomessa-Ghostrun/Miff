    "settings_subscription_grace": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung für dein Abonnement ist nicht durchgegangen. Es funktioniert noch alles: Aktualisiere deine Zahlungsmethode vor dem %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment for your subscription didn't go through. Everything still works: update your payment method before %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago de tu suscripción no se ha completado. Todo sigue funcionando: actualiza tu método de pago antes del %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement de ton abonnement n'a pas abouti. Tout fonctionne encore : mets à jour ton moyen de paiement avant le %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento del tuo abbonamento non è andato a buon fine. Tutto funziona ancora: aggiorna il metodo di pagamento prima del %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento da tua subscrição não foi concluído. Tudo continua a funcionar: atualiza o teu método de pagamento antes de %1$@."
          }
        }
      }
    },
    "settings_subscription_on_hold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff+ ist pausiert: Die Zahlung ist nicht durchgegangen. Deine Vorteile sind wieder da, sobald das geklärt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff+ is on hold: the payment didn't go through. Your benefits will be back as soon as it's sorted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff+ está en pausa: el pago no se ha completado. Tus ventajas volverán en cuanto se resuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff+ est en pause : le paiement n'a pas abouti. Tes avantages reviendront dès que ce sera réglé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff+ è in pausa: il pagamento non è andato a buon fine. I tuoi vantaggi torneranno non appena sarà risolto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff+ está em pausa: o pagamento não foi concluído. As tuas vantagens voltam assim que ficar resolvido."
          }
        }
      }
    },
    "settings_subscription_expired": {
      "extractionState": "manual",
      "localizations": {
