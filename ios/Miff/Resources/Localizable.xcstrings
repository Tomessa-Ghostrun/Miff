          }
        }
      }
    },
    "miff_sharing_waiting_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your agreement: your status is no longer updated. You can stop sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de ton accord : ton statut n'est plus mis à jour. Tu peux arrêter de partager."
          }
        }
      }
    },
    "settings_privacy_location_status_ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always allowed"
          }
        },
        "fr": {
          "stringUnit": {
