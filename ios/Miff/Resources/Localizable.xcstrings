    "voyage_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karte wird grau mit „Auf Reisen bis %1$@“ und hat keinen Einfluss mehr auf die Farbe der Miff. Deine Liebsten sehen weiterhin deinen Standort. Du kannst den Reisemodus jederzeit beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card will turn grey with “Traveling until %1$@” and will no longer affect the Miff's colour. Your circle still sees your location. You can stop it whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarjeta se volverá gris con «De viaje hasta el %1$@» y dejará de influir en el color de la Miff. Tus seres queridos siguen viendo tu ubicación. Puedes detenerlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta carte deviendra grise avec « En voyage jusqu'au %1$@ » et n'influencera plus la couleur de la Miff. Tes proches continuent de voir ta position. Tu peux l'arrêter quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scheda diventerà grigia con «In viaggio fino al giorno %1$@» e non influirà più sul colore della Miff. I tuoi cari continuano a vedere la tua posizione. Puoi disattivarla quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu cartão vai ficar cinzento com «De viagem até dia %1$@» e deixa de influenciar a cor da Miff. Os teus entes queridos continuam a ver a tua localização. Podes desativá-lo quando quiseres."
          }
        }
      }
    },
