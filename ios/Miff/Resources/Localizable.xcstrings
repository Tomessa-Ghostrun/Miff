    "settings_delete_you": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil, dein Foto und deine Telefonnummer werden gelöscht. Du verlässt die Miffs, denen du beigetreten bist: Dein Status und dein Foto sind dort nicht mehr sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, photo and phone number will be deleted. You will leave the Miffs you joined: your status and photo will no longer be visible there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil, tu foto y tu número de teléfono se eliminarán. Saldrás de las Miffs a las que te has unido: tu estado y tu foto dejarán de verse allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton profil, ta photo et ton numéro de téléphone seront supprimés. Tu quitteras les Miffs que tu as rejointes : ton statut et ta photo n’y seront plus visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo, la tua foto e il tuo numero di telefono verranno eliminati. Uscirai dalle Miff di cui fai parte: il tuo stato e la tua foto non saranno più visibili al loro interno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu perfil, a tua foto e o teu número de telefone serão eliminados. Vais sair das Miffs em que entraste: o teu estado e a tua foto deixarão de estar visíveis aí."
          }
        }
      }
    },
