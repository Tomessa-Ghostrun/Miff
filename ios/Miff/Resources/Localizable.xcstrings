    "auth_error_account_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist gerade nicht verfügbar. Wenn du Hilfe brauchst, schreib uns an %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is not available for now. If you need help, write to us at %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no está disponible por ahora. Si necesitas ayuda, escríbenos a %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'est pas disponible pour le moment. Si tu as besoin d'aide, écris-nous à %1$@."
