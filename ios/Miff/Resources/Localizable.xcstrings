    "miff_consent3_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du mit dieser Miff teilst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you share with this Miff"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que compartes con esta Miff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu partages avec cette Miff"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa condividi con questa Miff"
          }
        },
        "pt": {
