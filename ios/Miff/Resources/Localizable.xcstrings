    "onboarding_slide1_illustration_a11y": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau des Bildschirms deiner Miff: Allen geht es gut, Thomas ist zu Hause und Amandine in der Schule."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview of your Miff screen: everyone is fine, Thomas is at home and Amandine is at school."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de la pantalla de tu Miff: todo el mundo está bien, Thomas está en casa y Amandine en la escuela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de l'écran de ta Miff : tout le monde va bien, Thomas est à la maison et Amandine à l'école."
          }
