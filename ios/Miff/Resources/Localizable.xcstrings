    "settings_delete_copy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du eine Kopie deiner Daten? Schreib uns, bevor du dein Konto löschst: %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want a copy of your data? Write to us before deleting your account: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres conservar una copia de tus datos? Escríbenos antes de eliminar tu cuenta: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu veux garder une copie de tes données ? Écris-nous avant de supprimer ton compte : %1$@."
          }
        },
        "it": {
