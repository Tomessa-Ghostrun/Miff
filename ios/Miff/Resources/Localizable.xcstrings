{
  "sourceLanguage": "fr",
  "strings": {
    "auth_account_deleted_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has been deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte a été supprimé."
          }
        }
      }
    },
    "auth_back_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour"
          }
        }
      }
    },
    "auth_consent_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By tapping “Join” or “Continue with Google”, you accept our %1$@ and our %2$@, as well as the sharing of your anonymous usage statistics and crash reports (you can change this at any time in the Settings)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cliquant sur « Rejoindre » ou « Continuer avec Google », tu acceptes nos %1$@ et notre %2$@, ainsi que le partage de tes statistiques d'usage et rapports de plantage anonymes (modifiable à tout moment dans les Réglages)."
          }
        }
      }
    },
    "auth_consent_privacy_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Politique de confidentialité"
          }
        }
      }
    },
    "auth_consent_terms_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of Use"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions d'utilisation"
          }
        }
      }
    },
    "auth_email_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail address"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse e-mail"
          }
        }
      }
    },
    "auth_error_account_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is not available for now. If you need help, write to us at %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'est pas disponible pour le moment. Si tu as besoin d'aide, écris-nous à %1$@."
          }
        }
      }
    },
    "auth_error_email_format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This e-mail address doesn't look right."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail ne semble pas correcte."
          }
        }
      }
    },
    "auth_error_email_in_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account already exists with this address. You can sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cette adresse. Tu peux te connecter."
          }
        }
      }
    },
    "auth_error_google_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Google did not go through. Please try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Google n'a pas abouti. Réessaie dans un instant."
          }
        }
      }
    },
    "auth_error_google_no_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google could not offer an account on this phone for now. You can add one in the phone settings, or continue with your e-mail address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google n'a pas pu proposer de compte sur ce téléphone pour le moment. Tu peux en ajouter un dans les réglages du téléphone, ou continuer avec ton adresse e-mail."
          }
        }
      }
    },
    "auth_error_google_services": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google services are not responding on this phone for now. Check that they are up to date, or continue with your e-mail address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services Google ne répondent pas sur ce téléphone pour le moment. Vérifie qu'ils sont à jour, ou continue avec ton adresse e-mail."
          }
        }
      }
    },
    "auth_error_invalid_credentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination does not work. Check your e-mail address and your password, or choose “Forgot password?”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison ne fonctionne pas. Vérifie ton adresse e-mail et ton mot de passe, ou choisis « Mot de passe oublié ? »."
          }
        }
      }
    },
    "auth_error_network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection for now. Try again as soon as you have a network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion pour le moment. Réessaie dès que tu as du réseau."
          }
        }
      }
    },
    "auth_error_other_method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account already exists with this address, using another way to sign in. Try the other option."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte existe déjà avec cette adresse, avec un autre mode de connexion. Essaie l'autre option."
          }
        }
      }
    },
    "auth_error_password_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 characters minimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 caractères minimum."
          }
        }
      }
    },
    "auth_error_too_many": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few too many attempts for now. Please wait a few minutes or reset your password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu trop d'essais pour le moment. Patiente quelques minutes ou réinitialise ton mot de passe."
          }
        }
      }
    },
    "auth_error_too_many_requests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few too many requests for now. Please wait a few minutes before trying again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu trop de demandes pour le moment. Patiente quelques minutes avant de réessayer."
          }
        }
      }
    },
    "auth_error_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something did not work. Please try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose n'a pas fonctionné. Réessaie dans un instant."
          }
        }
      }
    },
    "auth_google_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Google"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer avec Google"
          }
        }
      }
    },
    "auth_loading_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement en cours"
          }
        }
      }
    },
    "auth_lookup_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't open your account right now. Please try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'arrivons pas à ouvrir ton compte pour le moment. Réessaie dans un instant."
          }
        }
      }
    },
    "auth_or_divider": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou :"
          }
        }
      }
    },
    "auth_panel_cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "auth_panel_continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "auth_panel_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By tapping “Continue”, you accept our %1$@ and our %2$@, as well as the sharing of your anonymous usage statistics and crash reports (you can change this at any time in the Settings)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cliquant sur « Continuer », tu acceptes nos %1$@ et notre %2$@, ainsi que le partage de tes statistiques d'usage et rapports de plantage anonymes (modifiable à tout moment dans les Réglages)."
          }
        }
      }
    },
    "auth_panel_refused_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No worries, your account was not created. You can create it whenever you like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de souci, ton compte n'a pas été créé. Tu pourras le créer quand tu veux."
          }
        }
      }
    },
    "auth_panel_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome! One last thing before you continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue ! Une dernière chose avant de continuer."
          }
        }
      }
    },
    "auth_password_hide_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le mot de passe"
          }
        }
      }
    },
    "auth_password_label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe"
          }
        }
      }
    },
    "auth_password_show_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le mot de passe"
          }
        }
      }
    },
    "auth_reset_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer"
          }
        }
      }
    },
    "auth_reset_back_to_signin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to sign in"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour à la connexion"
          }
        }
      }
    },
    "auth_reset_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the e-mail address of your account. If it matches an account, you will receive a link to choose a new password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l'adresse e-mail de ton compte. Si elle correspond à un compte, tu recevras un lien pour choisir un nouveau mot de passe."
          }
        }
      }
    },
    "auth_reset_resend_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the e-mail again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer l'e-mail"
          }
        }
      }
    },
    "auth_reset_resend_wait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask for a new e-mail in a few moments."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux demander un nouvel e-mail dans quelques instants."
          }
        }
      }
    },
    "auth_reset_sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists with this address, an e-mail has just been sent. Remember to check your spam folder. If you signed up with Apple or Google, use the matching button on the sign-in screen instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe avec cette adresse, un e-mail vient d'être envoyé. Pense à regarder dans tes courriers indésirables. Si tu t'es inscrit avec Apple ou Google, utilise plutôt le bouton correspondant sur l'écran de connexion."
          }
        }
      }
    },
    "auth_reset_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot your password?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe oublié"
          }
        }
      }
    },
    "auth_retry_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "auth_session_replaced_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is now being used on another phone. You've been signed out of this one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte est maintenant utilisé sur un autre téléphone. Tu as été déconnecté(e) de celui-ci."
          }
        }
      }
    },
    "auth_session_gone_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account changed on another device (for example, a deletion in progress). This phone was signed out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte a changé sur un autre appareil (par exemple une suppression en cours). Ce téléphone a été déconnecté."
          }
        }
      }
    },
    "auth_signin_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        }
      }
    },
    "auth_signin_forgot_password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot password?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe oublié ?"
          }
        }
      }
    },
    "auth_signin_no_account": {
      "extractionState": "manual",
      "localizations": {
