            "value": "Por completar en los ajustes del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À compléter dans les réglages du téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da completare nelle impostazioni del telefono"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por concluir nas definições do telemóvel"
          }
        }
      }
    },
    "settings_privacy_miff_waiting_pill": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehend"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em espera"
          }
        }
      }
    },
    "settings_privacy_miff_waiting_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zustimmung steht noch aus: Miff aktualisiert deinen Status mit dieser Miff nicht mehr. Du kannst das Teilen auf dem Bildschirm der Miff beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agreement is waiting: Miff no longer updates your status with this Miff. You can stop sharing from the Miff screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu consentimiento está en espera: Miff ya no actualiza tu estado con esta Miff. Puedes dejar de compartir desde la pantalla de la Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accord est en attente : Miff ne met plus à jour ton statut avec cette Miff. Tu peux arrêter de partager depuis l'écran de la Miff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo consenso è in attesa: Miff non aggiorna più il tuo stato con questa Miff. Puoi smettere di condividere dalla schermata della Miff."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu consentimento está em espera: a Miff já não atualiza o teu estado com esta Miff. Podes deixar de partilhar a partir do ecrã da Miff."
          }
        }
      }
    },
    "settings_privacy_clarify_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff hat genauer erklärt, was auf unseren Servern und nur auf deinem Telefon gespeichert wird. Alles bleibt wie bisher: Du kannst diesen Hinweis lesen und akzeptieren, wann du möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff has clarified what it keeps on our servers and on your phone only. Everything goes on as before: you can read this clarification and accept it whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha precisado lo que guarda en nuestros servidores y lo que guarda solo en tu teléfono. Todo sigue como antes: puedes leer esta precisión y aceptarla cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a précisé ce qu'il garde sur nos serveurs et sur ton téléphone seulement. Tout continue comme avant : tu peux lire cette précision et l'accepter quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha precisato cosa conserva sui nostri server e cosa conserva solo sul tuo telefono. Tutto continua come prima: puoi leggere questa precisazione e accettarla quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff esclareceu o que guarda nos nossos servidores e o que guarda apenas no teu telemóvel. Tudo continua como antes: podes ler este esclarecimento e aceitá-lo quando quiseres."
          }
        }
      }
    },
    "settings_privacy_detection_help_link": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Erkennung dauert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If detections are slow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si las detecciones tardan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les détections tardent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i rilevamenti tardano"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se as deteções demoram"
          }
        }
      }
    },
    "settings_detection_help_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Ankunft und Verlassen länger dauern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If arrivals and departures are slow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si las llegadas y salidas tardan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les arrivées et départs tardent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gli arrivi e le partenze tardano"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se as chegadas e saídas demoram"
          }
        }
      }
    },
    "settings_detection_help_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Telefone (Oppo, Xiaomi, Samsung, Huawei …) beenden Apps im Hintergrund, um Akku zu sparen. Dann erkennt Miff eine Ankunft oder das Verlassen eines Ortes womöglich verspätet. Diese Einstellungen sind optional; sie können helfen, und Miff funktioniert auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some phones (Oppo, Xiaomi, Samsung, Huawei...) stop apps in the background to save battery. Miff may then notice an arrival or a departure late. These settings are optional: they may help, and Miff works without them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos teléfonos (Oppo, Xiaomi, Samsung, Huawei…) detienen las aplicaciones en segundo plano para ahorrar batería. Entonces Miff puede detectar una llegada o una salida con retraso. Estas opciones de configuración son opcionales: pueden ayudar, y Miff funciona sin ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléphones (Oppo, Xiaomi, Samsung, Huawei...) arrêtent les applications en arrière-plan pour économiser la batterie. Miff peut alors repérer une arrivée ou un départ avec du retard. Ces réglages sont facultatifs : ils peuvent aider, et Miff fonctionne sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni telefoni (Oppo, Xiaomi, Samsung, Huawei…) interrompono le app in background per risparmiare batteria. Miff può quindi rilevare un arrivo o una partenza in ritardo. Queste impostazioni sono facoltative: possono aiutare, e Miff funziona anche senza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns telemóveis (Oppo, Xiaomi, Samsung, Huawei…) interrompem as apps em segundo plano para poupar bateria. A Miff pode então detetar uma chegada ou uma saída com atraso. Estas definições são opcionais: podem ajudar, e a Miff funciona sem elas."
          }
        }
      }
    },
    "settings_detection_help_step_battery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffne in den Einstellungen von Miff „Akku“ (oder „Energieverbrauch“) und wähle „Keine Einschränkungen“ (oder „Nicht optimieren“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In the Miff settings, open \"Battery\" (or \"Power consumption\") and choose \"No restrictions\" (or \"Don't optimize\")."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. En los ajustes de Miff, abre «Batería» (o «Consumo de energía») y elige «Sin restricciones» (o «No optimizar»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Dans les réglages de Miff, ouvre « Batterie » (ou « Consommation d'énergie ») et choisis « Aucune restriction » (ou « Ne pas optimiser »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nelle impostazioni di Miff apri «Batteria» (o «Consumo energetico») e scegli «Nessuna restrizione» (o «Non ottimizzare»)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nas definições da Miff, abre «Bateria» (ou «Consumo de energia») e escolhe «Sem restrições» (ou «Não otimizar»)."
          }
        }
      }
    },
    "settings_detection_help_step_background": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Erlaube die Hintergrundaktivität von Miff, falls das Telefon sie anbietet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Allow background activity for Miff if the phone offers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Permite la actividad en segundo plano de Miff si el teléfono lo ofrece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Autorise l'activité en arrière-plan de Miff si le téléphone le propose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Consenti l’attività in background di Miff se il telefono lo prevede."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Permite a atividade em segundo plano da Miff, se o telemóvel der essa opção."
          }
        }
      }
    },
    "settings_detection_help_step_autostart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Auf Oppo, OnePlus oder Realme (ColorOS): Erlaube auch den „Autostart“ von Miff und schließe die App nicht, indem du sie in der Liste der zuletzt verwendeten Apps wegwischst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. On Oppo, OnePlus or Realme (ColorOS): also allow Miff to \"auto-start\", and do not close it by swiping it away in the list of recent apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. En Oppo, OnePlus o Realme (ColorOS): permite también el «inicio automático» de Miff y no la cierres deslizándola en la lista de aplicaciones recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Sur Oppo, OnePlus ou Realme (ColorOS) : autorise aussi le « démarrage automatique » de Miff, et ne la ferme pas en la balayant dans la liste des applications récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Su Oppo, OnePlus o Realme (ColorOS): consenti anche l’«avvio automatico» di Miff e non chiuderla scorrendola via dall’elenco delle app recenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Num Oppo, OnePlus ou Realme (ColorOS): permite também o «arranque automático» da Miff e não a feches ao deslizá-la na lista de apps recentes."
          }
        }
      }
    },
    "settings_detection_help_step_saver": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Lass den Akkusparmodus möglichst nicht dauerhaft an, vor allem wenn du unterwegs bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. If you can, avoid keeping battery saver on all the time, especially while you are on the move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Si puedes, evita tener el ahorro de batería activado todo el tiempo, sobre todo durante tus desplazamientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Si possible, évite l'économiseur de batterie en continu, surtout pendant tes déplacements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Se puoi, evita di tenere sempre attivo il risparmio energetico, soprattutto durante i tuoi spostamenti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Se possível, evita ter a poupança de bateria sempre ativa, sobretudo durante as tuas deslocações."
          }
        }
      }
    },
    "settings_detection_help_outro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die genauen Bezeichnungen der Einstellungen sind je nach Telefon und Android-Version unterschiedlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact names of the settings change with the phone and the Android version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres exactos de las opciones de configuración cambian según el teléfono y la versión de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms exacts des réglages changent selon le téléphone et la version d'Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi esatti delle impostazioni cambiano a seconda del telefono e della versione di Android."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes exatos das definições mudam consoante o telemóvel e a versão do Android."
          }
        }
      }
    },
