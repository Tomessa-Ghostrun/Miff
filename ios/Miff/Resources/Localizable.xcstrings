    "miff_owner_foot": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Miff erstellt: Wenn du sie schließen möchtest, kannst du sie löschen. Die anderen Liebsten haben dann keinen Zugriff mehr darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You created this Miff: if you want to close it, you can delete it. The other loved ones will then no longer have access to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has creado esta Miff: si quieres cerrarla, puedes eliminarla. Los demás seres queridos dejarán entonces de tener acceso a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as créé cette Miff : si tu veux la fermer, tu peux la supprimer. Les autres proches n'y auront alors plus accès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai creato tu questa Miff: se vuoi chiuderla, puoi eliminarla. Gli altri cari non avranno più accesso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu criaste esta Miff: se a quiseres encerrar, podes eliminá-la. Os outros entes queridos deixam então de ter acesso a ela."
          }
        }
      }
    },
