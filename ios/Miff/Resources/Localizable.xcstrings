    "diag_privacy_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both are off by default: no usage or crash data is sent before you agree. Your choice is kept after a restart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sont désactivés par défaut : aucune donnée d'usage ni de plantage n'est envoyée avant votre accord. Votre choix est conservé après un redémarrage."
          }
        }
      }
    },
    "diag_privacy_title": {
