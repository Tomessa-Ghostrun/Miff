    "auth_error_email_in_use": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Adresse gibt es schon ein Konto. Du kannst dich anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account already exists with this address. You can sign in."
