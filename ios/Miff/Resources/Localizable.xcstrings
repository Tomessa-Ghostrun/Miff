    "miff_renewal_exit_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts gespeichert, bis du zustimmst. Du kannst diese Miff auch verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is recorded until you agree. You can also leave this Miff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guarda nada hasta que aceptes. También puedes salir de esta Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est enregistré tant que tu n'as pas accepté. Tu peux aussi quitter cette Miff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene salvato nulla finché non accetti. Puoi anche lasciare questa Miff."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é guardado nada até aceitares. Também podes sair desta Miff."
          }
        }
      }
    },
    "miff_waiting_title": {
      "extractionState": "manual",
