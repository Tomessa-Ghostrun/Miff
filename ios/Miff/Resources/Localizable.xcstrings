    "miff_renewal_error_extra": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agreement is not saved: nothing is shared for now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accord n'est pas enregistré : rien n'est partagé pour l'instant."
          }
        }
      }
    },
    "miff_renewal_exit_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is recorded until you agree. You can also leave this Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est enregistré tant que tu n'as pas accepté. Tu peux aussi quitter cette Miff."
          }
        }
      }
    },
    "miff_waiting_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your agreement"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de ton accord"
          }
        }
      }
    },
    "miff_waiting_feed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no longer updates your status with \"%1$@\" until you agree."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ne met plus à jour ton statut avec « %1$@ » tant que tu n'as pas donné ton accord."
          }
        }
      }
    },
    "miff_waiting_feed_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see your loved ones' statuses here again once you've agreed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu verras de nouveau les statuts de tes proches ici dès que tu auras donné ton accord."
          }
        }
      }
    },
    "miff_waiting_miff_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no longer updates your status with this Miff until you agree. Your last status stays visible to its members until you stop sharing. You can also leave it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ne met plus à jour ton statut avec cette Miff tant que tu n'as pas donné ton accord. Ton dernier statut reste visible de ses membres jusqu'à ce que tu arrêtes de partager. Tu peux aussi la quitter."
          }
        }
      }
    },
    "miff_waiting_miff_body_owner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff no longer updates your status with this Miff until you agree. Your last status stays visible to its members until you stop sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ne met plus à jour ton statut avec cette Miff tant que tu n'as pas donné ton accord. Ton dernier statut reste visible de ses membres jusqu'à ce que tu arrêtes de partager."
          }
        }
      }
    },
    "miff_waiting_review": {
      "extractionState": "manual",
      "localizations": {
