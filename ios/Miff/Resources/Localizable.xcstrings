    "ios_myinfo_save_failed_later": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es klappt weiterhin nicht. Deine Angaben bleiben hier erhalten: Versuch es etwas später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It still isn't going through. Your information stays here: try again a little later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue sin funcionar. Tus datos se quedan aquí: inténtalo de nuevo un poco más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça ne passe toujours pas. Tes informations restent ici : réessaie un peu plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora andata a buon fine. Le tue informazioni restano qui: riprova un po’ più tardi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua sem funcionar. As tuas informações ficam aqui: tenta novamente um pouco mais tarde."
          }
        }
      }
    },
