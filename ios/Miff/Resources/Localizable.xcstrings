    "auth_session_replaced_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto wird jetzt auf einem anderen Telefon verwendet. Auf diesem Telefon wurdest du abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is now being used on another phone. You've been signed out of this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta se está usando ahora en otro teléfono. Se ha cerrado tu sesión en este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte est maintenant utilisé sur un autre téléphone. Ta session a été fermée sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è ora in uso su un altro telefono. La sessione su questo telefono è stata chiusa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta está agora a ser usada noutro telemóvel. A tua sessão neste telemóvel foi terminada."
          }
        }
      }
    },
    "auth_session_gone_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto hat sich auf einem anderen Gerät geändert (zum Beispiel durch eine laufende Löschung). Dieses Telefon wurde abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account changed on another device (for example, a deletion in progress). This phone was signed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta ha cambiado en otro dispositivo (por ejemplo, una eliminación en curso). Se ha cerrado la sesión en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte a changé sur un autre appareil (par exemple une suppression en cours). Ce téléphone a été déconnecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è cambiato su un altro dispositivo (per esempio, un’eliminazione in corso). La sessione su questo telefono è stata chiusa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta mudou noutro dispositivo (por exemplo, uma eliminação em curso). A sessão neste telemóvel foi terminada."
          }
        }
      }
    },
