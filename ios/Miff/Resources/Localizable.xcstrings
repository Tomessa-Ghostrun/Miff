        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre, tu apellido, tu foto, tu número de teléfono y el nivel de tu batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prénom, ton nom, ta photo, ton numéro de téléphone et ton niveau de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome, il tuo cognome, la tua foto, il tuo numero di telefono e il livello della tua batteria."
