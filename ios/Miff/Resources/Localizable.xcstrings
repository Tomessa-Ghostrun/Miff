    "settings_delete_warn_message_generic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schließe unsere Miff in Miff: Danach ist sie nicht mehr zugänglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’m closing our Miff in Miff: it will no longer be accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierro nuestra Miff en Miff: ya no será accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ferme notre Miff dans Miff : elle ne sera plus accessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudo la nostra Miff su Miff: non sarà più accessibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou a fechar a nossa Miff na app Miff: deixará de estar acessível."
          }
        }
      }
    },
    "settings_delete_confirm_body_owner": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto, deine Miff-Daten und deine Miffs werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, your Miff data and your Miffs will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, tus datos de Miff y tus Miffs se eliminarán. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte, tes données Miff et tes Miffs seront supprimés. Ce n’est pas réversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account, i tuoi dati Miff e le tue Miff verranno eliminati. Non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta, os teus dados da Miff e as tuas Miffs serão eliminados. Não pode ser anulado."
          }
        }
      }
    },
