    "about_feedback_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was dir gefällt und was besser sein könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what you like and what could be better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué te gusta y qué podría mejorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous ce qui te plaît et ce qui pourrait être mieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci cosa ti piace e cosa potrebbe andare meglio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-nos do que gostas e o que poderia ser melhor."
          }
        }
      }
    },
