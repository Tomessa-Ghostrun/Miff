    "paywall_info_annual": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro Jahr, auf einmal abgerechnet und danach jährlich. Verlängert sich automatisch zum selben Preis, bis du es kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per year, billed at once and then every year. Renews automatically at the same price until you cancel it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ al año, que se cobran de una sola vez y luego cada año. Renovación automática al mismo precio hasta que la canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par an, facturés en une fois puis chaque année. Renouvellement automatique au même tarif tant que tu ne l'annules pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ all’anno, addebitati in un’unica soluzione e poi ogni anno. Rinnovo automatico allo stesso prezzo finché non lo annulli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por ano, cobrados de uma só vez e depois todos os anos. Renovação automática ao mesmo preço até a cancelares."
          }
        }
      }
    },
    "paywall_info_cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit in den Einstellungen deines Kontos bei %1$@ kündigen, vor Ende des laufenden Zeitraums. Du behältst den Zugang bis zum Ende des bezahlten Zeitraums."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel anytime in your %1$@ account settings, before the end of the current period; you keep access until the end of the paid period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela en cualquier momento en los ajustes de tu cuenta de %1$@, antes de que termine el periodo en curso; conservas el acceso hasta el final del periodo pagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule à tout moment dans les réglages de ton compte %1$@, avant la fin de la période en cours ; tu gardes l'accès jusqu'à la fin de la période payée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla in qualsiasi momento nelle impostazioni del tuo account %1$@, prima della fine del periodo in corso; mantieni l’accesso fino alla fine del periodo pagato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela a qualquer momento nas definições da tua conta %1$@, antes do fim do período em curso; manténs o acesso até ao fim do período pago."
          }
        }
      }
    },
