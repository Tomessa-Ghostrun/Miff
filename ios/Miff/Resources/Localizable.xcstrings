    "update_preview_visibility": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Liebsten, die ebenfalls ihren Standort teilen, sehen dieses Foto 24 Stunden lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your loved ones who also share their location will see this photo for 24 hours."
