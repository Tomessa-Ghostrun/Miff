    "voyage_error_update_refused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Reisemodus konnte nicht aktualisiert werden. Dein Enddatum hat sich nicht geändert, du kannst es später noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel mode couldn't be updated. Your end date hasn't changed; you can try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar el modo viaje. Tu fecha de fin no ha cambiado, puedes intentarlo de nuevo más tarde."
