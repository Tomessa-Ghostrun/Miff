      }
    },
    "feed_colors_not_alert": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine Notfallwarnung. Miff verständigt nie die Notdienste: Du und deine Liebsten entscheidet selbst, was zu tun ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not an emergency alert. Miff never contacts emergency services: you and your loved ones decide what to do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una alerta de emergencia. Miff nunca avisa a los servicios de emergencias: quien decide qué hacer eres tú, junto con tus seres queridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une alerte d'urgence. Miff ne prévient jamais les secours : c'est toi et tes proches qui décidez quoi faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un’allerta di emergenza. Miff non avvisa mai i soccorsi: sei tu, insieme ai tuoi cari, a decidere cosa fare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é um alerta de emergência. A Miff nunca contacta os serviços de emergência: é a ti e aos teus entes queridos que cabe decidir o que fazer."
          }
        }
      }
    },
    "feed_colors_not_location": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Live-Standort. Eine Farbe zeigt nie, wo jemand ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not a live location. A color never shows where someone is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una ubicación en directo. Un color nunca muestra dónde está alguien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une position en direct. Une couleur ne montre jamais où se trouve quelqu'un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è una posizione in tempo reale. Un colore non mostra mai dove si trova qualcuno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma localização em direto. Uma cor nunca mostra onde alguém está."
          }
        }
      }
    },
    "feed_colors_not_verdict": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange oder Rot bedeutet nicht, dass es ein Problem gibt, sondern nur, dass es seit einer Weile keine Neuigkeiten gab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange or red doesn't mean something is wrong, only that there's been no news for a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Naranja o rojo no significa que haya un problema, solo que hace un tiempo que no hay noticias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange ou rouge ne veut pas dire qu'il y a un problème, seulement qu'on n'a pas eu de nouvelles depuis un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arancione o rosso non significa che ci sia un problema, solo che da un po’ non ci sono notizie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laranja ou vermelho não significa que haja um problema, apenas que não há notícias há algum tempo."
          }
        }
      }
    },
    "feed_colors_not_delay": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon berechnet die Farben aus den zuletzt empfangenen Informationen. Ohne Verbindung können sie etwas verspätet sein: Der Feed zeigt dann die Uhrzeit der letzten Informationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone works out the colors from the latest information received. Without a connection they can lag a little: the feed then shows the time of the latest information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono calcula los colores a partir de la última información recibida. Sin conexión, pueden llevar un poco de retraso: el Feed indica entonces la hora de la última información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone calcule les couleurs à partir des dernières informations reçues. Sans connexion, elles peuvent avoir un peu de retard : le fil indique alors l'heure des dernières informations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo telefono calcola i colori in base alle ultime informazioni ricevute. Senza connessione possono essere un po’ in ritardo: il Feed indica allora l’orario delle ultime informazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu telemóvel calcula as cores a partir das últimas informações recebidas. Sem ligação, podem ter algum atraso: o Feed indica então a hora das últimas informações."
          }
        }
      }
    },
