    "review_thanks_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das freut uns wirklich sehr. Wenn du magst, hinterlass uns eine Bewertung und einen Kommentar im App-Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That really makes us happy. If you feel like it, leave us a review and a comment in the app store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos alegra de verdad. Si quieres, déjanos una reseña y un comentario en la tienda de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça nous fait vraiment plaisir. Si tu en as envie, laisse-nous un avis et un commentaire dans la boutique d'applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci fa davvero piacere. Se ti va, lasciaci una recensione e un commento nello store delle app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficamos mesmo muito contentes. Se te apetecer, deixa-nos uma avaliação e um comentário na loja de apps."
          }
        }
      }
    },
