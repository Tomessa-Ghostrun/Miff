    "settings_my_info_sync_pending": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Informationen sind gespeichert. Deine Liebsten sehen die Änderungen, sobald die Verbindung es erlaubt: Tippe gleich noch einmal auf „Speichern“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your information is saved. Your loved ones will see the changes as soon as the connection allows: tap “Save” again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se han guardado. Tus seres queridos verán los cambios en cuanto la conexión lo permita: toca de nuevo «Guardar» en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes informations sont enregistrées. Tes proches verront les changements dès que la connexion le permet : appuie de nouveau sur « Enregistrer » dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue informazioni sono salvate. I tuoi cari vedranno le modifiche appena la connessione lo permetterà: tocca di nuovo «Salva» tra un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas informações estão guardadas. Os teus entes queridos vão ver as alterações assim que a ligação o permitir: toca de novo em «Guardar» daqui a pouco."
          }
        }
      }
    },
