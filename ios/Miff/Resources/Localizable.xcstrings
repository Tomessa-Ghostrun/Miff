    "voyage_card_off_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karte wird für deine Liebsten grau, ohne die Farbe der Miff zu ändern. Deine Liebsten sehen weiterhin deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card turns grey for your circle, without changing the Miff's colour. Your circle still sees your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarjeta se vuelve gris para tus seres queridos, sin cambiar el color de la Miff. Tus seres queridos siguen viendo tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta carte devient grise pour tes proches, sans changer la couleur de la Miff. Tes proches continuent de voir ta position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scheda diventa grigia per i tuoi cari, senza cambiare il colore della Miff. I tuoi cari continuano a vedere la tua posizione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu cartão fica cinzento para os teus entes queridos, sem alterar a cor da Miff. Os teus entes queridos continuam a ver a tua localização."
          }
        }
      }
    },
