          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar"
          }
        }
      }
    },
    "settings_privacy_time_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zeitverteilung beginnt wieder bei null. Für deine Liebsten ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chart will start again from zero. This changes nothing for your loved ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reparto empezará de cero. No cambia nada para tus seres queridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta répartition repartira de zéro. Cela ne change rien pour tes proches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua ripartizione ripartirà da zero. Per i tuoi cari non cambia nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua distribuição do tempo vai recomeçar do zero. Isto não altera nada para os teus entes queridos."
          }
        }
      }
    },
    "settings_privacy_time_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitverlauf löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase the history?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el historial?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l'historique ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare la cronologia?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o histórico?"
          }
        }
      }
    },
    "settings_privacy_time_done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt: Deine Zeitverteilung beginnt wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done: your chart starts again from zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: tu reparto vuelve a empezar de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est fait : ta répartition repart de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto: la tua ripartizione riparte da zero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito: a tua distribuição do tempo recomeça do zero."
          }
        }
      }
    },
    "settings_privacy_time_erase": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meinen Zeitverlauf löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase my time history"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar mi historial de tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer mon historique de temps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la mia cronologia del tempo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o meu histórico de tempo"
          }
        }
      }
    },
    "settings_privacy_time_erase_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht, was Miff für deine Zeitverteilung auf deinem Telefon speichert: wann du an deinen Orten ankommst und sie verlässt. Für deine Liebsten ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases the arrivals and departures Miff keeps on your phone for your time breakdown. This changes nothing for your loved ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra las llegadas y salidas que Miff guarda en tu teléfono para el reparto de tu tiempo. No cambia nada para tus seres queridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les arrivées et départs que Miff garde sur ton téléphone pour la répartition de ton temps. Cela ne change rien pour tes proches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella gli arrivi e le partenze che Miff conserva sul tuo telefono per la ripartizione del tuo tempo. Per i tuoi cari non cambia nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga as chegadas e saídas que a Miff guarda no teu telemóvel para a distribuição do teu tempo. Isto não altera nada para os teus entes queridos."
          }
        }
      }
    },
