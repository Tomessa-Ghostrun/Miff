    "settings_delete_apple_android_info": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist auch mit Apple verknüpft. Von Android aus können wir diese Berechtigung nicht entfernen: Am Ende erklären wir dir, wie du das in den Einstellungen deiner Apple-ID machst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is also linked to Apple. From Android we can’t remove that authorization: at the end, we’ll explain how to do it in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta también está vinculada a Apple. Desde Android no podemos retirar esa autorización: al final te explicamos cómo hacerlo en los ajustes de tu ID de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte est aussi lié à Apple. Depuis Android, on ne peut pas retirer cette autorisation : à la fin, on t’explique comment le faire dans les réglages de ton identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è collegato anche ad Apple. Da Android non possiamo revocare questa autorizzazione: alla fine ti spieghiamo come farlo nelle impostazioni del tuo ID Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta também está associada à Apple. A partir do Android, não conseguimos retirar essa autorização: no fim, explicamos-te como o fazer nas definições do teu ID Apple."
          }
        }
      }
    },
    "settings_delete_apple_howto_step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Einstellungen deiner Apple-ID (appleid.apple.com oder Einstellungen auf einem iPhone)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your Apple ID settings (appleid.apple.com, or Settings on an iPhone)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los ajustes de tu ID de Apple (appleid.apple.com o Ajustes en un iPhone)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les réglages de ton identifiant Apple (appleid.apple.com ou Réglages sur un iPhone)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri le impostazioni del tuo ID Apple (appleid.apple.com oppure Impostazioni su un iPhone)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as definições do teu ID Apple (appleid.apple.com ou Definições num iPhone)."
          }
        }
      }
    },
    "settings_delete_apple_howto_step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe zu „Anmeldung & Sicherheit“ und dann zu „Mit Apple anmelden“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to “Sign-In & Security”, then “Sign in with Apple”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a «Inicio de sesión y seguridad» y luego a «Iniciar sesión con Apple»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va dans « Connexion et sécurité », puis « Se connecter avec Apple »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai su «Accesso e sicurezza», poi su «Accedi con Apple»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a «Início de sessão e segurança» e depois a «Iniciar sessão com a Apple»."
          }
        }
      }
    },
    "settings_delete_apple_howto_step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Miff und beende dann die Verwendung der Apple-ID mit dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Miff, then stop using Apple ID with this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Miff y deja de usar el ID de Apple con esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Miff, puis arrête d’utiliser l’identifiant Apple avec cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Miff, poi smetti di usare l’ID Apple con questa app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe a Miff e deixa de usar o ID Apple com esta app."
