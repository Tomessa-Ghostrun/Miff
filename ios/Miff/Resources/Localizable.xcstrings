    "permission_notifications_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sagen dir nur Bescheid, wenn es nützlich ist!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll only let you know when it's useful!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te avisamos solo cuando sea útil!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévenir, seulement quand c'est utile !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisiamo solo quando serve!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos-te só quando for útil!"
          }
        }
      }
    },
    "ios_permission_notifications_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff benachrichtigt dich auch, wenn eine dir nahestehende Person sich meldet. Dafür speichert Miff eine technische Kennung deines Telefons, die Apple für den Versand der Benachrichtigungen bereitstellt. Du kannst alles jederzeit in den Einstellungen deines Telefons ausschalten. Die Beispiele oben zeigen, was du bekommen könntest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff also lets you know when someone in your circle checks in. For this, Miff saves a technical identifier of your phone, provided by Apple to send notifications. You can turn it all off at any time in your phone's settings. The examples above show what you could receive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff también te avisa cuando un ser querido da noticias. Para ello, Miff guarda un identificador técnico de tu teléfono, proporcionado por Apple para enviar las notificaciones. Puedes desactivarlo todo en cualquier momento en los ajustes de tu teléfono. Los ejemplos de arriba muestran lo que podrías recibir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff te prévient aussi quand un proche donne des nouvelles. Pour cela, Miff enregistre un identifiant technique de ton téléphone, fourni par Apple pour envoyer les notifications. Tu peux tout couper à tout moment dans les réglages de ton téléphone. Les exemples ci-dessus montrent ce que tu pourrais recevoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ti avvisa anche quando una persona cara dà notizie. Per farlo, Miff registra un identificativo tecnico del tuo telefono, fornito da Apple per inviare le notifiche. Puoi disattivare tutto in qualsiasi momento nelle impostazioni del tuo telefono. Gli esempi qui sopra mostrano cosa potresti ricevere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff também te avisa quando um ente querido dá notícias. Para isso, a Miff guarda um identificador técnico do teu telemóvel, fornecido pela Apple para enviar as notificações. Podes desativar tudo a qualquer momento nas definições do telemóvel. Os exemplos acima mostram o que poderias receber."
          }
        }
      }
    },
    "permission_notifications_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beispiele oben zeigen, was du bekommen könntest. Du kannst alles jederzeit in den Einstellungen deines Telefons ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The examples above show what you could receive. You can turn everything off at any time in your phone's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejemplos de arriba muestran lo que podrías recibir. Puedes desactivarlo todo en cualquier momento en los ajustes de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exemples ci-dessus montrent ce que tu pourrais recevoir. Tu peux tout couper à tout moment dans les réglages de ton téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esempi qui sopra mostrano cosa potresti ricevere. Puoi disattivare tutto in qualsiasi momento nelle impostazioni del tuo telefono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exemplos acima mostram o que poderias receber. Podes desativar tudo a qualquer momento nas definições do telemóvel."
          }
        }
      }
    },
    "permission_notifications_action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        }
      }
    },
    "permission_location_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissen, dass es dir gut geht!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know that you're okay!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Saber que estás bien!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savoir que tu vas bien !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapere che stai bene!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber que estás bem!"
          }
        }
      }
    },
    "permission_location_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff braucht deinen Standort, damit deine Liebsten wissen, dass es dir gut geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs your location so your loved ones know you're doing well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff necesita tu ubicación para que tus seres queridos sepan que estás bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin de ta localisation pour que tes proches sachent que tu vas bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha bisogno della tua posizione per permettere ai tuoi cari di sapere che stai bene."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff precisa da tua localização para que os teus entes queridos saibam que estás bem."
          }
        }
      }
    },
    "permission_location_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff erfasst den Standort deines Telefons, auch im Hintergrund und selbst dann, wenn die App geschlossen ist oder du sie nicht benutzt. So erkennt Miff, wann du an einem vertrauten Ort ankommst oder ihn verlässt, und deine Miff sieht deinen Status und deinen letzten bekannten Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff collects your phone's location data, including in the background, even when the app is closed or not in use, to detect when you arrive at or leave a trusted place and to let your Miff see your status and your last known location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff recopila la ubicación de tu teléfono, también en segundo plano, incluso cuando la app está cerrada o no la estás usando, para detectar cuándo llegas a un lugar de confianza o sales de él, y para que tu Miff vea tu estado y tu última ubicación conocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff collecte la localisation de ton téléphone, y compris en arrière-plan, même quand l'app est fermée ou que tu ne l'utilises pas, pour repérer quand tu arrives dans un lieu de confiance ou que tu le quittes et pour que ta Miff voie ton statut et ta dernière position connue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff raccoglie la posizione del tuo telefono, anche in background, anche quando l’app è chiusa o non la stai usando, per rilevare quando arrivi in un luogo di fiducia o quando lo lasci, e perché la tua Miff veda il tuo stato e la tua ultima posizione nota."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff recolhe a localização do teu telemóvel, também em segundo plano, mesmo quando a app está fechada ou não a estás a usar, para detetar quando chegas a um local de confiança ou quando sais dele, e para que a tua Miff veja o teu estado e a tua última localização conhecida."
          }
        }
      }
    },
    "permission_location_closed_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch bei geschlossener App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when the app is closed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso con la app cerrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même quand l'app est fermée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche quando l’app è chiusa"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com a app fechada"
          }
        }
      }
    },
    "permission_location_closed_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff erkennt, wann du an deinen Orten ankommst oder sie verlässt, ohne dass du die App öffnen musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff notices when you arrive at or leave your places, without you having to open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff detecta cuándo llegas a tus lugares o sales de ellos, sin que tengas que abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff repère quand tu arrives ou pars de tes lieux, sans que tu aies à ouvrir l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff rileva quando arrivi nei tuoi luoghi o ne esci, senza che tu debba aprire l’app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff deteta quando chegas aos teus locais ou sais deles, sem teres de abrir a app."
          }
        }
      }
    },
    "permission_location_seen_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sehen deine Liebsten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your loved ones see"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ven tus seres queridos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que voient tes proches"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vedono i tuoi cari"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que os teus entes queridos veem"
          }
        }
      }
    },
    "permission_location_seen_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitglieder deiner Miff, die ebenfalls teilen, sehen deinen Status (zum Beispiel „Zu Hause“) und deinen letzten bekannten Standort, mit Uhrzeit. Auf unseren Servern gibt es keinen Verlauf deiner Wege."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The members of your Miff who also share see your status (for example \"at home\") and your last known location, with the time. No history of trips on our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros de tu Miff que también comparten ven tu estado (por ejemplo, «en casa») y tu última ubicación conocida, con la hora. Sin historial de trayectos en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres de ta Miff qui partagent aussi voient ton statut (par exemple « à la maison ») et ta dernière position connue, avec l'heure. Aucun historique de trajets sur nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I membri della tua Miff che condividono a loro volta vedono il tuo stato (per esempio «a casa») e la tua ultima posizione nota, con l’orario. Nessuna cronologia dei percorsi sui nostri server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os membros da tua Miff que também partilham veem o teu estado (por exemplo, «em casa») e a tua última localização conhecida, com a hora. Nenhum histórico de trajetos nos nossos servidores."
          }
        }
      }
    },
    "permission_location_local_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For you only"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour toi seul(e)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per te"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para ti"
          }
        }
      }
    },
    "permission_location_local_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf deinem Telefon notiert Miff außerdem, wann du an deinen Orten ankommst und sie verlässt, um dir zu zeigen, wie sich deine Zeit verteilt. Es wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your phone only, Miff also notes your arrivals and departures to show you how your time is spread. Nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en tu teléfono, Miff también anota tus llegadas y salidas para mostrarte cómo se reparte tu tiempo. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ton téléphone seulement, Miff note aussi tes arrivées et départs pour te montrer comment ton temps se répartit. Rien n'est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo sul tuo telefono, Miff annota anche i tuoi arrivi e le tue partenze per mostrarti come si ripartisce il tuo tempo. Non viene inviato nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas no teu telemóvel, a Miff regista também as tuas chegadas e saídas para te mostrar como se distribui o teu tempo. Nada é enviado."
          }
        }
      }
    },
    "permission_location_control_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stay in control"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gardes la main"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi tu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu decides"
          }
        }
      }
    },
    "permission_location_control_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das Teilen mit einer Miff jederzeit beenden. Dein Standort wird dann gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop sharing with a Miff at any time. Your location is then erased."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes dejar de compartir con una Miff en cualquier momento. Tu ubicación se borra entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux arrêter de partager avec une Miff à tout moment. Ta position est alors effacée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi smettere di condividere con una Miff in qualsiasi momento. A quel punto la tua posizione viene cancellata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes deixar de partilhar com uma Miff a qualquer momento. A tua localização é então apagada."
          }
        }
      }
    },
    "permission_location_action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer erlauben"
