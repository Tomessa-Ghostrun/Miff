    "permission_location_step_3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Immer zulassen“ und lass „Genauen Standort verwenden“ eingeschaltet"
          }
        },
        "en": {
