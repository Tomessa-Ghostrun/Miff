    "ios_place_message_id_taken": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ort hat sich geändert, während du das Formular ausgefüllt hast. Schließe es und öffne es erneut, dann versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place changed while you were filling in the form. Close it and open it again, then try once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lugar ha cambiado mientras completabas el formulario. Ciérralo, ábrelo de nuevo e inténtalo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieu a changé pendant que tu remplissais le formulaire. Ferme-le et rouvre-le, puis réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un luogo è cambiato mentre compilavi il modulo. Chiudilo e riaprilo, poi riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um local mudou enquanto preenchias o formulário. Fecha-o e volta a abri-lo, depois tenta novamente."
          }
        }
      }
    },
