    "feed_colors_changes_arrive": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankunft an einem vertrauten Ort: sofort Grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriving at a trusted place: green right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegar a un lugar de confianza: verde al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriver dans un lieu de confiance : vert tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivare in un luogo di fiducia: verde subito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegar a um local de confiança: verde de imediato."
          }
