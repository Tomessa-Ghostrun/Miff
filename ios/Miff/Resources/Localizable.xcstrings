    "about_licenses_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff baut auf freier Software und freien Daten auf. Danke an alle, die sie entwickeln. Hier siehst du, was wir verwenden und unter welcher Lizenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff relies on free software and data. Thank you to everyone who creates them. Here is what we use, and under which license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff se apoya en software y datos libres. Gracias a quienes los crean. Esto es lo que usamos y con qué licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff s'appuie sur des logiciels et des données libres. Merci à celles et ceux qui les créent. Voici ce que nous utilisons, et sous quelle licence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff si appoggia a software e dati liberi. Grazie a chi li crea. Ecco cosa usiamo e con quale licenza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff assenta em software e dados livres. Agradecemos a quem os cria. Eis o que usamos e ao abrigo de que licença."
          }
        }
      }
    },
