    "diag_test1_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run test 1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer le test 1"
          }
        }
      }
    },
    "diag_test1_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to read a Miff without being signed in. The expected answer is a refusal. If you were signed in, you are signed out first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie de lire une Miff sans être connecté. La réponse attendue est un refus. Si vous étiez connecté, vous êtes d'abord déconnecté."
          }
        }
      }
    },
    "diag_test1_inconclusive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test could not be completed this time. Try again a bit later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test n'a pas pu aboutir cette fois. Réessayez un peu plus tard."
          }
        }
      }
    },
    "diag_test1_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection for now. Try again when the network is back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion pour le moment. Réessayez dès que le réseau est revenu."
          }
        }
      }
    },
    "diag_test1_ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules active: OK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles actives : OK"
          }
        }
      }
    },
    "diag_test1_ok_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused the read without sign-in, as expected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé la lecture sans connexion, comme prévu."
          }
        }
      }
    },
    "diag_test1_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: the read worked without signing in. The rules look open. Please do not continue and tell the team."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : la lecture a fonctionné sans être connecté. Les règles semblent ouvertes. Merci de ne pas continuer et de prévenir l'équipe."
          }
        }
      }
    },
