    "settings_delete_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten das Löschen nicht abschließen. Versuch es in einem Moment noch einmal. Wenn es weiterhin nicht klappt, schreib uns: %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t finish the deletion. Please try again in a moment. If it keeps happening, write to us: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido terminar la eliminación. Inténtalo de nuevo en un momento. Si sigue pasando, escríbenos: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On n’a pas pu terminer la suppression. Réessaie dans un moment. Si ça continue, écris-nous : %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile completare l’eliminazione. Riprova tra un momento. Se il problema continua, scrivici: %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos concluir a eliminação. Tenta novamente daqui a pouco. Se continuar a acontecer, escreve-nos: %1$@."
          }
        }
      }
    },
