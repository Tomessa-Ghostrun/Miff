    "settings_delete_sub_body_unknown": {
      "extractionState": "manual",
      "comment": "Phrase prudente quand le serveur n'a pas pu dire s'il y a un abonnement (hors connexion) : jamais de silence sur un abonnement qui continue d'être facturé.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls du ein Miff+-Abonnement hast, wird es durch das Löschen deines Kontos nicht gekündigt. Damit nichts mehr abgebucht wird, kündige es bei Google Play oder im App Store, wo du es abgeschlossen hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have a Miff+ subscription, deleting your account does not cancel it. To stop being charged, cancel it in Google Play or the App Store, wherever you took it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una suscripción de Miff+, eliminar tu cuenta no la cancela. Para que dejen de cobrarte, cancélala en Google Play o en la App Store, donde la contrataste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as un abonnement Miff+, supprimer ton compte ne le résilie pas. Pour ne plus être facturé, résilie-le dans Google Play ou dans l'App Store, là où tu l'as souscrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai un abbonamento Miff+, eliminare il tuo account non lo annulla. Per interrompere gli addebiti, annullalo su Google Play o nell’App Store, dove lo hai sottoscritto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tens uma subscrição Miff+, eliminar a tua conta não a cancela. Para não haver mais cobranças, cancela-a no Google Play ou na App Store, onde a fizeste."
          }
        }
      }
    },
    "settings_delete_sub_trial": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase läuft weiter, bis du sie kündigst: Wenn sie endet, beginnt das Jahresabonnement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial continues until you cancel it: when it ends, the annual subscription starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita continúa hasta que la canceles: al terminar, empieza la suscripción anual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai gratuit se poursuit tant que tu ne l'as pas résilié : à sa fin, l'abonnement annuel démarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita prosegue finché non la annulli: al termine inizia l’abbonamento annuale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu teste gratuito continua até o cancelares: quando terminar, começa a subscrição anual."
          }
        }
      }
