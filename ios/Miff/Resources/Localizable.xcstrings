    "miff_sharing_stop_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Status, dein Foto und dein letzter Standort werden für diesen Kreis gelöscht. Du kannst jederzeit wieder teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your status, photo and last known location will be deleted for this circle. You can resume whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estado, tu foto y tu última ubicación se eliminarán para este círculo. Podrás volver a compartir cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton statut, ta photo et ta dernière position seront supprimés pour ce cercle. Tu pourras reprendre quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo stato, la tua foto e la tua ultima posizione verranno eliminati per questa cerchia. Potrai riprendere quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu estado, a tua foto e a tua última localização serão eliminados para este círculo. Poderás retomar quando quiseres."
          }
        }
      }
    },
