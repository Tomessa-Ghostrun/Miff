    "feed_colors_miff_red_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine Person steht auf Rot. Die Blase zeigt dir, um wen es geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one person is red. The bubble tells you who."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una persona está en rojo. La burbuja te dice de quién se trata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une personne est rouge. La bulle te dit de qui il s'agit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno una persona è rossa. La bolla ti dice chi è."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma pessoa está a vermelho. A bolha diz-te quem é."
          }
        }
      }
    },
    "feed_colors_miff_gray_title": {
      "extractionState": "manual",
      "localizations": {
