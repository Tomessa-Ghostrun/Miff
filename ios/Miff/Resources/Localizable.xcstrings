    "feed_colors_miff_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die große Blase oben im Feed. Die Blase fasst die Farben aller zusammen, auch deine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the big bubble at the top of your feed. It sums up everyone's color, yours included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la burbuja grande de la parte superior del Feed. Resume el color de cada persona, incluido el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la grande bulle en haut du fil. Elle résume la couleur de chacun, y compris la tienne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È la grande bolla in cima al Feed. Riassume il colore di ciascuno, compreso il tuo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É a grande bolha no topo do Feed. Resume a cor de cada pessoa, incluindo a tua."
          }
        }
      }
    },
    "feed_colors_miff_green_title": {
      "extractionState": "manual",
      "localizations": {
