    "notif_n6a_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du dort bist, sehen deine Liebsten einen anderen Status."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're there, your circle sees a different status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras estás ahí, tus seres queridos ven un estado distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que tu es dans cette zone, tes proches voient un état différent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché ci sei, i tuoi cari vedono uno stato diverso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto lá estás, os teus entes queridos veem um estado diferente."
          }
        }
      }
    },
    "notif_prime_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, nur wenn es nützlich ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder, only when it helps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio, solo cuando es útil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel, seulement quand c'est utile"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria, solo quando serve"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete, só quando é útil"
          }
        }
      }
    },
    "notif_prime_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls du mal nicht dazu kommst, dich zu melden, erinnert Miff dich sanft daran und sagt dir Bescheid, wenn der Status deiner Miff auf Orange oder Rot wechselt. Was du bekommst, kannst du in den Einstellungen festlegen, und du kannst jederzeit alles ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't have time to check in, Miff gently reminds you, and lets you know when your Miff turns orange or red. You can adjust what you get in the settings, and turn everything off at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no tienes tiempo para dar noticias, Miff te lo recuerda con suavidad, y te avisa cuando tu Miff pasa a naranja o a rojo. Puedes elegir lo que recibes en los ajustes, y desactivarlo todo en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu n'as pas le temps de donner de tes nouvelles, Miff te le rappelle doucement, et te prévient quand ta Miff passe à l'orange ou au rouge. Tu peux régler ce que tu reçois dans les réglages, et tout couper à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non hai tempo di dare notizie, Miff te lo ricorda con delicatezza e ti avvisa quando la tua Miff passa all’arancione o al rosso. Puoi scegliere cosa ricevere nelle impostazioni e disattivare tutto in qualsiasi momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se não tiveres tempo para dar notícias, a Miff lembra-te com delicadeza e diz-te quando a tua Miff passa a laranja ou a vermelho. Podes escolher o que recebes nas definições e desativar tudo a qualquer momento."
          }
        }
      }
    },
    "notif_prime_allow": {
