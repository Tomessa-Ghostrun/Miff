    "profile_timeshare_location_needed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Zeit an deinen Orten zu messen, braucht Miff den Standortzugriff „Immer“ mit genauem Standort. Du kannst auch ohne weitermachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To measure your time in your places, Miff needs the \"Always\" location with precise position. You can also carry on without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para medir tu tiempo en tus lugares, Miff necesita la ubicación en «Siempre» y con precisión. También puedes continuar sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour mesurer ton temps dans tes lieux, Miff a besoin de la localisation « Toujours » avec la position précise. Tu peux aussi continuer sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per misurare il tempo che passi nei tuoi luoghi, Miff ha bisogno della posizione su «Sempre», con la posizione precisa. Puoi anche continuare senza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para medir o teu tempo nos teus locais, a Miff precisa da localização «Sempre» com a localização precisa. Também podes continuar sem isso."
          }
        }
      }
    },
