    "auth_reset_resend_wait": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst in wenigen Augenblicken eine neue E-Mail anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask for a new e-mail in a few moments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pedir otro correo en unos instantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux demander un nouvel e-mail dans quelques instants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai richiedere una nuova e-mail tra qualche istante."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes pedir um novo e-mail dentro de alguns instantes."
          }
        }
      }
    },
    "auth_reset_sent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es zu dieser Adresse ein Konto gibt, wurde gerade eine E-Mail gesendet. Schau am besten auch in deinem Spam-Ordner nach. Falls du dich mit Apple oder Google registriert hast, nutze stattdessen die passende Schaltfläche auf dem Anmeldebildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists with this address, an e-mail has just been sent. Remember to check your spam folder. If you signed up with Apple or Google, use the matching button on the sign-in screen instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con esta dirección, se acaba de enviar un correo. Echa un vistazo también a tu carpeta de correo no deseado. Si te registraste con Apple o con Google, usa mejor el botón correspondiente en la pantalla de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe avec cette adresse, un e-mail vient d'être envoyé. Pense à regarder dans tes courriers indésirables. Si tu as créé ton compte avec Apple ou Google, utilise plutôt le bouton correspondant sur l'écran de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esiste un account con questo indirizzo, ti abbiamo appena inviato un’e-mail. Dai un’occhiata anche nella posta indesiderata. Se hai creato l’account con Apple o Google, usa invece il pulsante corrispondente nella schermata di accesso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta com este endereço, acabou de ser enviado um e-mail. Vê também a pasta de spam. Se te registaste com a Apple ou o Google, usa antes o botão correspondente no ecrã de início de sessão."
          }
        }
      }
    },
    "auth_reset_title": {
      "extractionState": "manual",
