    "alert_info_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Schaltfläche 5 Sekunden lang gedrückt, um deinen Liebsten Bescheid zu geben. Dann erhalten sie eine Benachrichtigung und sehen deine Karte oben in ihrer Miff. Die Warnung dauert höchstens 7 Tage; du kannst sie jederzeit beenden. Eine Benachrichtigung kann verspätet oder gar nicht ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the button for 5 seconds to let your circle know. They get a notification and see your card at the top of their Miff. The alert lasts at most 7 days; you can end it any time. A notification may arrive late or not at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón 5 segundos para avisar a tus seres queridos. Reciben una notificación y ven tu tarjeta en la parte superior de su Miff. La alerta dura 7 días como máximo; puedes terminarla en cualquier momento. Una notificación puede llegar con retraso o no llegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens le bouton 5 secondes pour prévenir tes proches. Ils reçoivent une notification et voient ta carte en haut de leur Miff. L'alerte dure 7 jours au plus ; tu peux la terminer à tout moment. Une notification peut arriver en retard ou ne pas arriver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il pulsante per 5 secondi per avvisare i tuoi cari. Ricevono una notifica e vedono la tua scheda in cima alla loro Miff. L’allerta dura al massimo 7 giorni; puoi terminarla in qualsiasi momento. Una notifica può arrivare in ritardo o non arrivare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o botão premido durante 5 segundos para avisar os teus entes queridos. Recebem uma notificação e veem o teu cartão no topo da Miff deles. O alerta dura 7 dias, no máximo; podes terminá-lo a qualquer momento. Uma notificação pode chegar com atraso ou não chegar."
          }
        }
      }
    },
    "alert_info_position": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird wie gewohnt geteilt: eine einzige Messung beim Senden, sichtbar für die Liebsten, die ebenfalls ihren Standort teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is shared as usual: one single measure when the alert is sent, visible to the people who share theirs too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se comparte como siempre: una sola medición en el momento del envío, visible para los seres queridos que también comparten la suya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position est partagée comme d'habitude : une seule mesure au moment de l'envoi, visible par les proches qui partagent aussi la leur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione viene condivisa come al solito: una sola rilevazione al momento dell’invio, visibile ai tuoi cari che condividono a loro volta la propria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua localização é partilhada como de costume: uma única medição no momento do envio, visível para os entes queridos que também partilham a sua."
          }
        }
      }
    },
    "alert_info_close": {
