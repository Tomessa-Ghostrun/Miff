    "auth_reset_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die E-Mail-Adresse deines Kontos ein. Wenn sie zu einem Konto gehört, erhältst du einen Link, um ein neues Passwort festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the e-mail address of your account. If it matches an account, you will receive a link to choose a new password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la dirección de correo electrónico de tu cuenta. Si corresponde a una cuenta, recibirás un enlace para elegir una contraseña nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l'adresse e-mail de ton compte. Si elle correspond à un compte, tu recevras un lien pour choisir un nouveau mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica l’indirizzo e-mail del tuo account. Se corrisponde a un account, riceverai un link per scegliere una nuova password."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica o endereço de e-mail da tua conta. Se corresponder a uma conta, vais receber um link para escolheres uma nova palavra-passe."
          }
        }
      }
    },
    "auth_reset_resend_action": {
      "extractionState": "manual",
      "localizations": {
