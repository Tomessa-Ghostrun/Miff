        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Queres guardar uma cópia dos teus dados? Escreve-nos antes de eliminares a tua conta: %1$@."
          }
        }
      }
    },
    "settings_delete_done_apple_android": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto war mit Apple verknüpft. Du kannst die Berechtigung in den Einstellungen deiner Apple-ID entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was linked to Apple. You can remove the authorization in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta estaba vinculada a Apple. Puedes retirar la autorización en los ajustes de tu ID de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte était lié à Apple. Tu peux retirer l’autorisation dans les réglages de ton identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account era collegato ad Apple. Puoi revocare l’autorizzazione nelle impostazioni del tuo ID Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta estava associada à Apple. Podes retirar a autorização nas definições do teu ID Apple."
          }
        }
      }
    },
    "settings_delete_done_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du ein Stück des Weges mit Miff gegangen bist. Du kannst jederzeit zurückkommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for spending some time with Miff. You can come back whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por haber recorrido un trozo de camino con Miff. Podrás volver cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d’avoir fait un bout de chemin avec Miff. Tu pourras revenir quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver fatto un pezzo di strada con Miff. Potrai tornare quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agradecemos o caminho que fizeste com a Miff. Podes voltar quando quiseres."
          }
