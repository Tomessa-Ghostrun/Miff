    "notif_settings_night_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von 22 bis 7 Uhr ohne Ton und Vibration, außer wenn jemand auf Rot wechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From 10 pm to 7 am, no sound or vibration, except when someone turns red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 22:00 a 7:00, sin sonido ni vibración, salvo cuando un estado pasa a rojo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 22 h à 7 h, ni son ni vibration, sauf pour un passage au rouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalle 22 alle 7, senza suono né vibrazione, tranne quando qualcuno passa al rosso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De 22:00 a 7:00, sem som nem vibração, exceto quando alguém passa a vermelho."
          }
        }
      }
    },
