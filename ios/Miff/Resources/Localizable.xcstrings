    "auth_reset_resend_wait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask for a new e-mail in a few moments."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux demander un nouvel e-mail dans quelques instants."
