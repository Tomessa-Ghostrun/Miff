    "auth_error_google_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Google hat nicht geklappt. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Google did not go through. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido completar el inicio de sesión con Google. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Google n'a pas abouti. Réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso con Google non è andato a buon fine. Riprova tra un momento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão com o Google não foi concluído. Tenta novamente daqui a pouco."
          }
        }
      }
    },
    "auth_error_google_no_account": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google konnte auf diesem Telefon gerade kein Konto anbieten. Du kannst in den Einstellungen des Telefons eines hinzufügen oder mit deiner E-Mail-Adresse weitermachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google could not offer an account on this phone for now. You can add one in the phone settings, or continue with your e-mail address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google no ha podido ofrecer una cuenta en este teléfono por ahora. Puedes añadir una en los ajustes del teléfono, o continuar con tu dirección de correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google n'a pas pu proposer de compte sur ce téléphone pour le moment. Tu peux en ajouter un dans les réglages du téléphone, ou continuer avec ton adresse e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google non ha potuto proporre un account su questo telefono al momento. Puoi aggiungerne uno nelle impostazioni del telefono, oppure continuare con il tuo indirizzo e-mail."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google não conseguiu propor uma conta neste telemóvel de momento. Podes adicionar uma nas definições do telemóvel ou continuar com o teu endereço de e-mail."
          }
        }
      }
    },
    "auth_error_google_services": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Dienste reagieren auf diesem Telefon gerade nicht. Prüfe, ob sie auf dem neuesten Stand sind, oder mach mit deiner E-Mail-Adresse weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google services are not responding on this phone for now. Check that they are up to date, or continue with your e-mail address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de Google no responden en este teléfono por ahora. Comprueba que estén al día, o continúa con tu dirección de correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services Google ne répondent pas sur ce téléphone pour le moment. Vérifie qu'ils sont à jour, ou continue avec ton adresse e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi Google non rispondono su questo telefono al momento. Controlla che siano aggiornati, oppure continua con il tuo indirizzo e-mail."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os serviços Google não estão a responder neste telemóvel de momento. Verifica se estão atualizados ou continua com o teu endereço de e-mail."
          }
        }
      }
    },
    "auth_error_invalid_credentials": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination funktioniert nicht. Prüfe deine E-Mail-Adresse und dein Passwort oder wähle „Passwort vergessen?“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination does not work. Check your e-mail address and your password, or choose “Forgot password?”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación no funciona. Comprueba tu dirección de correo electrónico y tu contraseña, o elige «¿Has olvidado tu contraseña?»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison ne fonctionne pas. Vérifie ton adresse e-mail et ton mot de passe, ou choisis « Mot de passe oublié ? »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa combinazione non funziona. Controlla il tuo indirizzo e-mail e la password, oppure scegli «Hai dimenticato la password?»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinação não funciona. Verifica o teu endereço de e-mail e a tua palavra-passe, ou escolhe «Esqueceste-te da palavra-passe?»."
          }
        }
      }
    },
