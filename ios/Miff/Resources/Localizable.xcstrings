    "permission_location_error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff braucht die Option „Immer zulassen“ und den genauen Standort, um zu funktionieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs the \"Allow all the time\" option and precise location to work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff necesita la opción «Permitir siempre» y la ubicación precisa para funcionar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin de l'option toujours autoriser et de la précision exacte pour fonctionner"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha bisogno che la posizione sia consentita sempre e in modo preciso per funzionare"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff precisa da opção «Permitir sempre» e da localização precisa para funcionar"
          }
        }
      }
    },
    "permission_location_error_calm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Entscheidung jederzeit in den Einstellungen deines Telefons ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this choice at any time in your phone settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esta elección en cualquier momento en los ajustes de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer ce choix à tout moment dans les réglages de ton téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare questa scelta in qualsiasi momento nelle impostazioni del telefono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterar esta escolha a qualquer momento nas definições do telemóvel."
          }
        }
      }
    },
    "permission_location_steps_error_calm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst so oft zurückkommen, wie du brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can come back to it as many times as you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver aquí tantas veces como necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux y revenir autant de fois que nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi tornarci tutte le volte che serve."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes voltar aqui as vezes que precisares."
          }
        }
      }
    },
    "permission_location_steps_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff braucht Zugriff auf deinen Standort im Hintergrund, auch wenn die App geschlossen ist, um zu funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs access to your location in the background, even when the app is closed, to work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff necesita acceder a tu ubicación en segundo plano, incluso con la app cerrada, para funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin d'accéder à ta localisation en arrière-plan, même quand l'app est fermée, pour fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff ha bisogno di accedere alla tua posizione in background, anche quando l’app è chiusa, per funzionare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Miff precisa de aceder à tua localização em segundo plano, mesmo com a app fechada, para funcionar."
          }
        }
      }
    },
    "permission_location_step_1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Schaltfläche: Die Einstellungen von Miff öffnen sich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button: the Miff settings open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón: se abren los ajustes de Miff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le bouton : les paramètres de Miff s'ouvrent"
          }
        },
        "it": {
          "stringUnit": {
