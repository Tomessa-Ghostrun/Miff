    "settings_delete_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und deine Miff-Daten werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and your Miff data will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y tus datos de Miff se eliminarán. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte et tes données Miff seront supprimés. Ce n’est pas réversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account e i tuoi dati Miff verranno eliminati. Non si può annullare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua conta e os teus dados da Miff serão eliminados. Não pode ser anulado."
          }
        }
      }
    },
