    "settings_subscription_ends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Miff+ gekündigt: Es bleibt bis zum %1$@ aktiv, ohne Verlängerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled Miff+: it stays active until %1$@, without renewal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cancelado Miff+: sigue activo hasta el %1$@, sin renovación."
          }
        },
        "fr": {
          "stringUnit": {
