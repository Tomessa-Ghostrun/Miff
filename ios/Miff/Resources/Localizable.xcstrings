    "settings_my_info_load_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir können deine Informationen gerade nicht anzeigen. Prüfe deine Verbindung und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't show your information right now. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conseguimos mostrar tus datos por ahora. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'arrivons pas à afficher tes informations pour le moment. Vérifie ta connexion puis réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non riusciamo a mostrare le tue informazioni. Controlla la connessione e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De momento, não conseguimos mostrar as tuas informações. Verifica a tua ligação e tenta novamente."
          }
        }
      }
    },
