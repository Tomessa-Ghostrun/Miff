    "place_detail_info_danger": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diese Zone betrittst, steht dein Status für deine Miff auf Rot. Wenn du dich meldest, steht er für 1 Std. wieder auf Grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you enter this zone, your status turns red for your Miff. If you share news, it goes back to green for 1 hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando entras en esta zona, tu estado pasa a rojo para tu Miff. Si das noticias, vuelve a verde durante 1 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu entres dans cette zone, ton statut passe en rouge pour ta Miff. Si tu donnes de tes nouvelles, il repasse au vert pendant 1 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando entri in questa zona, il tuo stato diventa rosso per la tua Miff. Se dai notizie, torna verde per 1 ora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando entras nesta zona, o teu estado passa a vermelho para a tua Miff. Se deres notícias, volta a verde durante 1 h."
          }
        }
      }
    },
    "place_detail_info_trusted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du an diesem Ort ankommst oder ihn verlässt, sieht deine Miff deinen Status (zum Beispiel „Zu Hause“), auch wenn die App geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you arrive at or leave this place, your Miff sees your status (for example “at home”), even when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando llegas a este lugar o sales de él, tu Miff ve tu estado (por ejemplo, «en casa»), incluso con la app cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu arrives ou pars de ce lieu, ta Miff voit ton statut (par exemple « à la maison »), même quand l'app est fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arrivi in questo luogo o lo lasci, la tua Miff vede il tuo stato (per esempio «a casa»), anche quando l’app è chiusa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chegas a este local ou sais dele, a tua Miff vê o teu estado (por exemplo, «em casa»), mesmo com a app fechada."
          }
        }
      }
    },
