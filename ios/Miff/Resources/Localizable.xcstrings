    "feed_colors_changes_leave": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlassen eines vertrauten Ortes: Die Zeit beginnt zu laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving a trusted place: the clock starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de un lugar de confianza: empieza a contar el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter un lieu de confiance : le temps commence à compter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare un luogo di fiducia: il conteggio del tempo inizia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair de um local de confiança: o tempo começa a contar."
          }
        }
      }
    },
    "feed_colors_changes_news": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich melden: Die Zeit beginnt wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing news: the clock starts over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar noticias: el tiempo vuelve a empezar desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner des nouvelles : le temps repart de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dare notizie: il tempo riparte da zero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar notícias: o tempo recomeça do zero."
          }
        }
      }
    },
    "feed_colors_changes_time": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit ohne Neuigkeiten: Orange nach %1$@, Rot nach %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time passing without news: orange after %1$@, red after %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paso del tiempo sin noticias: naranja tras %1$@, rojo tras %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps qui passe sans nouvelles : orange après %1$@, rouge après %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo che passa senza notizie: arancione dopo %1$@, rosso dopo %2$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo que passa sem notícias: laranja ao fim de %1$@, vermelho ao fim de %2$@."
          }
        }
      }
    },
    "feed_colors_changes_pause": {
      "extractionState": "manual",
      "localizations": {
