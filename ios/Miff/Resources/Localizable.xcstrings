    "alert_banner_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte 5 Sekunden gedrückt, um die Warnung zu beenden. Deine Liebsten erfahren dann, dass du jetzt in Sicherheit bist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for 5 seconds to end the alert. Your loved ones will know you're now safe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado 5 segundos para poner fin a la alerta. Tus seres queridos sabrán que ya estás a salvo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens 5 secondes pour mettre fin à l'alerte, tes proches sauront que tu es désormais en sécurité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per 5 secondi per mettere fine all’allerta. I tuoi cari sapranno che ora sei al sicuro"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém premido durante 5 segundos para pôr fim ao alerta. Os teus entes queridos saberão que já estás em segurança"
          }
        }
      }
    },
