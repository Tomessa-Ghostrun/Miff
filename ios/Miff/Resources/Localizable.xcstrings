          "stringUnit": {
            "state": "translated",
            "value": "No account yet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de compte ?"
          }
        }
      }
    },
    "auth_signin_title": {
      "extractionState": "manual",
      "localizations": {
