    "feed_colors_miff_green_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, von denen es Neuigkeiten gibt, sind grün. Die Blase zeigt „Alles gut“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone we have news from is green. The bubble says “All good”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas de las que tenemos noticias están en verde. La burbuja dice «Todo va bien»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes dont on a des nouvelles sont vertes. La bulle dit « Tout va bien »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le persone di cui abbiamo notizie sono verdi. La bolla dice «Va tutto bene»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas de quem temos notícias estão a verde. A bolha diz «Está tudo bem»."
          }
        }
      }
    },
    "feed_colors_miff_orange_title": {
