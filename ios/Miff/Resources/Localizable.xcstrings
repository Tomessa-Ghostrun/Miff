        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode voyage n'a pas pu être mis à jour. Ta date de fin n'a pas changé, tu peux réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare la modalità viaggio. La data di fine non è cambiata, puoi riprovare più tardi."
