    },
    "settings_privacy_miff_waiting_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agreement is waiting: Miff no longer updates your status with this Miff. You can stop sharing from the Miff screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accord est en attente : Miff ne met plus à jour ton statut avec cette Miff. Tu peux arrêter de partager depuis l'écran de la Miff."
          }
        }
      }
    },
    "settings_privacy_detection_help_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If detections are slow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les détections tardent"
          }
        }
      }
    },
    "settings_detection_help_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If arrivals and departures are slow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les arrivées et départs tardent"
          }
        }
      }
    },
    "settings_detection_help_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some phones (Oppo, Xiaomi, Samsung, Huawei...) stop apps in the background to save battery. Miff may then notice an arrival or a departure late. These settings are optional: they may help, and Miff works without them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléphones (Oppo, Xiaomi, Samsung, Huawei...) arrêtent les applications en arrière-plan pour économiser la batterie. Miff peut alors repérer une arrivée ou un départ avec du retard. Ces réglages sont facultatifs : ils peuvent aider, et Miff fonctionne sans."
          }
        }
      }
    },
    "settings_detection_help_step_battery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. In the Miff settings, open \"Battery\" (or \"Power consumption\") and choose \"No restrictions\" (or \"Don't optimize\")."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Dans les réglages de Miff, ouvre « Batterie » (ou « Consommation d'énergie ») et choisis « Aucune restriction » (ou « Ne pas optimiser »)."
          }
        }
      }
    },
    "settings_detection_help_step_background": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Allow background activity for Miff if the phone offers it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Autorise l'activité en arrière-plan de Miff si le téléphone le propose."
          }
        }
      }
    },
    "settings_detection_help_step_autostart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. On Oppo, OnePlus or Realme (ColorOS): also allow Miff to \"auto-start\", and do not close it by swiping it away in the list of recent apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Sur Oppo, OnePlus ou Realme (ColorOS) : autorise aussi le « démarrage automatique » de Miff, et ne la ferme pas en la balayant dans la liste des applications récentes."
          }
        }
      }
    },
    "settings_detection_help_step_saver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. If you can, avoid keeping battery saver on all the time, especially while you are on the move."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Si possible, évite l'économiseur de batterie en continu, surtout pendant tes déplacements."
          }
        }
      }
    },
    "settings_detection_help_outro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact names of the settings change with the phone and the Android version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms exacts des réglages changent selon le téléphone et la version d'Android."
          }
        }
      }
    },
