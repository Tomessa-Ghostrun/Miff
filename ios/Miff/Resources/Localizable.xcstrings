            "state": "translated",
            "value": "Dein Profil, dein Foto und deine Telefonnummer werden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, photo and phone number will be deleted."
          }
        },
        "es": {
