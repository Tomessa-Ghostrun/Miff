    "ios_permission_location_approximate_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs your exact location, not an approximate area, to know when you arrive at or leave your places."
          }
