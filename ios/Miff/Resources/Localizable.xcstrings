    },
    "ios_permission_location_approximate_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen deinen genauen Standort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your exact location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos tu ubicación exacta"
          }
        },
        "fr": {
