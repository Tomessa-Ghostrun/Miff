    "settings_delete_irreversible": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Du kannst jederzeit ein neues Konto erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone. You can always create a new account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede deshacer. Siempre podrás crear una cuenta nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas réversible. Tu pourras toujours créer un nouveau compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Potrai sempre creare un nuovo account."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser anulado. Podes sempre criar uma conta nova."
          }
        }
      }
    },
    "settings_delete_loading": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Moment, wir prüfen deine Miffs…"
