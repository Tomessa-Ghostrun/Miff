    "diag_test2_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs in with the test account created in the Firebase console, reads your profile and plan documents, then signs out. Nothing is written. The details are typed here only: they are never stored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecte avec le compte de test créé dans la console Firebase, lit le profil et l'offre de ce compte, puis se déconnecte. Rien n'est écrit. Les identifiants sont saisis ici uniquement : ils ne sont jamais conservés."
          }
        }
      }
    },
