    "permission_notifications_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll only let you know when it's useful!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévenir, seulement quand c'est utile !"
          }
        }
      }
    },
    "permission_notifications_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, Miff doesn't send notifications yet. The examples above show what is planned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, Miff n'envoie pas encore de notification. Les exemples ci-dessus montrent ce qui est prévu."
          }
        }
      }
    },
    "permission_notifications_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser"
          }
        }
      }
    },
    "permission_location_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know that you're okay!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savoir que tu vas bien !"
          }
        }
      }
    },
    "permission_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs your location so your loved ones can know whether you're safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin de ta localisation pour permettre à tes proches de savoir que tu es ou non en sécurité."
          }
        }
      }
    },
    "permission_location_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff collects your phone's location data, including in the background, even when the app is closed or not in use, to detect when you arrive at or leave a trusted place and to let your Miff see your status and your last known location."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff collecte la localisation de ton téléphone, y compris en arrière-plan, même quand l'app est fermée ou que tu ne l'utilises pas, pour repérer quand tu arrives dans un lieu de confiance ou que tu le quittes et pour que ta Miff voie ton statut et ta dernière position connue."
          }
        }
      }
    },
    "permission_location_closed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when the app is closed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même quand l'app est fermée"
          }
        }
      }
    },
    "permission_location_closed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff notices when you arrive at or leave your places, without you having to open the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff repère quand tu arrives ou pars de tes lieux, sans que tu aies à ouvrir l'app."
          }
        }
      }
    },
    "permission_location_seen_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your loved ones see"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que voient tes proches"
          }
        }
      }
    },
    "permission_location_seen_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The members of your Miff who also share see your status (for example \"at home\") and your last known location, with the time. No history."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres de ta Miff qui partagent aussi voient ton statut (par exemple « à la maison ») et ta dernière position connue, avec l'heure. Pas d'historique."
          }
        }
      }
    },
    "permission_location_control_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stay in control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu gardes la main"
          }
        }
      }
    },
    "permission_location_control_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop sharing with a Miff at any time. Your location is then erased."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux arrêter de partager avec une Miff à tout moment. Ta position est alors effacée."
          }
        }
      }
    },
    "permission_location_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always allow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours autoriser"
          }
        }
      }
    },
    "permission_location_action_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location in the background"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser la localisation en arrière-plan"
          }
        }
      }
    },
    "permission_location_later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard"
          }
        }
      }
    },
    "permission_location_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs the \"Allow all the time\" option and precise location to work"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin de l'option toujours autoriser et de la précision exacte pour fonctionner"
          }
        }
      }
    },
    "permission_location_error_calm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this choice at any time in your phone settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer ce choix à tout moment dans les réglages de ton téléphone."
          }
        }
      }
    },
    "permission_location_steps_error_calm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can come back to it as many times as you need."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux y revenir autant de fois que nécessaire."
          }
        }
      }
    },
    "permission_location_steps_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff needs access to your location in the background, even when the app is closed, to work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff a besoin d'accéder à ta localisation en arrière-plan, même quand l'app est fermée, pour fonctionner."
          }
        }
      }
    },
    "permission_location_step_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button: the Miff settings open"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le bouton : les paramètres de Miff s'ouvrent"
          }
        }
      }
    },
    "permission_location_step_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Permissions, then Location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Autorisations, puis Position"
          }
        }
      }
    },
    "permission_location_step_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Allow all the time and keep Use precise location on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Autoriser tout le temps et garde Position précise activée"
          }
        }
      }
    },
    "miff_consent3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you share with this Miff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu partages avec cette Miff"
          }
        }
      }
    },
    "miff_consent3_create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By creating this Miff, you share your status and your last known location with its members; you can stop at any time in the Miff's settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En créant cette Miff, tu partages ton statut et ta dernière position connue avec ses membres ; tu peux arrêter à tout moment dans les réglages de la Miff."
          }
        }
      }
    },
    "miff_consent3_join": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By joining this Miff, you share your status and your last known location with its members; you can stop at any time in the Miff's settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En rejoignant cette Miff, tu partages ton statut et ta dernière position connue avec ses membres ; tu peux arrêter à tout moment dans les réglages de la Miff."
          }
        }
      }
    },
    "miff_consent3_resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are sharing your status and your last known location with the members of this Miff again; you can stop at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partages à nouveau ton statut et ta dernière position connue avec les membres de cette Miff ; tu peux arrêter à tout moment."
          }
        }
      }
    },
    "miff_consent3_kept_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last known location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dernière position connue"
          }
        }
      }
    },
    "miff_consent3_kept_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff only keeps your last known location, with the time it was measured. No history of trips: each location replaces the previous one. This is not live tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff garde seulement ta dernière position connue, avec l'heure de la mesure. Pas d'historique de trajets : chaque position remplace la précédente. Ce n'est pas un suivi en direct."
          }
        }
      }
    },
    "miff_consent3_who_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who sees it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui la voit"
          }
        }
      }
    },
    "miff_consent3_who_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the members of this Miff who also share theirs can see it. The creator has no extra rights."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les membres de cette Miff qui partagent aussi la leur la voient. Le créateur n'a pas de droit de plus."
          }
        }
      }
    },
    "miff_consent3_closed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when the app is closed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même quand l'app est fermée"
          }
        }
      }
    },
    "miff_consent3_closed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To do this, Miff uses your phone's location, even when the app is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour cela, Miff utilise la localisation de ton téléphone, même quand l'app est fermée."
          }
        }
      }
    },
    "miff_consent3_erase_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is erased"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacement de ta position"
          }
        }
      }
    },
    "miff_consent3_erase_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you stop sharing, leave the Miff or delete your account, your location is erased. After 24 h it is hidden and only its date remains visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu arrêtes de partager, quittes la Miff ou supprimes ton compte, ta position est effacée. Après 24 h, elle est masquée et seule sa date reste visible."
          }
        }
      }
    },
    "miff_consent3_members_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the members also see of you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les membres voient aussi de toi"
          }
        }
      }
    },
    "miff_consent3_members_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first name, last name, photo, phone number and battery level."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prénom, ton nom, ta photo, ton numéro de téléphone et ton niveau de batterie."
          }
        }
      }
    },
    "miff_consent3_places_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted places"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieux de confiance"
          }
        }
      }
    },
    "miff_consent3_places_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trusted places of this Miff are chosen by its creator and visible to all its members, address included."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux de confiance de cette Miff sont choisis par son créateur et visibles de tous ses membres, adresse comprise."
          }
        }
      }
    },
    "miff_consent3_system_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone will ask separately for access to your location. Miff needs the \"Always\" option to work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone te demandera séparément l'accès à ta position. Miff a besoin de l'option « Toujours » pour fonctionner."
          }
        }
      }
    },
    "miff_renewal_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clarification about what you share"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une précision sur ce que tu partages"
          }
        }
      }
    },
    "miff_renewal_intro_one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For \"%1$@\", Miff can now keep your last known location, with the time it was measured. The members of this Miff who also share theirs can see it. No history, never live, and it is erased if you stop sharing. To keep sharing with this Miff, we need your agreement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour « %1$@ », Miff peut maintenant garder ta dernière position connue, avec l'heure de la mesure. Les membres de cette Miff qui partagent aussi la leur peuvent la voir. Pas d'historique, jamais en direct, et elle est effacée si tu arrêtes de partager. Pour continuer à partager avec cette Miff, nous avons besoin de ton accord."
          }
        }
      }
    },
    "miff_renewal_intro_unnamed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this Miff, Miff can now keep your last known location, with the time it was measured. The members of this Miff who also share theirs can see it. No history, never live, and it is erased if you stop sharing. To keep sharing with this Miff, we need your agreement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour cette Miff, Miff peut maintenant garder ta dernière position connue, avec l'heure de la mesure. Les membres de cette Miff qui partagent aussi la leur peuvent la voir. Pas d'historique, jamais en direct, et elle est effacée si tu arrêtes de partager. Pour continuer à partager avec cette Miff, nous avons besoin de ton accord."
          }
        }
      }
    },
    "miff_renewal_intro_many": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your Miffs, Miff can now keep your last known location, with the time it was measured. The members of each Miff who also share theirs can see it. No history, never live, and it is erased if you stop sharing. To keep sharing with these Miffs, we need your agreement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour tes Miffs, Miff peut maintenant garder ta dernière position connue, avec l'heure de la mesure. Les membres de chaque Miff qui partagent aussi la leur peuvent la voir. Pas d'historique, jamais en direct, et elle est effacée si tu arrêtes de partager. Pour continuer à partager avec ces Miffs, nous avons besoin de ton accord."
          }
        }
      }
    },
    "miff_renewal_accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte"
          }
        }
      }
