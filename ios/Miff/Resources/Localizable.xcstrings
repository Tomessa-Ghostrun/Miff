    "settings_privacy_withdrawal_not_recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is switched off on this phone, even after a restart. Your choice will be saved as soon as the connection is back; you can also tap “Save my choice”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est coupé sur ce téléphone, même après un redémarrage. Ton choix sera enregistré dès que la connexion revient ; tu peux aussi toucher « Enregistrer mon choix »."
          }
        }
      }
    },
    "settings_title": {
