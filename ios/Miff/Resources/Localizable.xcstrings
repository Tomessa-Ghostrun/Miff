    "feed_colors_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben deiner Miff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Miff's colors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores de tu Miff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs de ta Miff"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori della tua Miff"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores da tua Miff"
          }
        }
      }
    },
    "feed_colors_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farben zeigen dir auf einen Blick, ob sich deine Liebsten zuletzt gemeldet haben. Das sind nur Orientierungspunkte, niemals Alarmsignale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors show you at a glance whether your loved ones have shared news recently. They are guideposts, never alarms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores te dicen, de un vistazo, si tus seres queridos han dado noticias hace poco. Son simples referencias, nunca alarmas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couleurs te disent, d'un coup d'œil, si tes proches ont donné des nouvelles récemment. Ce sont des repères, jamais des alarmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colori ti dicono, a colpo d’occhio, se i tuoi cari hanno dato notizie di recente. Sono punti di riferimento, mai allarmi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores dizem-te, num relance, se os teus entes queridos deram notícias recentemente. São referências, nunca alarmes."
          }
        }
      }
    },
    "feed_colors_person_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe einer Person"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person's color"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de una persona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur d'une personne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di una persona"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor de uma pessoa"
          }
        }
      }
    },
    "feed_colors_person_intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist der Ring um das Foto und der Rand der Karte der Person."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the ring around their photo and the edge of their card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el anillo alrededor de su foto y el borde de su tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'anneau autour de sa photo et le liseré de sa carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l’anello attorno alla sua foto e il bordo della sua scheda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É o anel à volta da foto e o rebordo do cartão."
          }
        }
      }
    },
    "feed_colors_person_green_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde"
          }
        }
      }
    },
    "feed_colors_person_green_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gut. Die Person ist an einem vertrauten Ort oder hat ihn vor höchstens %1$@ verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All is well. The person is in a trusted place, or left one within the last %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va bien. La persona está en un lugar de confianza, o salió de uno hace %1$@ como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va bien. La personne est dans un lieu de confiance, ou elle en est partie depuis %1$@ au plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va tutto bene. La persona si trova in un luogo di fiducia, oppure l’ha lasciato da %1$@ al massimo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tudo bem. A pessoa está num local de confiança ou saiu de lá há %1$@, no máximo."
          }
        }
      }
    },
    "feed_colors_person_orange_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Naranja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arancione"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laranja"
          }
        }
      }
    },
    "feed_colors_person_orange_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wenig Stille. Die Person hat einen vertrauten Ort verlassen, und seit mehr als %1$@ gibt es keine Neuigkeiten von ihr (bis zu %2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little quiet. The person left a trusted place and hasn't shared news for more than %1$@ (up to %2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco de silencio. La persona salió de un lugar de confianza y no ha dado noticias desde hace más de %1$@ (hasta %2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu de silence. La personne a quitté un lieu de confiance et n'a pas donné de nouvelles depuis plus de %1$@ (jusqu'à %2$@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po’ di silenzio. La persona ha lasciato un luogo di fiducia e non ha dato notizie da più di %1$@ (fino a %2$@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de silêncio. A pessoa saiu de um local de confiança e não deu notícias há mais de %1$@ (até %2$@)."
          }
        }
      }
    },
    "feed_colors_person_red_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rot"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rojo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouge"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosso"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelho"
          }
        }
      }
    },
    "feed_colors_person_red_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit mehr als %1$@ keine Neuigkeiten, nachdem die Person einen vertrauten Ort verlassen hat. Oft gibt es eine einfache Erklärung (Akku, Netz…). Manchmal genügt eine Nachricht, um beruhigt zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No news for more than %1$@ after leaving a trusted place. There's often a simple explanation (battery, network…). A quick message can put your mind at ease."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin noticias desde hace más de %1$@ tras salir de un lugar de confianza. A menudo hay una explicación sencilla (batería, red…). A veces basta un mensaje para tranquilizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de nouvelles depuis plus de %1$@ après avoir quitté un lieu de confiance. Il y a souvent une explication simple (batterie, réseau…). Un message suffit parfois à être rassuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna notizia da più di %1$@ dopo aver lasciato un luogo di fiducia. Spesso c’è una spiegazione semplice (batteria, rete…). A volte basta un messaggio per tranquillizzarsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem notícias há mais de %1$@ depois de sair de um local de confiança. Muitas vezes há uma explicação simples (bateria, rede…). Por vezes, uma mensagem basta para sossegar."
          }
        }
      }
    },
    "feed_colors_person_gray_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grau"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gray"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grigio"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinzento"
          }
        }
      }
    },
    "feed_colors_person_gray_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts anzuzeigen: Von der Person gibt es noch keine Neuigkeiten, oder sie hat das Teilen beendet. Das heißt nicht, dass etwas nicht stimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to show: the person hasn't shared news yet, or has stopped sharing. It doesn't mean anything is wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay información que mostrar: la persona aún no ha dado noticias, o ha dejado de compartir. Eso no significa que algo vaya mal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'information à afficher : la personne n'a pas encore donné de nouvelles, ou elle a arrêté de partager. Cela ne veut pas dire que quelque chose ne va pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna informazione da mostrare: la persona non ha ancora dato notizie, oppure ha smesso di condividere. Questo non significa che qualcosa non vada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há informação para mostrar: a pessoa ainda não deu notícias ou deixou de partilhar. Isso não significa que algo esteja mal."
          }
        }
      }
    },
    "feed_colors_person_travel_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grau, auf Reisen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gray, traveling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris, de viaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gris, en voyage"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grigio, in viaggio"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinzento, de viagem"
          }
        }
      }
    },
    "feed_colors_person_travel_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person hat den Reisemodus aktiviert: Auf ihrer Karte steht „Auf Reisen bis …“, und sie zählt nicht für die Farbe der Miff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person turned on travel mode: their card says “Traveling until…” and they don't count toward the Miff's color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona ha activado el modo viaje: su tarjeta indica «De viaje hasta…» y no cuenta en el color de la Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne a activé le mode voyage : sa carte indique « En voyage jusqu'au… » et elle ne compte pas dans la couleur de la Miff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona ha attivato la modalità viaggio: la sua scheda indica «In viaggio fino al giorno…» e non conta nel colore della Miff."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa ativou o modo viagem: o cartão indica «De viagem até…» e não conta para a cor da Miff."
          }
        }
      }
    },
    "feed_colors_danger_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefahrenzone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Danger zone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona de peligro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone de danger"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona di pericolo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona de perigo"
          }
        }
      }
    },
    "feed_colors_danger_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Miff eine Gefahrenzone festgelegt hat, steht die Person auf Rot, sobald sie sie betritt. Meldet sie sich nach ihrer Ankunft, steht sie für %1$@ wieder auf Grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your Miff has set a danger zone, the person turns red as soon as they enter it. If they share news after arriving, they turn green for %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu Miff ha definido una zona de peligro, la persona pasa a rojo en cuanto entra en ella. Si da noticias después de llegar, vuelve a verde durante %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ta Miff a défini une zone de danger, la personne passe au rouge dès qu'elle y entre. Si elle donne des nouvelles après son arrivée, elle repasse au vert pendant %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la tua Miff ha definito una zona di pericolo, la persona passa al rosso non appena vi entra. Se dà notizie dopo il suo arrivo, torna al verde per %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a tua Miff definiu uma zona de perigo, a pessoa passa a vermelho assim que entra nela. Se der notícias depois de chegar, volta a verde durante %1$@."
          }
        }
      }
    },
    "feed_colors_changes_title": {
      "extractionState": "manual",
      "localizations": {
