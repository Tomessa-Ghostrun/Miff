    "ios_permission_location_upgrade_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit deine Miff auch bei geschlossener App Bescheid bekommt, braucht Miff die Option „Immer“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To let your Miff know even when the app is closed, Miff needs the \"Always\" option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que tu Miff sepa de ti incluso con la app cerrada, Miff necesita la opción «Siempre»."
          }
        },
        "fr": {
