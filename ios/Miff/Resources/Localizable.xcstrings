    "about_licenses_maps_privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Adresse eingibst, um einen Ort zu erstellen, wird der Text an den Adressdienst gesendet, ohne deinen Namen und ohne deinen Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you type an address to create a place, the text is sent to the address service, without your name or your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando escribes una dirección para crear un lugar, el texto se envía al servicio de direcciones, sin tu nombre ni tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu tapes une adresse pour créer un lieu, le texte part vers le service d'adresses, sans ton nom ni ta position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando digiti un indirizzo per creare un luogo, il testo viene inviato al servizio di indirizzi, senza il tuo nome né la tua posizione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando escreves uma morada para criar um local, o texto é enviado para o serviço de moradas, sem o teu nome nem a tua localização."
          }
        }
      }
    },
