    "feed_colors_miff_orange_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine Person steht auf Orange, und niemand steht auf Rot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one person is orange, and no one is red."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una persona está en naranja y nadie está en rojo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une personne est orange, et personne n'est rouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno una persona è arancione e nessuna è rossa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma pessoa está a laranja e ninguém está a vermelho."
          }
        }
      }
    },
