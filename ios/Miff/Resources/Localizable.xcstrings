    "alert_unavailable_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warnung an deine Liebsten ist gerade nicht verfügbar. Wenn du in Gefahr bist, ruf direkt die Notdienste an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alert to your people isn't available right now. If you're in danger, call the emergency services directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alerta a tus seres queridos no está disponible por ahora. Si estás en peligro, llama directamente a los servicios de emergencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alerte à tes proches n'est pas disponible pour le moment. Si tu es en danger, appelle directement les secours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’allerta ai tuoi cari non è disponibile al momento. Se sei in pericolo, chiama direttamente i soccorsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O alerta aos teus entes queridos não está disponível de momento. Se estiveres em perigo, liga diretamente para os serviços de emergência."
          }
        }
      }
    },
    "miff_alert_removed_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in dieser Miff eine laufende Warnung: Diese wird entfernt, und deine Liebsten erfahren nicht, dass sie beendet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an alert in progress in this Miff: it will be removed, and your people won't be told it ended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una alerta en curso en esta Miff: se retirará, y tus seres queridos no recibirán aviso de que ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as une alerte en cours dans cette Miff : elle sera retirée, et tes proches ne seront pas prévenus de sa fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un’allerta in corso in questa Miff: verrà rimossa e i tuoi cari non saranno avvisati della sua fine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens um alerta em curso nesta Miff: será retirado, e os teus entes queridos não serão avisados do seu fim."
          }
        }
      }
    },
    "paywall_other_account": {
      "extractionState": "manual",
      "comment": "Argument : l'adresse de contact (jamais écrite dans la traduction). Un achat = un compte Miff : refus calme, rien n'est dit sur l'autre compte.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Abonnement wird bereits mit einem anderen Miff-Konto verwendet. Um es zu übertragen, schreib uns: %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This subscription is already used with another Miff account. To move it, write to us: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta suscripción ya se usa con otra cuenta de Miff. Para moverla, escríbenos: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet abonnement est déjà utilisé avec un autre compte Miff. Pour le déplacer, écris-nous : %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo abbonamento è già in uso con un altro account Miff. Per spostarlo, scrivici: %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta subscrição já está a ser usada com outra conta da Miff. Para a mover, escreve-nos: %1$@."
          }
        }
      }
    },
    "settings_subscription_free": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt die kostenlose Version. Miff+ schaltet unbegrenzt viele vertraute Orte und Miffs frei – und die Gefahrenzonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on the free plan. Miff+ unlocks unlimited trusted places and Miffs, and danger zones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en el plan gratuito. Miff+ desbloquea lugares de confianza y Miffs sin límite, además de las zonas de peligro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es sur la formule gratuite. Miff+ débloque des lieux de confiance et des Miffs en nombre illimité, ainsi que les zones de danger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai il piano gratuito. Miff+ sblocca luoghi di fiducia e Miff illimitati, oltre alle zone di pericolo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás no plano gratuito. A Miff+ desbloqueia locais de confiança e Miffs sem limite, e ainda as zonas de perigo."
          }
        }
      }
    },
    "settings_subscription_trial": {
      "extractionState": "manual",
      "comment": "Arguments : 1 = date de fin de l'essai (format long de la langue, formatée par le système), 2 = prix annuel écrit par le store (jamais dans la traduction).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Testphase bis %1$@. Danach %2$@ pro Jahr, es sei denn, du kündigst vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial until %1$@. Then %2$@ per year, unless you cancel before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratuita hasta el %1$@. Después, %2$@ al año, salvo que la canceles antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit jusqu'au %1$@. Ensuite %2$@ par an, sauf si tu l'annules avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gratuita fino al giorno %1$@. Poi %2$@ all’anno, a meno che tu non la annulli prima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste gratuito até %1$@. Depois, %2$@ por ano, a não ser que o canceles antes."
          }
        }
      }
    },
    "settings_subscription_trial_noprice": {
      "extractionState": "manual",
      "comment": "Même phrase sans prix, quand le store n'a pas pu être joint. Argument : date de fin de l'essai.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Testphase bis %1$@. Danach beginnt das Jahresabonnement, es sei denn, du kündigst vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free trial until %1$@. The yearly subscription starts after that, unless you cancel before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratuita hasta el %1$@. Después empieza la suscripción anual, salvo que la canceles antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit jusqu'au %1$@. L'abonnement annuel démarre ensuite, sauf si tu l'annules avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gratuita fino al giorno %1$@. Poi inizia l’abbonamento annuale, a meno che tu non lo annulli prima."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste gratuito até %1$@. Depois começa a subscrição anual, a não ser que a canceles antes."
          }
        }
      }
    },
    "settings_subscription_renews": {
