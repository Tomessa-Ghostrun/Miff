    "update_notice_location_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort ist nicht verfügbar: Der Standort deines Telefons ist ausgeschaltet, oder Miff darf ihn nicht mehr verwenden. Du kannst ihn in den Einstellungen wieder einschalten und es dann noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your position isn't available: your phone's location is off, or Miff is no longer allowed to use it. You can turn it back on in the settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación no está accesible: la ubicación del teléfono está desactivada, o Miff ya no tiene permiso para usarla. Puedes volver a activarla en los ajustes y luego intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n'est pas accessible : la localisation du téléphone est éteinte, ou Miff n'a plus le droit de l'utiliser. Tu peux la rallumer dans les réglages, puis réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione non è accessibile: la posizione del telefono è disattivata, oppure Miff non ha più il permesso di usarla. Puoi riattivarla nelle impostazioni, poi riprovare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua localização não está acessível: a localização do telemóvel está desativada ou a Miff já não tem permissão para a utilizar. Podes voltar a ativá-la nas definições e tentar novamente."
          }
        }
      }
    },
    "ios_update_notice_location_precise": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Genauer Standort“ für diese Funktion. Du kannst das in den Einstellungen tun und es dann noch einmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on precise location for this feature. You can do it in the settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación precisa para esta función. Puedes hacerlo en los ajustes e intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la position précise pour cette fonction. Tu peux le faire dans les réglages, puis réessayer."
          }
        },
        "it": {
          "stringUnit": {
