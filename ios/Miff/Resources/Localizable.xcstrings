{
  "sourceLanguage": "fr",
  "strings": {
    "diag_appcheck_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier"
          }
        }
      }
    },
    "diag_appcheck_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the app can get an App Check token. It is not enforced yet: a missing token blocks nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que l'app peut obtenir un jeton App Check. Il n'est pas encore exigé : un jeton absent ne bloque rien."
          }
        }
      }
    },
    "diag_appcheck_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No token for now. No impact yet, App Check is not enforced. On the simulator, the debug token shown in the Xcode console can be registered in the Firebase console."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de jeton pour le moment. Sans conséquence, App Check n'est pas encore exigé. Sur simulateur, le jeton de débogage affiché dans la console Xcode peut être enregistré dans la console Firebase."
          }
        }
      }
    },
    "diag_appcheck_ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token obtained"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton obtenu"
          }
        }
      }
    },
    "diag_appcheck_running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in progress…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification en cours…"
          }
        }
      }
    },
    "diag_appcheck_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Check"
          }
        }
      }
    },
    "diag_build_android": {
      "extractionState": "manual",
      "comment": "Clé partagée avec Android, où elle affiche « Android X (API Y) ». Sur iOS : « iOS <version> (<modèle>) ». Renommer en diag_build_os sur les deux plateformes dans une PR ultérieure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ (%2$@)"
          }
        },
        "fr": {
