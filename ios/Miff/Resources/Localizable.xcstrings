    "miff_consent3_members_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Vorname, dein Nachname, dein Foto, deine Telefonnummer und dein Akkustand."
          }
        },
        "en": {
