    "alert_waiting_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade kein Netz. Deine Warnung wird so bald wie möglich gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection right now. Your alert will go as soon as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión por ahora. Tu alerta se enviará en cuanto sea posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de réseau pour le moment. Ton alerte partira dès que possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna rete al momento. La tua allerta partirà non appena possibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem rede de momento. O teu alerta será enviado assim que possível."
          }
        }
      }
    },
    "alert_refused_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Warnung wurde nicht gesendet. Prüfe Datum und Uhrzeit deines Telefons und versuch es noch einmal. Wenn du in Gefahr bist, kannst du direkt die Notdienste anrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your alert didn't go. Check your phone's date and time, then try again. If you're in danger, you can call the emergency services directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu alerta no se ha enviado. Comprueba la fecha y la hora de tu teléfono e inténtalo de nuevo. Si estás en peligro, puedes llamar directamente a los servicios de emergencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton alerte n'est pas partie. Vérifie la date et l'heure de ton téléphone, puis réessaie. Si tu es en danger, tu peux appeler directement les secours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua allerta non è partita. Controlla data e ora del telefono, poi riprova. Se sei in pericolo, puoi chiamare direttamente i soccorsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu alerta não foi enviado. Verifica a data e a hora do teu telemóvel e tenta novamente. Se estiveres em perigo, podes ligar diretamente para os serviços de emergência."
          }
        }
      }
    },
    "alert_quota_title": {
