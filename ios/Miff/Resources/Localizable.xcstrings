    "settings_privacy_analytics_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They help us fix the app. They never contain your location. You can change your mind at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils nous aident à réparer l'app. Ils ne contiennent jamais ta position. Tu peux changer d'avis à tout moment."
          }
        }
      }
    },
    "settings_privacy_analytics_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage statistics and crash reports"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques d'usage et rapports de plantage anonymes"
          }
        }
      }
    },
    "settings_privacy_contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact us"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous contacter"
          }
        }
      }
    },
    "settings_privacy_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff uses your phone's location, even when the app is closed, to notice your arrivals and departures at the places of your Miff. Only the members of a Miff who also share theirs see your last known location, with the time. No history of trips is kept. You can stop sharing at any time: your location is then erased."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miff utilise la localisation de ton téléphone, même quand l'app est fermée, pour repérer tes arrivées et tes départs des lieux de ta Miff. Seuls les membres d'une Miff qui partagent aussi la leur voient ta dernière position connue, avec l'heure. Aucun historique de trajets n'est gardé. Tu peux arrêter de partager à tout moment : ta position est alors effacée."
          }
        }
      }
    },
    "settings_privacy_location_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation"
          }
        }
      }
    },
    "settings_privacy_notifications_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are coming soon. Nothing is sent for now."
