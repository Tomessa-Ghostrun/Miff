      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alle deine Orte werden gleichzeitig erfasst: Die Zeitverteilung ist möglicherweise unvollständig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all your places are tracked at the same time: the chart may be incomplete."
