    "settings_privacy_time_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Zeitverteilung zu berechnen, speichert dein Telefon 35 Tage lang die Momente, in denen du an einem deiner Orte ankommst und ihn verlässt, ohne Standort und ohne Adresse. Es wird nichts gesendet: Niemand sonst kann sie sehen. Das Teilen zu beenden löscht sie nicht: Hier kannst du sie löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To work out how your time is spread, your phone keeps for 35 days the moments you arrive at and leave your places, with no position or address. Nothing is sent: nobody else can see them. Stopping sharing does not erase it: you can do it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para calcular el reparto de tu tiempo, tu teléfono guarda durante 35 días los momentos en que llegas a uno de tus lugares y en que sales de él, sin ubicación ni dirección. No se envía nada: nadie más puede verlos. Dejar de compartir no los borra: aquí es donde puedes hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour calculer la répartition de ton temps, ton téléphone garde pendant 35 jours les moments où tu arrives dans un de tes lieux et où tu en pars, sans position ni adresse. Rien n'est envoyé : personne d'autre ne peut les voir. Arrêter de partager ne l'efface pas : c'est ici que tu peux le faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per calcolare la ripartizione del tuo tempo, il tuo telefono conserva per 35 giorni i momenti in cui arrivi in uno dei tuoi luoghi e in cui lo lasci, senza posizione né indirizzo. Non viene inviato nulla: nessun altro può vederli. Smettere di condividere non li cancella: puoi farlo da qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para calcular a distribuição do teu tempo, o teu telemóvel guarda durante 35 dias os momentos em que chegas a um dos teus locais e em que sais dele, sem localização nem morada. Nada é enviado: mais ninguém os pode ver. Deixar de partilhar não os apaga: podes apagá-los aqui."
          }
        }
      }
    },
    "settings_privacy_time_confirm_action": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase"
