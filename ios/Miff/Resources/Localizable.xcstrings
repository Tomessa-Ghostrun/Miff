    "ios_permission_location_settings_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this choice at any time in your iPhone's Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras changer ce choix à tout moment dans les Réglages de ton iPhone."
          }
        }
      }
    },
    "ios_permission_location_denied_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a besoin de ta localisation"
          }
        }
      }
    },
    "ios_permission_location_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is turned off for Miff on your iPhone. Without it, your Miff can't know when you arrive at or leave your places."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est désactivée pour Miff sur ton iPhone. Sans elle, ta Miff ne peut pas savoir quand tu arrives ou pars de tes lieux."
          }
        }
      }
    },
    "ios_permission_location_denied_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your mind at any time in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer d'avis à tout moment dans les Réglages."
          }
        }
      }
    },
    "ios_permission_location_services_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are turned off on your iPhone. For Miff to work, they need to be turned on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services de localisation sont désactivés sur ton iPhone. Pour que Miff fonctionne, ils doivent être activés."
          }
        }
      }
    },
    "ios_permission_location_services_step_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your iPhone's **Settings**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les **Réglages** de l'iPhone"
          }
        }
      }
    },
    "ios_permission_location_services_step_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap **Privacy & Security**, then **Location Services**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche **Confidentialité et sécurité**, puis **Service de localisation**"
          }
        }
      }
    },
    "ios_permission_location_services_step_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on, then choose **Always** for Miff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active-le, puis choisis **Toujours** pour Miff"
          }
        }
      }
    },
    "ios_permission_location_services_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this choice at any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras changer ce choix à tout moment."
          }
        }
      }
    },
    "ios_permission_location_restricted_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is limited on your iPhone by a setting you can't change here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est limitée sur ton iPhone par un réglage que tu ne peux pas modifier ici."
          }
