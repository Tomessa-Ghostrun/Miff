    "feed_colors_miff_gray_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand hat sich gemeldet, deine Liebsten sind alle auf Reisen, niemand sonst ist in der Miff, oder du hast das Teilen beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one has shared news yet, your loved ones are all traveling, there's no one else in the Miff, or you've stopped sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie ha dado noticias aún, tus seres queridos están todos de viaje, no hay nadie más en la Miff, o has dejado de compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n'a encore donné de nouvelles, tes proches sont tous en voyage, il n'y a personne d'autre dans la Miff, ou tu as arrêté de partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha ancora dato notizie, i tuoi cari sono tutti in viaggio, non c’è nessun altro nella Miff, oppure hai smesso di condividere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda ninguém deu notícias, os teus entes queridos estão todos de viagem, não há mais ninguém na Miff ou deixaste de partilhar."
          }
        }
      }
    },
    "feed_colors_miff_ignored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Personen in Grau zählen nicht für die Farbe der Miff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People shown in gray don't count toward the Miff's color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas en gris no cuentan en el color de la Miff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes en gris ne comptent pas dans la couleur de la Miff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone in grigio non contano nel colore della Miff."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas a cinzento não contam para a cor da Miff."
          }
        }
      }
    },
    "feed_colors_not_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Farben nicht aussagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What colors don't tell you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que los colores no dicen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les couleurs ne disent pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa non ti dicono i colori"
          }
        },
        "pt": {
          "stringUnit": {
