          }
        }
      }
    },
    "auth_panel_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du auf „Weiter“ tippst, stimmst du unseren %1$@ und unserer %2$@ sowie der Weitergabe deiner anonymen Nutzungsstatistiken und Absturzberichte zu (jederzeit in den Einstellungen änderbar)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By tapping “Continue”, you accept our %1$@ and our %2$@, as well as the sharing of your anonymous usage statistics and crash reports (you can change this at any time in the Settings)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar «Continuar», aceptas nuestras %1$@ y nuestra %2$@, así como compartir tus estadísticas de uso e informes de fallos anónimos (puedes cambiarlo en cualquier momento en Ajustes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En touchant « Continuer », tu acceptes nos %1$@ et notre %2$@, ainsi que le partage de tes statistiques d'usage et rapports de plantage anonymes (modifiable à tout moment dans les Réglages)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccando «Continua», accetti le nostre %1$@ e la nostra %2$@, oltre alla condivisione delle tue statistiche d’uso e dei report di crash anonimi (modificabile in qualsiasi momento nelle Impostazioni)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tocares em «Continuar», aceitas as nossas %1$@ e a nossa %2$@, bem como a partilha das tuas estatísticas de utilização e relatórios de falhas anónimos (podes alterar isto a qualquer momento nas Definições)."
          }
        }
      }
    },
    "auth_panel_refused_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Problem, dein Konto wurde nicht erstellt. Du kannst es jederzeit erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No worries, your account was not created. You can create it whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada, tu cuenta no se ha creado. Podrás crearla cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de souci, ton compte n'a pas été créé. Tu pourras le créer quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun problema, il tuo account non è stato creato. Potrai crearlo quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem problema, a tua conta não foi criada. Podes criá-la quando quiseres."
          }
        }
      }
    },
    "auth_panel_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen! Noch eine Sache, bevor es weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome! One last thing before you continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te damos la bienvenida! Una última cosa antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue ! Une dernière chose avant de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti diamo il benvenuto! Un’ultima cosa prima di continuare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Damos-te as boas-vindas! Só mais uma coisa antes de continuares."
          }
        }
      }
    },
